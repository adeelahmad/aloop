#!/usr/bin/env python3
"""budget — per-task TIME + TOKEN time-boxing for execution workers.

Every worker attempt (red-worker / scaffolder / green-worker) runs under two budgets,
each with a SOFT and a HARD limit:

    tokens   soft 150k  hard 250k    (context in use + all output tokens, see below)
    time     soft 20m   hard 30m     (wall clock since the attempt's first tool call)

  SOFT time     -> the worker is told, inside its own tool results (PostToolUse
                   additionalContext): how much is left, finish or wrap up gracefully.
  SOFT tokens   -> telemetry only: the worker is NOT told and keeps going. The crossing is
                   recorded (state `token_soft_limit`, event `task.token_soft_limit` in
                   .agentic/logs/events.jsonl) and fed to the next planning cycle (stats).
  HARD crossed  -> the worker is stopped at once (PostToolUse `continue: false`; every
                   PreToolUse call is denied). It is NOT asked to narrate: the harness
                   appends the `status: re-plan` block to output.md itself from facts it
                   owns (limits, worktree diff, transcript path) — no model tokens are
                   spent after the stop (ROADMAP §3.5). A `.agentic/budget-exceeded`
                   marker lets its SubagentStop gate release it, and `budget watch` tells
                   the supervisor to TaskStop it if the hook could not. The task is NOT retried — it goes back to the planner
                   to be split (SKILL.md "Budget overrun -> mid-sprint re-plan").

Resolution order (first set wins):  per-task `budget:` line in tasks.md  >
    BUDGET_* in the worktree's .agentic/task.env  >  docs/agents/defaults.md  >  built-ins.

Usage:
  budget resolve [--tasks FILE --task Tn] [--worktree WT]   the resolved BUDGET_* lines + their source
  budget hook pre|post|stop                 hook mode (reads the hook JSON on stdin)
  budget watch [--interval S] [--grace S]   supervisor: block until a worker must be
                                            killed or none is running; prints KILL lines
  budget mark-killed AGENT_ID...            after TaskStop: stop tracking those attempts
  budget status                             table of tracked attempts
  budget replans TASK_ID                    how many times TASK_ID was split (cap check)

Tokens = the latest assistant turn's context (input + cache read + cache creation)
plus every output token so far, read from the sub-agent's own transcript.

Hook mode NEVER fails the tool call on an internal error (exit 0, no output).
"""
import glob
import json
import os
import re
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _paths  # noqa: E402  (the one file-layout definition)
import _usage  # noqa: E402  (token usage from any host's session log)

BUDGET_KEYS = ("TOKENS_SOFT", "TOKENS_HARD", "TIME_SOFT_MIN", "TIME_HARD_MIN", "MAX_REPLANS")
WORKERS = ("red-worker", "scaffolder", "green-worker")
GRACE_DENIALS = 3          # at the hard limit: denied calls before one is let through to be stopped
TASK_BUDGET = re.compile(r"^\s*budget:\s*(.+)$", re.I)


# ── helpers ───────────────────────────────────────────────────────────
def sh(*args, cwd=None):
    try:
        return subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=10).stdout.strip()
    except Exception:
        return ""


def main_tree(cwd):
    return _paths.project(cwd)


def state_dir(cwd):
    return _paths.home(cwd, "budget")


def read_kv(path):
    kv = {}
    try:
        with open(path) as f:
            for line in f:
                m = re.match(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*['\"]?([^'\"\n]*)['\"]?\s*$", line)
                if m:
                    kv[m.group(1)] = m.group(2)
    except OSError:
        pass
    return kv


def conf_values(cwd):
    """docs/agents/defaults.md (written by agentic-init) — parsed, never executed."""
    st = _paths.settings(cwd)
    return {k: st[k] for k in BUDGET_KEYS}


def task_override(tasks_file, task):
    """`budget: tokens_hard=80000 time_hard=20m` under `## <task> — ...` in tasks.md."""
    vals = {}
    if not (tasks_file and task and os.path.isfile(tasks_file)):
        return vals
    inside = False
    with open(tasks_file) as f:
        for line in f:
            if line.startswith("## "):
                inside = re.match(r"^##\s+" + re.escape(task) + r"\b", line) is not None
                continue
            m = TASK_BUDGET.match(line) if inside else None
            if m:
                for k, v in re.findall(r"(tokens_soft|tokens_hard|time_soft|time_hard)\s*=\s*(\d+)", m.group(1)):
                    key = k.upper() + ("_MIN" if k.startswith("time") else "")
                    vals[key] = int(v)
    return vals


def resolve(cwd, tasks_file=None, task=None, task_env=None, with_source=False):
    b = conf_values(cwd)
    src = "docs/agents/defaults.md" if os.path.isfile(_paths.defaults_file(cwd)) else "built-in defaults"
    for k in BUDGET_KEYS:
        v = (task_env or {}).get("BUDGET_" + k)
        if v and v.isdigit():
            b[k] = int(v)
            src = "task.env BUDGET_*"
    over = task_override(tasks_file, task)
    if over:
        b.update(over)
        src = "tasks.md `budget:` line (%s)" % task
    # a soft limit above its hard limit is a config slip: clamp, never widen
    b["TOKENS_SOFT"] = min(b["TOKENS_SOFT"], b["TOKENS_HARD"])
    b["TIME_SOFT_MIN"] = min(b["TIME_SOFT_MIN"], b["TIME_HARD_MIN"])
    return (b, src) if with_source else b


def transcript_for(payload, agent_id):
    """The sub-agent's own session log — Claude transcript or Codex rollout (_usage)."""
    return _usage.agent_transcript(payload, agent_id)


def tokens_used(path):
    """latest context size + cumulative output tokens (any host; see _usage)."""
    return _usage.context_plus_output(path)


def bound_worktree(cwd, agent_id):
    """Codex/OpenCode workers bind their worktree with `agentic bind` (host-adapter)."""
    st = load_state(os.path.join(_paths.home(cwd, "state/agents"), "%s.json" % safe(agent_id)))
    wt = (st or {}).get("worktree") or ""
    return wt if wt and os.path.isdir(wt) else ""


PATH_ARG = re.compile(r"(?:(?<=\s)-C|(?:^|[;&|(]\s*)cd|--work-tree=?|--git-dir=?)\s*['\"]?([^\s'\";&|)]+)")
ABS_PATH = re.compile(r"(?:^|[\s'\"=:(])(/[^\s'\";&|)]+)")


def _task_worktree_of(path, project):
    """The linked worktree (of THIS repo) that contains `path` and carries .agentic/task.env."""
    d = path if os.path.isdir(path) else os.path.dirname(path)
    for _ in range(40):
        if not d or d == os.path.dirname(d):
            return ""
        if os.path.isfile(os.path.join(d, ".git")) and os.path.isfile(os.path.join(d, ".agentic", "task.env")):
            return d if os.path.realpath(_paths.project(d)) == os.path.realpath(project) else ""
        if os.path.isdir(os.path.join(d, ".git")):
            return ""                                   # reached the main tree
        d = os.path.dirname(d)
    return ""


def path_candidates(payload):
    """Paths a tool call names: `git -C p`, `cd p`, --work-tree, absolute paths, file paths, patch headers."""
    ti = payload.get("tool_input") or {}
    out = []
    for k in ("file_path", "filePath", "path", "notebook_path", "workdir", "cwd"):
        v = ti.get(k)
        if isinstance(v, str) and v:
            out.append(v)
    cmd = ti.get("command") if isinstance(ti.get("command"), str) else ""
    if cmd:
        out += PATH_ARG.findall(cmd)
        out += re.findall(r"^\*\*\* (?:Add|Update|Delete) File: (.+)$", cmd, re.M)
        out += ABS_PATH.findall(cmd)
    cwd = payload.get("cwd") or ""
    return [p if os.path.isabs(p) else os.path.join(cwd, p) for p in out if p]


def claimed_worktrees(cwd, agent_id):
    got = set()
    for p in glob.glob(os.path.join(state_dir(cwd), "*.json")):
        st = load_state(p)
        if st and st.get("agent_id") != agent_id and not st.get("done") and st.get("task_env_found"):
            got.add(st.get("worktree"))
    return got


def find_worktree(payload, cwd, agent_id, role):
    """Which worktree is this worker in? Independent of the tool call's cwd, because workers
    often address their worktree with `git -C <wt>` / absolute paths from the main tree.
      1. a recorded binding (`agentic bind`, or an earlier call of this attempt)
      2. a path the tool call names that lies inside a task worktree
      3. the tool call's cwd
      4. the ONE unclaimed task worktree whose task.env names this role (first calls that
         only read main-tree files, e.g. the style guide)"""
    project = _paths.project(cwd)
    wt = bound_worktree(cwd, agent_id)
    if wt:
        return wt, "bound"
    for cand in path_candidates(payload):
        wt = _task_worktree_of(cand, project)
        if wt:
            return wt, "path in tool call"
    wt = _task_worktree_of(cwd, project)
    if wt:
        return wt, "cwd"
    claimed = claimed_worktrees(cwd, agent_id)
    mine = []
    for te in glob.glob(os.path.join(project, ".agentic", "worktrees", "*", ".agentic", "task.env")) + \
            [os.path.join(w, ".agentic", "task.env") for w in _worktree_list(project)]:
        w = os.path.dirname(os.path.dirname(te))
        if w in claimed or w in [m for m in mine] or not os.path.isfile(te):
            continue
        env = read_kv(te)
        if env.get("AGENT_ROLE") == role:
            mine.append(w)
    return (mine[0], "only %s worktree" % role) if len(mine) == 1 else ("", "")


def _worktree_list(project):
    return [l[len("worktree "):] for l in sh("git", "-C", project, "worktree", "list", "--porcelain").splitlines()
            if l.startswith("worktree ")][1:]


def remember_worktree(cwd, agent_id, wt):
    p = os.path.join(_paths.home(cwd, "state/agents"), "%s.json" % safe(agent_id))
    reg = load_state(p) or {"agent_id": agent_id}
    if reg.get("worktree") != wt:
        reg["worktree"] = wt
        save_state(p, reg)


def safe(s):
    return re.sub(r"[^A-Za-z0-9_.-]", "_", s or "")


def fmt_k(n):
    return "%.1fk" % (n / 1000.0) if n is not None else "?"


def load_state(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def log_event(cwd, name, st, **extra):
    """One line in .agentic/logs/events.jsonl — the harness event stream (never fails)."""
    ev = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "event": name,
          "agent_id": st.get("agent_id"), "task": st.get("task"), "role": st.get("role"),
          "attempt": st.get("attempt"), "story_dir": st.get("story_dir")}
    ev.update(extra)
    try:
        with open(os.path.join(_paths.home(cwd, "logs"), "events.jsonl"), "a") as f:
            f.write(json.dumps(ev) + "\n")
    except OSError:
        pass


def save_state(path, st):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f)
    os.replace(tmp, path)


# ── hook mode ─────────────────────────────────────────────────────────
def emit(event, context=None, deny=None, stop=None):
    out = {"hookSpecificOutput": {"hookEventName": event}}
    if stop:                       # PostToolUse `continue: false` ends the sub-agent (verified)
        out["continue"] = False
        out["stopReason"] = stop
    if context:
        out["hookSpecificOutput"]["additionalContext"] = context
    if deny:
        out["hookSpecificOutput"]["permissionDecision"] = "deny"
        out["hookSpecificOutput"]["permissionDecisionReason"] = deny
    print(json.dumps(out))


def harness_report(st, left, cls):
    """At the hard limit the HARNESS writes the attempt's output.md block (never the model):
    the gate-valid `## <task> · attempt N · <role> · <ts>` shape with status: re-plan."""
    if st.get("harness_report") or not st.get("story_dir") or not os.path.isdir(st["story_dir"]):
        return
    st["harness_report"] = time.time()
    wt = st.get("worktree") or ""
    diff = sh("git", "-C", wt, "diff", "--stat", "HEAD") if wt and os.path.isdir(wt) else ""
    diff = diff.splitlines()[-1].strip() if diff else "no changes"
    ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    block = ("\n## %s · attempt %s · %s · %s\nstatus: re-plan\n\n### Summary\n"
             "Stopped by the time-box hook at the hard %s limit (%s). Written by the harness; "
             "the worker was not asked to report.\n\n### Result\n| Check | Status | Detail |\n|---|---|---|\n"
             "| budget | HARD (%s) | %s |\n| worktree diff | discarded | %s |\n\n### Next\n"
             "re-plan: classify the overrun and split or reframe this task. Transcript: %s\n") % (
        st.get("task") or "?", st.get("attempt") or "?", st["role"], ts, cls, left, cls, left, diff,
        st.get("transcript") or "?")
    out = os.path.join(st["story_dir"], "output.md")
    try:
        new = not os.path.isfile(out)
        with open(out, "a") as f:
            if new:
                f.write("---\ntype: output\n---\n")
            f.write(block)
    except OSError:
        pass


def hook(mode):
    if os.environ.get("SKIP_HOOKS") == "1" or os.environ.get("AGENTIC_NO_BUDGET") == "1":
        return
    raw = sys.stdin.read()
    if not any(w in raw for w in WORKERS):          # cheap exit for every non-worker call
        return
    payload = json.loads(raw)
    agent_id, agent_type = payload.get("agent_id") or "", payload.get("agent_type") or ""
    role = next((w for w in WORKERS if agent_type == w or agent_type.endswith(":" + w)), None)
    if not agent_id or not role:
        return
    cwd = payload.get("cwd") or os.getcwd()
    wt, how = find_worktree(payload, cwd, agent_id, role)
    top = wt or sh("git", "-C", cwd, "rev-parse", "--show-toplevel") or cwd
    spath = os.path.join(state_dir(cwd), "%s.json" % safe(agent_id))
    st = load_state(spath)
    now = time.time()

    if mode == "stop":
        if st:
            st["done"] = now
            save_state(spath, st)
        return

    def resolve_for(top):
        env = read_kv(os.path.join(top, ".agentic", "task.env"))
        task = env.get("TASK_ID", "")
        tasks_file = os.path.join(env["STORY_DIR"], "tasks.md") if env.get("STORY_DIR") else None
        tn = re.sub(r"^.*[-_ ](T\d+)$", r"\1", task.split()[-1]) if task else None
        b, src = resolve(cwd, tasks_file, tn, env, with_source=True)
        return env, task, b, src

    if st is None:
        env, task, b, src = resolve_for(top)
        st = {"agent_id": agent_id, "role": role, "task": task, "attempt": env.get("ATTEMPT", ""),
              "worktree": top, "story_dir": env.get("STORY_DIR", ""), "start": now, "budget": b,
              "budget_source": src, "task_env_found": bool(env), "found_by": how,
              "soft_warned": False, "final_warned": False, "hard": False, "done": None}
    elif wt and not st.get("task_env_found"):
        # the worktree became known after the first call: take ITS task.env/budget, keep the clock
        env, task, b, src = resolve_for(wt)
        old_top = st.get("worktree")
        st.update({"task": task, "attempt": env.get("ATTEMPT", ""), "worktree": wt, "story_dir": env.get("STORY_DIR", ""),
                   "budget": b, "budget_source": src, "task_env_found": bool(env), "found_by": how})
        if st.get("hard") and not st.get("hook_killed"):
            st.update({"hard": False, "denials": 0})       # it was judged against the wrong budget
            try:
                os.remove(os.path.join(old_top, ".agentic", "budget-exceeded"))
            except OSError:
                pass
    if wt:
        remember_worktree(cwd, agent_id, wt)
    if st.get("done") and not st.get("killed") and not st.get("hook_killed"):
        st["done"] = None          # a SubagentStop gate blocked the stop: still working
    b = st["budget"]
    tp = transcript_for(payload, agent_id)
    if tp:
        st["transcript"] = tp
    toks = tokens_used(st.get("transcript") or tp)
    if toks is not None:
        st["tokens"] = toks
    toks = st.get("tokens")
    mins = (now - st["start"]) / 60.0
    st["elapsed_min"] = round(mins, 2)

    t_hard = b["TOKENS_HARD"]
    m_hard = b["TIME_HARD_MIN"]
    over_hard = (toks is not None and toks >= t_hard) or mins >= m_hard
    over_soft_time = mins >= b["TIME_SOFT_MIN"]
    over_soft_tokens = toks is not None and toks >= b["TOKENS_SOFT"]
    near_hard = (toks is not None and toks >= 0.9 * t_hard) or mins >= 0.9 * m_hard
    left = "%s of %s tokens used (%s left), %.1f of %d min used (%.1f min left); budget from %s" % (
        fmt_k(toks), fmt_k(t_hard), fmt_k(max(t_hard - toks, 0)) if toks is not None else "?",
        mins, m_hard, max(m_hard - mins, 0), st.get("budget_source") or "?")
    report = os.path.join(st["story_dir"], "output.md") if st.get("story_dir") else "the story's output.md"

    if over_hard and not st["hard"]:
        st["hard"] = now
        try:
            os.makedirs(os.path.join(top, ".agentic"), exist_ok=True)
            with open(os.path.join(top, ".agentic", "budget-exceeded"), "w") as f:
                f.write("role=%s attempt=%s agent_id=%s at=%d %s\n" % (role, st["attempt"], agent_id, now, left))
        except OSError:
            pass
    if over_soft_tokens and not st.get("token_soft_limit"):
        # telemetry only (ROADMAP §3.1): record it for the planner, never tell the worker
        st["token_soft_limit"] = now
        log_event(cwd, "task.token_soft_limit", st, tokens=toks, tokens_soft=b["TOKENS_SOFT"],
                  elapsed_min=round(mins, 2))

    def record_hard():
        if st.get("hard_logged"):
            return
        st["hard_logged"] = now
        cls = "token" if toks is not None and toks >= t_hard else "time"
        log_event(cwd, "task.token_hard_limit" if cls == "token" else "task.time_hard_timeout", st,
                  tokens=toks, elapsed_min=round(mins, 2))
        harness_report(st, left, cls)

    if st["hard"] and st.get("task_env_found"):
        record_hard()
    save_state(spath, st)

    if st["hard"]:
        msg = ("HARD BUDGET EXCEEDED (%s). You are stopped now. Do nothing else: no report, no "
               "tests, no edits. The harness has recorded this attempt in %s (status: re-plan) and "
               "the task goes back to the planner." % (left, report))
        stop = ("agentic-agile: HARD BUDGET — %s %s stopped by the time-box hook (%s). "
                "Not a pass; the supervisor re-plans this task." % (role, st.get("task") or "", left))
        if mode == "pre":
            st["denials"] = st.get("denials", 0) + 1
            save_state(spath, st)
            if st["denials"] <= GRACE_DENIALS:
                emit("PreToolUse", deny=msg + " (%d/%d refusals before a forced stop)" % (st["denials"], GRACE_DENIALS))
            # past the grace: let this call through — its PostToolUse ends the agent
            return
        if mode == "post":
            if not st.get("task_env_found") and st["hard"] == now:
                # judged before this worker's worktree (and its budget) is known: one more
                # call may find it and withdraw the verdict (see the re-resolve above)
                emit("PostToolUse", context=msg)
                return
            record_hard()                                # no grace call, no narration
            st["hook_killed"] = now
            st["done"] = now
            save_state(spath, st)
            emit("PostToolUse", context=msg, stop=stop)  # deterministic stop, no model decision
        return

    if mode != "post":
        return
    if near_hard and not st["final_warned"]:
        st["final_warned"] = True
        save_state(spath, st)
        emit("PostToolUse", context=(
            "FINAL BUDGET WARNING: %s. At the hard limit you will be KILLED and this attempt "
            "discarded. Wrap up NOW: finish the smallest complete step, run selfcheck once, "
            "append your output.md report. If the task cannot fit, say so in ### Next "
            "(status: re-plan) so the planner can split it." % left))
    elif over_soft_time and not st["soft_warned"]:
        st["soft_warned"] = True
        save_state(spath, st)
        emit("PostToolUse", context=(
            "SOFT TIME LIMIT reached: %s. Complete this task within what is left or end it "
            "gracefully — no exploration, no refactors, no re-reading files you already read. "
            "If it will not fit, append your output.md report now with status: re-plan "
            "and what remains, rather than being killed at the hard limit." % left))


# ── supervisor commands ───────────────────────────────────────────────
def all_states(cwd):
    d = state_dir(cwd)
    out = []
    for p in sorted(glob.glob(os.path.join(d, "*.json"))):
        st = load_state(p)
        if st:
            out.append((p, st))
    return out


def refresh(st):
    """Re-measure an attempt from outside the hook (the watcher polls between tool calls).
    True when the attempt is at/over a HARD limit."""
    now = time.time()
    st["elapsed_min"] = round((now - st["start"]) / 60.0, 2)
    t = tokens_used(st.get("transcript"))
    if t is not None:
        st["tokens"] = t
    b = st["budget"]
    return bool(st.get("hard")) or st["elapsed_min"] >= b["TIME_HARD_MIN"] or (st.get("tokens") or 0) >= b["TOKENS_HARD"]


def watch(cwd, interval, grace):
    """The supervisor's sleep. Returns when a worker was STOPPED by the time-box hook, a
    worker is past its HARD limit + grace and still running (the hook's backstop: TaskStop
    it), or no worker is running. Run with run_in_background: its exit is the wake-up."""
    while True:
        now = time.time()
        stopped, kill = [], []
        states = all_states(cwd)
        running = [(p, s) for p, s in states if not s.get("done")]
        for p, s in states:
            if s.get("hook_killed") and not s.get("reported"):
                s["reported"] = now
                save_state(p, s)
                stopped.append(s)
        for p, s in running:
            if refresh(s):
                if not s.get("hard"):
                    s["hard"] = now
                save_state(p, s)
                if now - s["hard"] >= grace:
                    kill.append(s)
        line = "%s agent_id=%s task=%s role=%s attempt=%s tokens=%s/%s elapsed=%.1f/%dmin"
        for tag, group in (("STOPPED", stopped), ("KILL", kill)):
            for s in group:
                print(line % (tag, s["agent_id"], s.get("task") or "?", s["role"], s.get("attempt") or "?",
                              fmt_k(s.get("tokens")), fmt_k(s["budget"]["TOKENS_HARD"]), s.get("elapsed_min") or 0,
                              s["budget"]["TIME_HARD_MIN"]))
        if stopped or kill:
            if kill:
                print("-> KILL lines: the hook could not stop these — TaskStop each, then `budget mark-killed <agent_id>`.")
            print("-> Budget overrun: discard these attempts (never merge), PAUSE the sprint and dispatch the "
                  "planner in replan mode (SKILL.md 'Budget overrun'). Do NOT retry these tasks as-is.")
            return 3
        if not running:
            print("IDLE: no worker running.")
            return 0
        time.sleep(interval)


def mark_killed(cwd, agent_ids):
    n = 0
    for p, s in all_states(cwd):
        if s["agent_id"] in agent_ids or "ALL" in agent_ids and not s.get("done"):
            s["done"] = time.time()
            s["killed"] = True
            save_state(p, s)
            n += 1
    print("marked killed: %d" % n)
    return 0


def status(cwd):
    rows = all_states(cwd)
    if not rows:
        print("no tracked worker attempts")
        return 0
    print("%-22s %-13s %-14s %-4s %-16s %-14s %-7s %s" % ("agent_id", "role", "task", "att", "tokens", "minutes", "state", "budget from (worktree found by)"))
    for _, s in rows:
        refresh(s)
        b = s["budget"]
        state = "killed" if s.get("killed") else "done" if s.get("done") else ("HARD" if s.get("hard") else ("soft" if s.get("soft_warned") else ("soft-tok" if s.get("token_soft_limit") else "ok")))
        print("%-22s %-13s %-14s %-4s %-16s %-14s %-7s %s" % (
            s["agent_id"][:22], s["role"], (s.get("task") or "?")[:14], s.get("attempt") or "?",
            "%s/%s" % (fmt_k(s.get("tokens")), fmt_k(b["TOKENS_HARD"])),
            "%.1f/%d" % (s["elapsed_min"], b["TIME_HARD_MIN"]), state,
            "%s (%s)" % (s.get("budget_source") or "?", s.get("found_by") or "not found")))
    return 0


def split_parent(root, story, tn):
    """`split_from: T3` under `## T5 — ...` in the story's tasks.md -> "T3"."""
    for tf in glob.glob(os.path.join(root, "docs", "agents", "sprint*", story.lower() + "-*", "tasks.md")):
        inside = False
        with open(tf) as f:
            for line in f:
                if line.startswith("## "):
                    inside = re.match(r"^##\s+" + re.escape(tn) + r"\b", line) is not None
                    continue
                m = re.match(r"^\s*split_from:\s*(T\d+)", line) if inside else None
                if m:
                    return m.group(1)
    return None


def replans(cwd, task):
    """How many times TASK_ID's lineage was split: `wave-K replan SN-NN start Tn` lines in
    execution.log for the task AND every ancestor it was split from (`split_from:`)."""
    m = re.match(r"^(S\d+-\d+)(?:[-_ ]+(T\d+))?", task or "")
    if not m:
        print("budget replans: TASK_ID must look like S1-02-T3", file=sys.stderr)
        return 64
    root = main_tree(cwd)
    story, tn = m.group(1), m.group(2)
    lineage, cur = [], tn
    while cur and cur not in lineage and len(lineage) < 20:
        lineage.append(cur)
        cur = split_parent(root, story, cur)
    n = 0
    for log in glob.glob(os.path.join(root, "docs", "agents", "sprint*", "execution.log")):
        with open(log) as f:
            for line in f:
                w = line.split()
                if " replan " in line and story in w and "start" in w and (not tn or any(t in w for t in lineage)):
                    n += 1
    cap = resolve(cwd)["MAX_REPLANS"]
    print("replans=%d cap=%d lineage=%s%s" % (n, cap, "<-".join(lineage) or story,
          "  -> CAP REACHED: escalate (hard stop), do not split again" if n >= cap else ""))
    return 3 if n >= cap else 0


def main(argv):
    cwd = os.getcwd()
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd = argv[0]
    opts = {}
    it = iter(argv[1:])
    for a in it:
        if a.startswith("--"):
            opts[a[2:]] = next(it, "")
        else:
            opts.setdefault("_", []).append(a)
    if cmd == "hook":
        try:
            hook((opts.get("_") or ["post"])[0])
        except Exception:
            pass                                   # never break a tool call
        return 0
    if cmd == "resolve":
        wt = opts.get("worktree") or sh("git", "rev-parse", "--show-toplevel") or cwd
        env = read_kv(os.path.join(wt, ".agentic", "task.env"))
        b, src = resolve(cwd, opts.get("tasks"), opts.get("task"), env, with_source=True)
        for k in ("TOKENS_SOFT", "TOKENS_HARD", "TIME_SOFT_MIN", "TIME_HARD_MIN"):
            print("BUDGET_%s=%d" % (k, b[k]))
        print("# from: %s" % src)
        return 0
    if cmd == "watch":
        return watch(cwd, int(opts.get("interval") or 20), int(opts.get("grace") or 60))
    if cmd == "status":
        return status(cwd)
    if cmd == "mark-killed":
        return mark_killed(cwd, opts.get("_") or [])
    if cmd == "replans":
        return replans(cwd, (opts.get("_") or [""])[0])
    print("budget: unknown command %r (see budget --help)" % cmd, file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
