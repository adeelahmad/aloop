#!/usr/bin/env python3
"""budget — per-task TIME + TOKEN time-boxing for execution workers.

Every worker attempt (red-worker / scaffolder / green-worker) runs under two budgets,
each with a SOFT and a HARD limit:

    tokens   soft 150k  hard 250k    (fresh input + output tokens, see below)
    time     soft 20m   hard 30m     (wall clock since the attempt's first tool call)

  SOFT time     -> the worker is told, inside its own tool results (PostToolUse
                   additionalContext): how much is left, finish or wrap up gracefully.
  SOFT tokens   -> telemetry only: the worker is NOT told and keeps going. The crossing is
                   recorded (state `token_soft_limit`, event `task.token_soft_limit` in
                   .agentic/logs/events.jsonl) and fed to the next planning cycle (stats).
  HARD crossed  -> the worker is stopped at once (PostToolUse `continue: false`; every
                   PreToolUse call is denied). It is NOT asked to narrate: the harness
                   appends the `status: re-plan` block to output.md itself from facts it
                   owns (limits, worktree diff, transcript path) — no model tokens are
                   spent after the stop (ROADMAP §3.5). A `<worktree>/.aladdin/budget-exceeded`
                   marker lets its SubagentStop gate release it, and `budget watch` tells
                   the supervisor to TaskStop it if the hook could not. The task is NOT retried — it goes back to the planner
                   to be split (skills/aloop/reference.md "Budget overrun -> mid-sprint re-plan").

Resolution order (first set wins):  per-task `budget:` line in tasks.md  >
    BUDGET_* in the worktree's task.env copy  >  docs/agents/defaults.md  >  built-ins.

Usage:
  budget resolve [--tasks FILE --task Tn] [--worktree WT]   the resolved BUDGET_* lines + their source
  budget hook pre|post|stop                 hook mode (reads the hook JSON on stdin)
  budget watch [--interval S] [--grace S]   supervisor: block until a worker must be
                                            killed, one was released STUCK, or none is running;
                                            prints STOPPED / KILL / STUCK lines
  budget mark-killed AGENT_ID...            after TaskStop: stop tracking those attempts
  budget status                             table of tracked attempts
  budget replans TASK_ID                    how many times TASK_ID was split (cap check)
  budget classify AGENT_ID|TASK_ID...       the breach class of a stopped attempt + its evidence
  budget admit TASK_ID                      before dispatch: 0 admit, 3 admission closed (sprint
                                            token envelope hard limit; task carried over)
  budget rollover-check SPRINT_DIR          gate-final: unticked boxes only for carried tasks
  budget envelope TASK_ID                   the minimal failure envelope for the planner

Tokens = the charge under TOKEN_METER (defaults.md, or BUDGET_TOKEN_METER in task.env):
  fresh   (default) every uncached input token + every output token so far
  context the latest call's context in use + every output token (the pre-0.11 meter)
read from the sub-agent's own transcript. Cache read / cache write are kept as their own
classes in the attempt state (cost and churn), never folded into context size.

Hook mode NEVER fails the tool call on an internal error (exit 0, no output).
"""
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _paths  # noqa: E402  (the one file-layout definition)
import _usage  # noqa: E402  (token usage from any host's session log)
import _events  # noqa: E402  (the aladdin.event/1 stream)
import _timebox  # noqa: E402  (AGENTIC_TIME_MODE=auto)

BUDGET_KEYS = ("TOKENS_SOFT", "TOKENS_HARD", "TIME_SOFT_MIN", "TIME_HARD_MIN", "MAX_REPLANS")
WORKERS = ("red-worker", "scaffolder", "green-worker")
# Every other model role is METERED too (ROADMAP §3.3), against its own limit profile.
# Observe-only: crossings are recorded as events, the agent is never told or stopped
# (a planner runs with the human present; its overruns feed the next planning cycle).
# Override per project in defaults.md:  AGENTIC_BUDGET_PLANNER="tokens_hard=800000 time_hard=90"
ROLE_PROFILES = {
    "intake": (300000, 600000, 30, 60), "standards": (300000, 600000, 30, 60),
    "planner": (300000, 600000, 30, 60), "archivist": (300000, 600000, 30, 60),
    "structural-reviewer": (150000, 250000, 20, 30), "final-gate": (150000, 250000, 20, 30),
}
GRACE_DENIALS = 3          # at the hard limit: denied calls before one is let through to be stopped
TASK_BUDGET = re.compile(r"^\s*budget:\s*(.+)$", re.I)


# ── helpers ───────────────────────────────────────────────────────────
def sh(*args, cwd=None):
    try:
        return subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=10).stdout.strip()
    except Exception:
        return ""


def main_tree(cwd):
    return _paths.project(cwd)


def state_dir(cwd):
    return _paths.home(cwd, "budget")


def read_kv(path):
    kv = {}
    try:
        with open(path) as f:
            for line in f:
                m = re.match(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*['\"]?([^'\"\n]*)['\"]?\s*$", line)
                if m:
                    kv[m.group(1)] = m.group(2)
    except OSError:
        pass
    return kv


def conf_values(cwd):
    """docs/agents/defaults.md (written by aloop-init) — parsed, never executed."""
    st = _paths.settings(cwd)
    return {k: st[k] for k in BUDGET_KEYS}


def task_override(tasks_file, task):
    """`budget: tokens_hard=80000 time_hard=20m` under `## <task> — ...` in tasks.md."""
    vals = {}
    if not (tasks_file and task and os.path.isfile(tasks_file)):
        return vals
    inside = False
    with open(tasks_file) as f:
        for line in f:
            if line.startswith("## "):
                inside = re.match(r"^##\s+" + re.escape(task) + r"\b", line) is not None
                continue
            m = TASK_BUDGET.match(line) if inside else None
            if m:
                for k, v in re.findall(r"(tokens_soft|tokens_hard|time_soft|time_hard)\s*=\s*(\d+)", m.group(1)):
                    key = k.upper() + ("_MIN" if k.startswith("time") else "")
                    vals[key] = int(v)
    return vals


def resolve(cwd, tasks_file=None, task=None, task_env=None, with_source=False):
    b = conf_values(cwd)
    meter = (task_env or {}).get("BUDGET_TOKEN_METER") or _paths.settings(cwd).get("TOKEN_METER") or "fresh"
    b["TOKEN_METER"] = meter if meter in ("fresh", "context") else "fresh"
    src = "docs/agents/defaults.md" if os.path.isfile(_paths.defaults_file(cwd)) else "built-in defaults"
    tb = _timebox.current(cwd)
    if tb:  # one stable project task duration, recorded by the supervisor (ROADMAP §4.2)
        b.update(_timebox.limits(tb))
        src = "timebox (AGENTIC_TIME_MODE=auto, %d min)" % tb["minutes"]
    for k in BUDGET_KEYS:
        v = (task_env or {}).get("BUDGET_" + k)
        if v and v.isdigit():
            b[k] = int(v)
            src = "task.env BUDGET_*"
    over = task_override(tasks_file, task)
    if over:
        b.update(over)
        src = "tasks.md `budget:` line (%s)" % task
    # a soft limit above its hard limit is a config slip: clamp, never widen
    b["TOKENS_SOFT"] = min(b["TOKENS_SOFT"], b["TOKENS_HARD"])
    b["TIME_SOFT_MIN"] = min(b["TIME_SOFT_MIN"], b["TIME_HARD_MIN"])
    return (b, src) if with_source else b


TASK_LINE = re.compile(r"TASK_ID:\s*([A-Za-z0-9._-]+)")


def host_task_id(payload, agent_id):
    """The TASK_ID the host's dispatch prompt names: first user turn of the sub-agent transcript."""
    tp = transcript_for(payload, agent_id)
    try:
        with open(tp) as f:
            for line in f:
                # Claude Code may prepend a session-context attachment (renderedRole "user", no
                # TASK_ID) before the dispatch prompt: keep reading to the first line naming one.
                if '"user"' in line:
                    m = TASK_LINE.search(line)
                    if m:
                        return m.group(1)
    except (OSError, TypeError):
        pass
    return ""


def contract(cwd, task_id):
    """The supervisor's task contract in the MAIN tree (<run-data>/state/tasks/<TASK_ID>.env), or {}."""
    if not task_id or not re.match(r"^[A-Za-z0-9._-]+$", task_id):
        return {}
    return read_kv(_paths.contract_path(cwd, task_id))


def copy_contract(cwd, top, task_id, main_tree=False):
    """Put a copy of the supervisor's contract in the worker's worktree (Claude Code makes the
    worktree at dispatch, so no one could write it before), so `selfcheck` there finds the
    task. The gates compare the copy with the contract, so editing it gains nothing.
    main_tree=True allows the project root itself: an observed role (reviewer, final gate)
    dispatched without a worktree runs there (live run 19), and its stop removes the copy."""
    src = _paths.contract_path(cwd, task_id)
    git = os.path.join(top, ".git")
    if not (os.path.isfile(git) or (main_tree and os.path.isdir(git))) or not os.path.isfile(src):
        return
    dst = _paths.marker(top, "task.env")
    if os.path.exists(dst) and os.path.getmtime(dst) >= os.path.getmtime(src):
        return                                  # current (a re-dispatch rewrites the contract: refresh)
    try:
        _paths.marker_dir(top)
        shutil.copyfile(src, dst)
    except OSError:
        pass


def seed_output(cwd, task_id):
    """Create the story's output.md with its frontmatter before the worker's first tool call, so a
    bare `cat >>` of the report block never produces a file without `type: output` (live run 18:
    four self-check blocks). An existing output.md is never touched (append-only comms)."""
    env = contract(cwd, task_id)
    sd = env.get("STORY_DIR") or ""
    out = os.path.join(sd, "output.md")
    if not sd or not os.path.isdir(sd) or os.path.exists(out):
        return
    story = ""
    try:
        with open(os.path.join(sd, "init.md")) as f:
            for line in f.read().split("\n---", 2)[1].splitlines():
                if line.startswith("story:"):
                    story = line.split(":", 1)[1].strip()
    except (OSError, IndexError):
        pass
    story = story or re.sub(r"-[A-Z]+\d*$", "", task_id)
    try:
        with open(out, "x") as f:
            f.write("---\ntype: output\nstory: %s\n---\n" % story)
    except OSError:
        pass


def transcript_for(payload, agent_id):
    """The sub-agent's own session log — Claude transcript or Codex rollout (_usage)."""
    return _usage.agent_transcript(payload, agent_id)


def tokens_used(path, meter="fresh"):
    """(charge, classes) for one agent log, any host (see _usage.classes / charge)."""
    c = _usage.classes(path)
    return _usage.charge(c, meter), c


def bound_worktree(cwd, agent_id):
    """Codex/OpenCode workers bind their worktree with `aloop bind` (host-adapter)."""
    st = load_state(os.path.join(_paths.home(cwd, "state/agents"), "%s.json" % safe(agent_id)))
    wt = (st or {}).get("worktree") or ""
    return wt if wt and os.path.isdir(wt) else ""


PATH_ARG = re.compile(r"(?:(?<=\s)-C|(?:^|[;&|(]\s*)cd|--work-tree=?|--git-dir=?)\s*['\"]?([^\s'\";&|)]+)")
ABS_PATH = re.compile(r"(?:^|[\s'\"=:(])(/[^\s'\";&|)]+)")


def _task_worktree_of(path, project):
    """The linked worktree (of THIS repo) that contains `path` and carries a task.env marker."""
    d = path if os.path.isdir(path) else os.path.dirname(path)
    for _ in range(40):
        if not d or d == os.path.dirname(d):
            return ""
        if os.path.isfile(os.path.join(d, ".git")) and os.path.isfile(_paths.marker(d, "task.env")):
            return d if os.path.realpath(_paths.project(d)) == os.path.realpath(project) else ""
        if os.path.isdir(os.path.join(d, ".git")):
            return ""                                   # reached the main tree
        d = os.path.dirname(d)
    return ""


def path_candidates(payload):
    """Paths a tool call names: `git -C p`, `cd p`, --work-tree, absolute paths, file paths, patch headers."""
    ti = payload.get("tool_input") or {}
    out = []
    for k in ("file_path", "filePath", "path", "notebook_path", "workdir", "cwd"):
        v = ti.get(k)
        if isinstance(v, str) and v:
            out.append(v)
    cmd = ti.get("command") if isinstance(ti.get("command"), str) else ""
    if cmd:
        out += PATH_ARG.findall(cmd)
        out += re.findall(r"^\*\*\* (?:Add|Update|Delete) File: (.+)$", cmd, re.M)
        out += ABS_PATH.findall(cmd)
    cwd = payload.get("cwd") or ""
    return [p if os.path.isabs(p) else os.path.join(cwd, p) for p in out if p]


def claimed_worktrees(cwd, agent_id):
    got = set()
    for p in glob.glob(os.path.join(state_dir(cwd), "*.json")):
        st = load_state(p)
        if st and st.get("agent_id") != agent_id and not st.get("done") and st.get("task_env_found"):
            got.add(st.get("worktree"))
    return got


def find_worktree(payload, cwd, agent_id, role):
    """Which worktree is this worker in? Independent of the tool call's cwd, because workers
    often address their worktree with `git -C <wt>` / absolute paths from the main tree.
      1. a recorded binding (`aloop bind`, or an earlier call of this attempt)
      2. a path the tool call names that lies inside a task worktree
      3. the tool call's cwd
      4. the ONE unclaimed task worktree whose task.env names this role (first calls that
         only read main-tree files, e.g. the style guide)"""
    project = _paths.project(cwd)
    wt = bound_worktree(cwd, agent_id)
    if wt:
        return wt, "bound"
    for cand in path_candidates(payload):
        wt = _task_worktree_of(cand, project)
        if wt:
            return wt, "path in tool call"
    wt = _task_worktree_of(cwd, project)
    if wt:
        return wt, "cwd"
    top = sh("git", "-C", cwd, "rev-parse", "--show-toplevel")
    if top and os.path.isfile(os.path.join(top, ".git")) and \
            os.path.realpath(_paths.project(top)) == os.path.realpath(project):
        return top, "cwd (host worktree)"      # Claude Code's isolation worktree has no task.env
    claimed = claimed_worktrees(cwd, agent_id)
    mine = []
    for te in [_paths.marker(w, "task.env") for w in glob.glob(os.path.join(_paths.home(project, "worktrees", make=False), "*"))] + \
            [_paths.marker(w, "task.env") for w in _worktree_list(project)]:
        w = os.path.dirname(os.path.dirname(te))
        if w in claimed or w in [m for m in mine] or not os.path.isfile(te):
            continue
        env = read_kv(te)
        if env.get("AGENT_ROLE") == role:
            mine.append(w)
    return (mine[0], "only %s worktree" % role) if len(mine) == 1 else ("", "")


def _worktree_list(project):
    return [l[len("worktree "):] for l in sh("git", "-C", project, "worktree", "list", "--porcelain").splitlines()
            if l.startswith("worktree ")][1:]


def remember_worktree(cwd, agent_id, wt):
    p = os.path.join(_paths.home(cwd, "state/agents"), "%s.json" % safe(agent_id))
    reg = load_state(p) or {"agent_id": agent_id}
    if reg.get("worktree") != wt:
        reg["worktree"] = wt
        save_state(p, reg)


def safe(s):
    return re.sub(r"[^A-Za-z0-9_.-]", "_", s or "")


def fmt_k(n):
    return "%.1fk" % (n / 1000.0) if n is not None else "?"


def load_state(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def log_event(cwd, name, st, **extra):
    """One aladdin.event/1 record (see _events) for this attempt; never fails."""
    try:
        sd = st.get("story_dir") or ""
        _events.emit(cwd, name, task=st.get("task") or "", attempt=st.get("attempt") or "",
                     agent_id=st.get("agent_id") or "", role=st.get("role") or "",
                     model=((st.get("usage") or {}).get("model") or ""),
                     refs={"transcript": st.get("transcript"), "story_dir": sd,
                           "output": os.path.join(sd, "output.md") if sd and os.path.isfile(os.path.join(sd, "output.md")) else ""},
                     **extra)
    except Exception:
        pass


def save_state(path, st):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f)
    os.replace(tmp, path)


# ── hook mode ─────────────────────────────────────────────────────────
def emit(event, context=None, deny=None, stop=None):
    out = {"hookSpecificOutput": {"hookEventName": event}}
    if stop:                       # PostToolUse `continue: false` ends the sub-agent (verified)
        out["continue"] = False
        out["stopReason"] = stop
    if context:
        out["hookSpecificOutput"]["additionalContext"] = context
    if deny:
        out["hookSpecificOutput"]["permissionDecision"] = "deny"
        out["hookSpecificOutput"]["permissionDecisionReason"] = deny
    print(json.dumps(out))


BREACH_CLASSES = ("TASK_TOO_LARGE", "AGENT_LOOPING", "PLAN_AMBIGUOUS", "BLOCKED_DEPENDENCY",
                  "ENVIRONMENT_SLOW", "TEST_SUITE_SLOW", "EXTERNAL_SERVICE", "HOST_FAILURE",
                  "CONTEXT_PATHOLOGY", "UNKNOWN")
TEST_CMD = re.compile(r"\b(cargo (?:test|nextest)|go test|pytest|py\.test|npm (?:run )?test|yarn test|pnpm test|"
                      r"jest|vitest|mvn test|gradle test|make test|ctest|rspec|phpunit|dotnet test)\b")
NET_ERR = re.compile(r"ECONNREFUSED|ETIMEDOUT|ENOTFOUND|Connection refused|Could not resolve host|"
                     r"Temporary failure in name resolution|\b(?:502|503|504) (?:Bad Gateway|Service Unavailable|Gateway Timeout)|"
                     r"rate limit", re.I)


def tool_calls(path):
    """[(name, input-json, result-text)] from a Claude-shaped transcript (best effort)."""
    calls, results = [], {}
    if not path or not os.path.isfile(path) or path.endswith(".zst"):
        return calls
    try:
        with open(path, errors="replace") as f:
            for line in f:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                content = (rec.get("message") or {}).get("content") if isinstance(rec.get("message"), dict) else None
                for c in content if isinstance(content, list) else []:
                    if not isinstance(c, dict):
                        continue
                    if c.get("type") == "tool_use":
                        calls.append([c.get("id"), c.get("name") or "", json.dumps(c.get("input") or {}, sort_keys=True), ""])
                    elif c.get("type") == "tool_result":
                        body = c.get("content")
                        results[c.get("tool_use_id")] = body if isinstance(body, str) else json.dumps(body)
    except OSError:
        return []
    return [(n, i, results.get(cid, "")) for cid, n, i, _ in calls]


def classify(st):
    """Deterministic FIRST classification of a hard breach (ROADMAP §3.4), from facts the
    harness owns. The planner confirms or overrides it; PLAN_AMBIGUOUS and
    BLOCKED_DEPENDENCY need its judgment and are never guessed here."""
    b, u = st.get("budget") or {}, st.get("usage") or {}
    toks, mins = st.get("tokens"), st.get("elapsed_min") or 0
    hard_t = b.get("TOKENS_HARD") or 1
    token_breach = toks is not None and toks >= hard_t
    calls = tool_calls(st.get("transcript"))
    if not u and not calls:
        return "HOST_FAILURE", "no model usage or tool calls recorded for this attempt (%.1f min)" % mins
    if calls:
        counts = {}
        for n, i, _ in calls:
            counts[(n, i)] = counts.get((n, i), 0) + 1
        (name, inp), top = max(counts.items(), key=lambda kv: kv[1])
        if top >= 4 and top * 3 >= len(calls):
            return "AGENT_LOOPING", "the same %s call repeated %d of %d times: %s" % (name, top, len(calls), inp[:120])
        net = sum(1 for _, _, r in calls if NET_ERR.search(r or ""))
        if net >= 2:
            return "EXTERNAL_SERVICE", "%d tool results show network/service errors" % net
    if (u.get("context") or 0) >= 0.8 * max(hard_t, 200000):
        return "CONTEXT_PATHOLOGY", "context in use reached %s (cache read %s)" % (fmt_k(u.get("context")), fmt_k(u.get("cache_read")))
    if not token_breach and (toks or 0) < 0.4 * hard_t:
        tests = sum(1 for n, i, _ in calls if n.lower() == "bash" and TEST_CMD.search(i))
        if calls and tests * 2 >= sum(1 for n, _, _ in calls if n.lower() == "bash") and tests:
            return "TEST_SUITE_SLOW", "time limit hit at %s tokens; %d of the shell calls were test runs" % (fmt_k(toks), tests)
        return "ENVIRONMENT_SLOW", "time limit hit at only %s of %s tokens: wall clock went to tools, not the model" % (fmt_k(toks), fmt_k(hard_t))
    if token_breach or calls:
        return "TASK_TOO_LARGE", "%s tokens, %.1f min, %d tool calls, no loop or slow-tool signal" % (fmt_k(toks), mins, len(calls))
    return "UNKNOWN", "no signal matched"


def harness_report(st, left, cls):
    """At the hard limit the HARNESS writes the attempt's output.md block (never the model):
    the gate-valid `## <task> · attempt N · <role> · <ts>` shape with status: re-plan."""
    if st.get("harness_report") or not st.get("story_dir") or not os.path.isdir(st["story_dir"]):
        return
    st["harness_report"] = time.time()
    wt = st.get("worktree") or ""
    diff = sh("git", "-C", wt, "diff", "--stat", "HEAD") if wt and os.path.isdir(wt) else ""
    diff = diff.splitlines()[-1].strip() if diff else "no changes"
    breach, why = st.get("breach_class") or classify(st)
    ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    block = ("\n## %s · attempt %s · %s · %s\nstatus: re-plan\n\n### Summary\n"
             "Stopped by the time-box hook at the hard %s limit (%s). Written by the harness; "
             "the worker was not asked to report.\n\n### Result\n| Check | Status | Detail |\n|---|---|---|\n"
             "| budget | HARD (%s) | %s |\n| worktree diff | discarded | %s |\n"
             "| breach class | %s | %s |\n\n### Next\n"
             "re-plan: confirm or override the breach class, then act on it (skills/aloop/reference.md \"Breach classes\"). "
             "Transcript: %s\n") % (
        st.get("task") or "?", st.get("attempt") or "?", st["role"], ts, cls, left, cls, left, diff,
        breach, why.replace("|", "/"), st.get("transcript") or "?")
    out = os.path.join(st["story_dir"], "output.md")
    try:
        new = not os.path.isfile(out)
        with open(out, "a") as f:
            if new:
                f.write("---\ntype: output\n---\n")
            f.write(block)
    except OSError:
        pass


def _config_profile(cwd, key):
    import _config
    return (_config.load(cwd) or {}).get(key)


def role_profile(cwd, role):
    b = dict(zip(("TOKENS_SOFT", "TOKENS_HARD", "TIME_SOFT_MIN", "TIME_HARD_MIN"), ROLE_PROFILES[role]))
    src = "built-in %s profile" % role
    key = "AGENTIC_BUDGET_" + role.upper().replace("-", "_")
    spec = (_config_profile(cwd, key[len("AGENTIC_"):]) or "")
    if spec:
        for k, v in re.findall(r"(tokens_soft|tokens_hard|time_soft|time_hard)\s*=\s*(\d+)", spec):
            b[k.upper() + ("_MIN" if k.startswith("time") else "")] = int(v)
        src = ".aladdin/config.yaml budgets.roles.%s" % role
    try:
        for line in open(_paths.defaults_file(cwd)):
            m = re.match(r"^\s*(?:export\s+)?%s\s*=\s*['\"]?([^'\"#\n]*)" % key, line)
            if m:
                for k, v in re.findall(r"(tokens_soft|tokens_hard|time_soft|time_hard)\s*=\s*(\d+)", m.group(1)):
                    b[k.upper() + ("_MIN" if k.startswith("time") else "")] = int(v)
                src = "defaults.md %s" % key
    except OSError:
        pass
    b["TOKENS_SOFT"] = min(b["TOKENS_SOFT"], b["TOKENS_HARD"])
    b["TIME_SOFT_MIN"] = min(b["TIME_SOFT_MIN"], b["TIME_HARD_MIN"])
    b["TOKEN_METER"] = _paths.settings(cwd).get("TOKEN_METER") or "fresh"
    return b, src


def observe(mode, payload, agent_id, role):
    """Meter a non-worker role: record soft/hard crossings, never emit anything."""
    cwd = payload.get("cwd") or os.getcwd()
    spath = os.path.join(state_dir(cwd), "%s.json" % safe(agent_id))
    st = load_state(spath)
    now = time.time()
    # A reviewer or final gate dispatched into a host worktree needs the contract copy as much
    # as a worker does: its own `selfcheck` finds the task only through it (live runs 15–17).
    wt, how = find_worktree(payload, cwd, agent_id, role)
    project = _paths.project(cwd)
    host_tid = host_task_id(payload, agent_id) if mode != "stop" else ""
    if host_tid and wt:
        copy_contract(cwd, wt, host_tid)
    elif host_tid:
        copy_contract(cwd, project, host_tid, main_tree=True)   # no worktree: it runs in the main tree
        how = how or "main tree"
    if host_tid and mode != "stop":
        seed_output(cwd, host_tid)
    if st is None:
        b, src = role_profile(cwd, role)
        st = {"agent_id": agent_id, "role": role, "task": "", "attempt": "", "story_dir": "", "start": now,
              "budget": b, "budget_source": src, "observe": True, "found_by": "role profile",
              "soft_warned": False, "final_warned": False, "hard": False, "done": None}
    if host_tid and not st.get("task"):
        env = contract(cwd, host_tid) or {}
        st.update({"task": host_tid, "attempt": env.get("ATTEMPT", ""), "story_dir": env.get("STORY_DIR", ""),
                   "worktree": wt or st.get("worktree"), "found_by": how or st.get("found_by")})
    if mode == "stop":
        st["done"] = now
        save_state(spath, st)
        if st.get("task") and not st.get("worktree"):
            mc = _paths.marker(project, "task.env")      # the main-tree copy is this dispatch's only
            if os.path.isfile(mc) and read_kv(mc).get("TASK_ID") == st["task"]:
                try:
                    os.remove(mc)
                except OSError:
                    pass
        return
    st["done"] = None
    b = st["budget"]
    tp = transcript_for(payload, agent_id)
    if tp:
        st["transcript"] = tp
    toks, cls = tokens_used(st.get("transcript"), b.get("TOKEN_METER", "fresh"))
    if toks is not None:
        st["tokens"], st["usage"] = toks, cls
    toks = st.get("tokens")
    mins = (now - st["start"]) / 60.0
    st["elapsed_min"] = round(mins, 2)
    extra = {"tokens": toks, "elapsed_min": round(mins, 2), "observe": True}
    if toks is not None and toks >= b["TOKENS_SOFT"] and not st.get("token_soft_limit"):
        st["token_soft_limit"] = now
        log_event(cwd, "task.token_soft_limit", st, tokens_soft=b["TOKENS_SOFT"], **extra)
    if mins >= b["TIME_SOFT_MIN"] and not st.get("time_soft_limit"):
        st["time_soft_limit"] = now
        log_event(cwd, "task.time_soft_limit", st, time_soft_min=b["TIME_SOFT_MIN"], **extra)
    over_tok = toks is not None and toks >= b["TOKENS_HARD"]
    if (over_tok or mins >= b["TIME_HARD_MIN"]) and not st["hard"]:
        st["hard"] = now
        log_event(cwd, "task.token_hard_limit" if over_tok else "task.time_hard_timeout", st, **extra)
    save_state(spath, st)


def hook(mode):
    if os.environ.get("SKIP_HOOKS") == "1" or os.environ.get("AGENTIC_NO_BUDGET") == "1":
        return
    raw = sys.stdin.read()
    if not any(w in raw for w in WORKERS + tuple(ROLE_PROFILES)):   # cheap exit: no model role
        return
    payload = json.loads(raw)
    agent_id, agent_type = payload.get("agent_id") or "", payload.get("agent_type") or ""
    other = next((r for r in ROLE_PROFILES if agent_type == r or agent_type.endswith(":" + r)), None)
    if agent_id and other:
        return observe(mode, payload, agent_id, other)
    role = next((w for w in WORKERS if agent_type == w or agent_type.endswith(":" + w)), None)
    if not agent_id or not role:
        return
    cwd = payload.get("cwd") or os.getcwd()
    wt, how = find_worktree(payload, cwd, agent_id, role)
    top = wt or sh("git", "-C", cwd, "rev-parse", "--show-toplevel") or cwd
    host_tid = host_task_id(payload, agent_id)
    if host_tid and mode != "stop":
        copy_contract(cwd, top, host_tid)
        seed_output(cwd, host_tid)
    spath = os.path.join(state_dir(cwd), "%s.json" % safe(agent_id))
    st = load_state(spath)
    now = time.time()

    if mode == "stop":
        if st:
            st["done"] = now
            save_state(spath, st)
        return

    def resolve_for(top):
        env = read_kv(_paths.marker(top, "task.env"))
        # the supervisor's contract wins over the worker-editable worktree copy (M0.7)
        sup = contract(cwd, host_tid or env.get("TASK_ID", ""))
        if sup:
            env = sup
        task = env.get("TASK_ID", "")
        tasks_file = os.path.join(env["STORY_DIR"], "tasks.md") if env.get("STORY_DIR") else None
        tn = re.sub(r"^.*[-_ ](T\d+)$", r"\1", task.split()[-1]) if task else None
        b, src = resolve(cwd, tasks_file, tn, env, with_source=True)
        if sup:
            src = src.replace("task.env BUDGET_*", "contract BUDGET_*")
        return env, task, b, src

    if st is None:
        env, task, b, src = resolve_for(top)
        st = {"agent_id": agent_id, "role": role, "task": task, "attempt": env.get("ATTEMPT", ""),
              "worktree": top, "story_dir": env.get("STORY_DIR", ""), "start": now, "budget": b,
              "budget_source": src, "task_env_found": bool(env), "found_by": how,
              "soft_warned": False, "final_warned": False, "hard": False, "done": None}
    elif wt and not st.get("task_env_found"):
        # the worktree became known after the first call: take ITS task.env/budget, keep the clock
        env, task, b, src = resolve_for(wt)
        old_top = st.get("worktree")
        st.update({"task": task, "attempt": env.get("ATTEMPT", ""), "worktree": wt, "story_dir": env.get("STORY_DIR", ""),
                   "budget": b, "budget_source": src, "task_env_found": bool(env), "found_by": how})
        if st.get("hard") and not st.get("hook_killed"):
            st.update({"hard": False, "denials": 0})       # it was judged against the wrong budget
            try:
                os.remove(_paths.marker(old_top, "budget-exceeded"))
            except OSError:
                pass
    if wt:
        remember_worktree(cwd, agent_id, wt)
    if st.get("done") and not st.get("killed") and not st.get("hook_killed"):
        st["done"] = None          # a SubagentStop gate blocked the stop: still working
    b = st["budget"]
    tp = transcript_for(payload, agent_id)
    if tp:
        st["transcript"] = tp
    toks, cls = tokens_used(st.get("transcript") or tp, b.get("TOKEN_METER", "fresh"))
    if toks is not None:
        st["tokens"], st["usage"] = toks, cls
    toks = st.get("tokens")
    mins = (now - st["start"]) / 60.0
    st["elapsed_min"] = round(mins, 2)

    t_hard = b["TOKENS_HARD"]
    m_hard = b["TIME_HARD_MIN"]
    over_hard = (toks is not None and toks >= t_hard) or mins >= m_hard
    over_soft_time = mins >= b["TIME_SOFT_MIN"]
    over_soft_tokens = toks is not None and toks >= b["TOKENS_SOFT"]
    near_hard = (toks is not None and toks >= 0.9 * t_hard) or mins >= 0.9 * m_hard
    left = "%s of %s tokens used (%s left), %.1f of %d min used (%.1f min left); budget from %s" % (
        fmt_k(toks), fmt_k(t_hard), fmt_k(max(t_hard - toks, 0)) if toks is not None else "?",
        mins, m_hard, max(m_hard - mins, 0), st.get("budget_source") or "?")
    report = os.path.join(st["story_dir"], "output.md") if st.get("story_dir") else "the story's output.md"

    if over_hard and not st["hard"]:
        st["hard"] = now
        try:
            with open(os.path.join(_paths.marker_dir(top), "budget-exceeded"), "w") as f:
                f.write("role=%s attempt=%s agent_id=%s at=%d %s\n" % (role, st["attempt"], agent_id, now, left))
        except OSError:
            pass
    if over_soft_tokens and not st.get("token_soft_limit"):
        # telemetry only (ROADMAP §3.1): record it for the planner, never tell the worker
        st["token_soft_limit"] = now
        log_event(cwd, "task.token_soft_limit", st, tokens=toks, tokens_soft=b["TOKENS_SOFT"],
                  elapsed_min=round(mins, 2))

    def record_hard():
        if st.get("hard_logged"):
            return
        st["hard_logged"] = now
        cls = "token" if toks is not None and toks >= t_hard else "time"
        st["breach_class"] = list(classify(st))
        log_event(cwd, "task.token_hard_limit" if cls == "token" else "task.time_hard_timeout", st,
                  tokens=toks, elapsed_min=round(mins, 2), breach_class=st["breach_class"][0],
                  breach_evidence=st["breach_class"][1])
        harness_report(st, left, cls)

    if st["hard"] and st.get("task_env_found"):
        record_hard()
    save_state(spath, st)

    if st["hard"]:
        msg = ("HARD BUDGET EXCEEDED (%s). You are stopped now. Do nothing else: no report, no "
               "tests, no edits. The harness has recorded this attempt in %s (status: re-plan) and "
               "the task goes back to the planner." % (left, report))
        stop = ("aloop: HARD BUDGET — %s %s stopped by the time-box hook (%s). "
                "Not a pass; the supervisor re-plans this task." % (role, st.get("task") or "", left))
        if mode == "pre":
            st["denials"] = st.get("denials", 0) + 1
            save_state(spath, st)
            if st["denials"] <= GRACE_DENIALS:
                emit("PreToolUse", deny=msg + " (%d/%d refusals before a forced stop)" % (st["denials"], GRACE_DENIALS))
            # past the grace: let this call through — its PostToolUse ends the agent
            return
        if mode == "post":
            if not st.get("task_env_found") and st["hard"] == now:
                # judged before this worker's worktree (and its budget) is known: one more
                # call may find it and withdraw the verdict (see the re-resolve above)
                emit("PostToolUse", context=msg)
                return
            record_hard()                                # no grace call, no narration
            st["hook_killed"] = now
            st["done"] = now
            save_state(spath, st)
            emit("PostToolUse", context=msg, stop=stop)  # deterministic stop, no model decision
        return

    if mode != "post":
        return
    if near_hard and not st["final_warned"]:
        st["final_warned"] = True
        save_state(spath, st)
        emit("PostToolUse", context=(
            "FINAL BUDGET WARNING: %s. At the hard limit you will be KILLED and this attempt "
            "discarded. Wrap up NOW: finish the smallest complete step, run selfcheck once, "
            "append your output.md report. If the task cannot fit, say so in ### Next "
            "(status: re-plan) so the planner can split it." % left))
    elif over_soft_time and not st["soft_warned"]:
        st["soft_warned"] = True
        save_state(spath, st)
        emit("PostToolUse", context=(
            "SOFT TIME LIMIT reached: %s. Complete this task within what is left or end it "
            "gracefully — no exploration, no refactors, no re-reading files you already read. "
            "If it will not fit, append your output.md report now with status: re-plan "
            "and what remains, rather than being killed at the hard limit." % left))


# ── supervisor commands ───────────────────────────────────────────────
def all_states(cwd):
    d = state_dir(cwd)
    out = []
    for p in sorted(glob.glob(os.path.join(d, "*.json"))):
        st = load_state(p)
        if st:
            out.append((p, st))
    return out


def refresh(st):
    """Re-measure an attempt from outside the hook (the watcher polls between tool calls).
    True when the attempt is at/over a HARD limit."""
    now = time.time()
    st["elapsed_min"] = round((now - st["start"]) / 60.0, 2)
    t, cls = tokens_used(st.get("transcript"), st["budget"].get("TOKEN_METER", "fresh"))
    if t is not None:
        st["tokens"], st["usage"] = t, cls
    b = st["budget"]
    return bool(st.get("hard")) or st["elapsed_min"] >= b["TIME_HARD_MIN"] or (st.get("tokens") or 0) >= b["TOKENS_HARD"]


def stuck_releases(cwd):
    """Gates leave .agentic/state/stuck/<TASK>.<ATTEMPT> when they release a worker that
    repeated one block N times (see _gatelib.sh). Report each once: the first line of the
    marker plus the reason, then rename it *.reported."""
    d = _paths.home(cwd, "state/stuck", make=False)
    out = []
    for name in sorted(os.listdir(d)) if os.path.isdir(d) else []:
        p = os.path.join(d, name)
        if name.endswith(".reported") or not os.path.isfile(p):
            continue
        with open(p) as f:
            head, _, reason = f.read().partition("\n")
        out.append("%s reason=%r" % (head.strip(), reason.strip()[:300]))
        os.replace(p, p + ".reported")
    return out


def watch(cwd, interval, grace):
    """The supervisor's sleep. Returns when a worker was STOPPED by the time-box hook, a
    worker is past its HARD limit + grace and still running (the hook's backstop: TaskStop
    it), or no worker is running. Run with run_in_background: its exit is the wake-up."""
    while True:
        now = time.time()
        stopped, kill = [], []
        states = all_states(cwd)
        running = [(p, s) for p, s in states if not s.get("done") and not s.get("observe")]
        for p, s in states:
            if s.get("hook_killed") and not s.get("reported"):
                s["reported"] = now
                save_state(p, s)
                stopped.append(s)
        for p, s in running:
            if refresh(s):
                if not s.get("hard"):
                    s["hard"] = now
                save_state(p, s)
                if now - s["hard"] >= grace:
                    kill.append(s)
        stuck = stuck_releases(cwd)
        line = "%s agent_id=%s task=%s role=%s attempt=%s tokens=%s/%s elapsed=%.1f/%dmin class=%s"
        for tag, group in (("STOPPED", stopped), ("KILL", kill)):
            for s in group:
                print(line % (tag, s["agent_id"], s.get("task") or "?", s["role"], s.get("attempt") or "?",
                              fmt_k(s.get("tokens")), fmt_k(s["budget"]["TOKENS_HARD"]), s.get("elapsed_min") or 0,
                              s["budget"]["TIME_HARD_MIN"], (s.get("breach_class") or classify(s))[0]))
        for s_ in stuck:
            print("STUCK %s" % s_)
        if stuck:
            print("-> STUCK lines: that worker hit the same gate block N times in a row and was released UNVERIFIED "
                  "(not a pass). Do not merge; discard its worktree, then re-dispatch the task with a Feedback block "
                  "that addresses the quoted reason (a new attempt), or re-plan it.")
            if not (stopped or kill):
                return 3
        if stopped or kill:
            if kill:
                print("-> KILL lines: the hook could not stop these — TaskStop each, then `budget mark-killed <agent_id>`.")
            print("-> Budget overrun: discard these attempts (never merge), PAUSE the sprint and dispatch the "
                  "planner in replan mode (skills/aloop/reference.md 'Budget overrun'). Do NOT retry these tasks as-is.")
            return 3
        if not running:
            print("IDLE: no worker running.")
            return 0
        time.sleep(interval)


def mark_killed(cwd, agent_ids):
    n = 0
    for p, s in all_states(cwd):
        if s["agent_id"] in agent_ids or "ALL" in agent_ids and not s.get("done"):
            s["done"] = time.time()
            s["killed"] = True
            save_state(p, s)
            n += 1
    print("marked killed: %d" % n)
    return 0


def status(cwd):
    rows = all_states(cwd)
    if not rows:
        print("no tracked worker attempts")
        return 0
    print("%-22s %-13s %-14s %-4s %-16s %-14s %-7s %s" % ("agent_id", "role", "task", "att", "tokens", "minutes", "state", "budget from (worktree found by)"))
    for _, s in rows:
        refresh(s)
        b = s["budget"]
        state = "observe" if s.get("observe") and not s.get("hard") else "obs-HARD" if s.get("observe") else "killed" if s.get("killed") else "done" if s.get("done") else ("HARD" if s.get("hard") else ("soft" if s.get("soft_warned") else ("soft-tok" if s.get("token_soft_limit") else "ok")))
        print("%-22s %-13s %-14s %-4s %-16s %-14s %-7s %s" % (
            s["agent_id"][:22], s["role"], (s.get("task") or "?")[:14], s.get("attempt") or "?",
            "%s/%s %s" % (fmt_k(s.get("tokens")), fmt_k(b["TOKENS_HARD"]), b.get("TOKEN_METER", "context")[0]),
            "%.1f/%d" % (s["elapsed_min"], b["TIME_HARD_MIN"]), state,
            "%s (%s)" % (s.get("budget_source") or "?", s.get("found_by") or "not found")))
    return 0


# ── sprint envelope + admission control (ROADMAP §4.2) ────────────────
def sprint_dir_of(cwd, task):
    m = re.match(r"^S(\d+)-\d+", task or "")
    return os.path.join(_paths.docs(cwd), "sprint%s" % m.group(1)) if m else ""


def sprint_charge(cwd, sdir):
    """Sum of every metered attempt's charge in this sprint (workers by story dir)."""
    total = 0
    for _, s in all_states(cwd):
        if (s.get("story_dir") or "").startswith(sdir.rstrip("/") + "/"):
            total += s.get("tokens") or 0
    return total


def rollover_tasks(sdir):
    try:
        return re.findall(r"(?m)^- (S\d+-\d+-T\d+)\b", open(os.path.join(sdir, "rollover.md")).read())
    except OSError:
        return []


def admit(cwd, task):
    """Supervisor, before dispatching TASK_ID: 0 admit · 3 admission closed (carried over).
    Soft envelope → a one-time rollover warning; hard → admission closes for the rest of
    the sprint, the reason is recorded, and every refused task is listed as carried over.
    In-flight attempts finish under their own limits. A rollover is not a failure."""
    sdir = sprint_dir_of(cwd, task)
    if not sdir:
        print("budget admit: TASK_ID must look like S1-02-T3", file=sys.stderr)
        return 64
    os.makedirs(sdir, exist_ok=True)
    st = _paths.settings(cwd)
    soft, hard = st["SPRINT_TOKENS_SOFT"], st["SPRINT_TOKENS_HARD"]
    used = sprint_charge(cwd, sdir)
    spath = os.path.join(state_dir(cwd), "%s.sprint.json" % os.path.basename(sdir))
    sp = load_state(spath) or {"sprint": os.path.basename(sdir)}
    ev = {"agent_id": "", "task": task, "role": "supervisor", "attempt": "", "story_dir": sdir}
    rf = os.path.join(sdir, "rollover.md")
    if used >= hard and not sp.get("admission_closed"):
        sp["admission_closed"] = time.time()
        log_event(cwd, "sprint.admission_closed", ev, tokens=used, sprint_tokens_hard=hard)
        with open(rf, "w") as f:
            f.write("---\ntype: rollover\nsprint: %s\nclosed_at: %s\n---\n# Rollover — admission closed\n\n"
                    "Reason: sprint token envelope reached (%s of %s, TOKEN_METER charge). In-flight tasks "
                    "finished under their own limits; the tasks below were not started and carry over "
                    "to the next planning cycle. This is not a failure.\n\n## Carried over\n"
                    % (os.path.basename(sdir)[6:], time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                       fmt_k(used), fmt_k(hard)))
    if sp.get("admission_closed"):
        if task not in rollover_tasks(sdir):
            with open(rf, "a") as f:
                f.write("- %s\n" % task)
            log_event(cwd, "sprint.rolled_over", ev, tokens=used)
        save_state(spath, sp)
        print("ADMISSION CLOSED %s: sprint envelope %s/%s — do not dispatch; carried over in %s"
              % (task, fmt_k(used), fmt_k(hard), os.path.relpath(rf, _paths.project(cwd))))
        return 3
    if used >= soft and not sp.get("soft_warned"):
        sp["soft_warned"] = time.time()
        log_event(cwd, "sprint.token_soft_limit", ev, tokens=used, sprint_tokens_soft=soft)
        print("ROLLOVER WARNING: sprint envelope %s/%s (soft %s). Prefer critical-path tasks; "
              "admission closes at the hard limit." % (fmt_k(used), fmt_k(hard), fmt_k(soft)))
    save_state(spath, sp)
    print("ADMIT %s: sprint envelope %s/%s" % (task, fmt_k(used), fmt_k(hard)))
    return 0


def rollover_check(sdir):
    """gate-final on a rolled-over sprint: an unticked plan-ready.md box is allowed only
    when it belongs to a carried-over task (its own line or its `## Tn` section names it)."""
    carried = rollover_tasks(sdir)
    bad = []
    for pr in glob.glob(os.path.join(sdir, "s[0-9]*-[0-9]*-*", "plan-ready.md")):
        story = re.match(r"^(s\d+-\d+)", os.path.basename(os.path.dirname(pr))).group(1).upper()
        sec = ""
        for line in open(pr):
            h = re.match(r"^#+\s+(T\d+)\b", line)
            if h:
                sec = h.group(1)
            if re.match(r"^\s*- \[ \]", line):
                names = set(re.findall(r"\b(?:S\d+-\d+-)?(T\d+)\b", line)) | ({sec} if sec else set())
                if not any("%s-%s" % (story, t) in carried for t in names):
                    bad.append("%s: %s" % (os.path.relpath(pr, sdir), line.strip()))
    for b in bad:
        print("unticked and not carried over: " + b, file=sys.stderr)
    return 2 if bad else 0


def envelope(cwd, task):
    """ROADMAP §4.3: the MINIMAL failure envelope the planner gets for a task — facts and
    references only. Deeper evidence (transcript, diff) is read on demand, never inlined."""
    atts = [s for _, s in all_states(cwd) if s.get("task") == task and not s.get("observe")]
    if not atts:
        print("budget envelope: no tracked attempt for %s" % task, file=sys.stderr)
        return 1
    s = max(atts, key=lambda a: a.get("start") or 0)
    b = s.get("budget") or {}
    tok_hit = s.get("tokens") is not None and s["tokens"] >= (b.get("TOKENS_HARD") or 1)
    limit = ("token_hard" if tok_hit else "time_hard") if s.get("hard") else ("token_soft" if s.get("token_soft_limit") else "none")
    gate = "none"
    for g in _usage_jsonl(os.path.join(_paths.home(cwd, "logs"), "gates.jsonl")):
        if g.get("task") == task and not g.get("selfcheck"):
            gate = "%s %s" % (g.get("gate"), "pass" if g.get("exit") == 0 else "block")
    wt = s.get("worktree") or ""
    changed = sh("git", "-C", wt, "diff", "--name-only", "HEAD").split() if wt and os.path.isdir(wt) else []
    cls = s.get("breach_class") or (classify(s) if s.get("hard") else ["-", ""])
    print("\n".join([
        "task: %s" % task, "attempt: %s" % (s.get("attempt") or "?"), "role: %s" % s["role"],
        "limit: %s" % limit,
        "observed: %s tokens (%s meter) of %s, %.1f of %s min" % (fmt_k(s.get("tokens")), b.get("TOKEN_METER", "context"),
                                                                fmt_k(b.get("TOKENS_HARD")), s.get("elapsed_min") or 0, b.get("TIME_HARD_MIN")),
        "breach_class: %s%s" % (cls[0], " — " + cls[1] if cls[1] else ""),
        "last_gate: %s" % gate,
        "changed: %s" % (", ".join(changed[:12]) + (" …" if len(changed) > 12 else "") if changed else "none in worktree"),
        "refs:",
        "  transcript: %s" % (s.get("transcript") or "?"),
        "  events: %s (task=%s)" % (_paths.home_rel(None, "logs", "events.jsonl"), task),
        "  output: %s" % (os.path.join(s["story_dir"], "output.md") if s.get("story_dir") else "?"),
        "  diff: git -C %s diff HEAD" % (wt or "?"),
    ]))
    return 0


def _usage_jsonl(path):
    try:
        with open(path) as f:
            for line in f:
                try:
                    yield json.loads(line)
                except ValueError:
                    continue
    except OSError:
        return


def split_parent(root, story, tn):
    """`split_from: T3` under `## T5 — ...` in the story's tasks.md -> "T3"."""
    for tf in glob.glob(os.path.join(root, "docs", "agents", "sprint*", story.lower() + "-*", "tasks.md")):
        inside = False
        with open(tf) as f:
            for line in f:
                if line.startswith("## "):
                    inside = re.match(r"^##\s+" + re.escape(tn) + r"\b", line) is not None
                    continue
                m = re.match(r"^\s*split_from:\s*(T\d+)", line) if inside else None
                if m:
                    return m.group(1)
    return None


def replans(cwd, task):
    """How many times TASK_ID's lineage was split: `wave-K replan SN-NN start Tn` lines in
    execution.log for the task AND every ancestor it was split from (`split_from:`)."""
    m = re.match(r"^(S\d+-\d+)(?:[-_ ]+(T\d+))?", task or "")
    if not m:
        print("budget replans: TASK_ID must look like S1-02-T3", file=sys.stderr)
        return 64
    root = main_tree(cwd)
    story, tn = m.group(1), m.group(2)
    lineage, cur = [], tn
    while cur and cur not in lineage and len(lineage) < 20:
        lineage.append(cur)
        cur = split_parent(root, story, cur)
    n = 0
    for log in glob.glob(os.path.join(root, "docs", "agents", "sprint*", "execution.log")):
        with open(log) as f:
            for line in f:
                w = line.split()
                if " replan " in line and story in w and "start" in w and (not tn or any(t in w for t in lineage)):
                    n += 1
    cap = resolve(cwd)["MAX_REPLANS"]
    print("replans=%d cap=%d lineage=%s%s" % (n, cap, "<-".join(lineage) or story,
          "  -> CAP REACHED: escalate (hard stop), do not split again" if n >= cap else ""))
    return 3 if n >= cap else 0


def main(argv):
    cwd = os.getcwd()
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd = argv[0]
    opts = {}
    it = iter(argv[1:])
    for a in it:
        if a.startswith("--"):
            opts[a[2:]] = next(it, "")
        else:
            opts.setdefault("_", []).append(a)
    if cmd == "hook":
        try:
            hook((opts.get("_") or ["post"])[0])
        except Exception:
            pass                                   # never break a tool call
        return 0
    if cmd == "resolve":
        wt = opts.get("worktree") or sh("git", "rev-parse", "--show-toplevel") or cwd
        env = read_kv(_paths.marker(wt, "task.env"))
        b, src = resolve(cwd, opts.get("tasks"), opts.get("task"), env, with_source=True)
        for k in ("TOKENS_SOFT", "TOKENS_HARD", "TIME_SOFT_MIN", "TIME_HARD_MIN"):
            print("BUDGET_%s=%d" % (k, b[k]))
        print("BUDGET_TOKEN_METER=%s" % b["TOKEN_METER"])
        print("# from: %s" % src)
        return 0
    if cmd == "watch":
        return watch(cwd, int(opts.get("interval") or 20), int(opts.get("grace") or 60))
    if cmd == "status":
        return status(cwd)
    if cmd == "mark-killed":
        return mark_killed(cwd, opts.get("_") or [])
    if cmd == "replans":
        return replans(cwd, (opts.get("_") or [""])[0])
    if cmd == "envelope":
        return envelope(cwd, (opts.get("_") or [""])[0])
    if cmd == "admit":
        return admit(cwd, (opts.get("_") or [""])[0])
    if cmd == "rollover-check":
        return rollover_check((opts.get("_") or [""])[0])
    if cmd == "classify":
        found = 0
        for _, s in all_states(cwd):
            if s["agent_id"] in (opts.get("_") or []) or s.get("task") in (opts.get("_") or []):
                c, why = s.get("breach_class") or classify(s)
                print("%s %s %s: %s — %s" % (s["agent_id"], s.get("task") or "?", s["role"], c, why))
                found += 1
        return 0 if found else 1
    print("budget: unknown command %r (see budget --help)" % cmd, file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
