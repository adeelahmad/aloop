#!/usr/bin/env python3
"""capabilities — the host capability matrix and the context-boundary rule (ROADMAP §4.4, §4.9).

Usage:
  capabilities [HOST]                 the matrix row(s): usage, compaction, live messaging,
                                      lifecycle, gate blocking (HOST: claude|codex|opencode|dsh;
                                      default all)
  capabilities boundary [HOST]        what to do at a sprint boundary: `rotate` (fresh session,
                                      the correctness path) unless AGENTIC_CONTEXT_BOUNDARY=compact
                                      AND the host advertises compaction
  capabilities boundary --keep --reason "one line"
                                      keep the session open across the boundary; needs a reason,
                                      recorded as a decision

A capability marked `unknown` is treated as not advertised. Data: plugin/hosts/capabilities.json.
"""
import json
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import _events  # noqa: E402
import _paths  # noqa: E402

FIELDS = ("usage", "compaction", "live_messaging", "lifecycle", "gate_blocking")


def matrix():
    with open(os.path.join(HERE, "..", "hosts", "capabilities.json")) as f:
        return json.load(f)["hosts"]


def host_now(arg=""):
    return arg or os.environ.get("AGENTIC_HOST") or "claude"


def boundary(cwd, host):
    """(decision, instruction) for the end of a sprint on this host."""
    caps = matrix().get(host) or {}
    rotate = caps.get("rotate_command") or "/clear"
    want = (_paths.settings(cwd).get("CONTEXT_BOUNDARY") or "rotate").lower()
    if want == "compact" and caps.get("compaction") == "advertised":
        return "compact", "compact the session (the %s adapter advertises compaction)" % host
    why = "" if want != "compact" else " (compaction is not advertised by %s, so rotating)" % host
    return "rotate", "start a fresh session with %s%s" % (rotate, why)


def main(argv):
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cwd = os.getcwd()
    if argv and argv[0] == "boundary":
        rest = argv[1:]
        if "--keep" in rest:
            reason = rest[rest.index("--reason") + 1] if "--reason" in rest[:-1] else ""
            if not reason.strip() or "\n" in reason:
                print("BLOCK[capabilities]: keeping a session across a boundary needs a one-line --reason",
                      file=sys.stderr)
                return 2
            _events.emit(cwd, "decision.recorded", role="supervisor",
                         decision={"kind": "plan", "reason": "keep session across the sprint boundary: " + reason,
                                   "evidence_refs": [], "authority_ref": None})
            print("keep")
            return 0
        host = host_now(next((a for a in rest if not a.startswith("--")), ""))
        if host not in matrix():
            print("capabilities: unknown host %r" % host, file=sys.stderr)
            return 64
        d, how = boundary(cwd, host)
        print("%s: %s" % (d, how))
        return 0
    hosts = matrix()
    pick = [argv[0]] if argv else sorted(hosts)
    for h in pick:
        if h not in hosts:
            print("capabilities: unknown host %r" % h, file=sys.stderr)
            return 64
        print("%-9s %s" % (h, "  ".join("%s=%s" % (k, hosts[h].get(k, "unknown")) for k in FIELDS)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
