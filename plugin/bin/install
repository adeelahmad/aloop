#!/usr/bin/env python3
"""install (aloop install) — make this plugin work in Codex, OpenCode and DeepSeek Harness (Claude Code needs nothing).

  aloop install codex    [--project DIR | --global]
  aloop install opencode [--project DIR | --global]
  aloop install dsh      [--project DIR | --global]   (alias: deepseek)
  aloop install claude                        print the Claude Code install commands
  aloop install <host> --uninstall [...]      remove what the installer wrote
  aloop install status   [--project DIR]      what is installed where

Everything is RENDERED from this plugin's own sources (agents/*.md, skills/*/SKILL.md,
hosts/opencode/aloop.js), so the hosts never drift from Claude Code. Models come
from docs/agents/defaults.md (MODEL_*_CODEX / MODEL_*_OPENCODE / MODEL_*_DSH); `aloop-init --apply`
re-renders installed hosts after a change.

codex:    <DIR>/.codex/agents/<role>.toml  (or ~/.codex/agents with --global)
          + ~/.local/bin/aloop (+ legacy alias agentic)  (Codex does not put plugin bin/ on PATH)
          The plugin itself (skills, hooks, commands) installs through Codex's own
          plugin manager — it reads this repo's .claude-plugin manifests natively:
            codex plugin marketplace add adeelahmad/agentic-agile
            codex plugin add aloop@aloop-marketplace
          then approve the hooks once with /hooks (Codex runs only trusted hooks).
opencode: <DIR>/.opencode/{agents,skills,commands,plugins}/ (or ~/.config/opencode)
          + ~/.local/bin/aloop (+ legacy alias agentic)
dsh:      $DSH_HOME/profiles/aloop/ (DSH_HOME defaults to ~/.dsh): the `aloop` profile — the roles
          as agent presets aloop-<role>, the two delegation tools (subagent: execution roles,
          subagent_planning: planning roles) with their models, and the plugin
          hosts/dsh/aloop.mjs, loaded in place. dsh has no project-scoped plugin layer, so the
          profile is always under $DSH_HOME; it records the project it serves (or every one, with
          --global), and only that project's `aloop-init` re-renders or uninstall removes it. The
          skills go to <DIR>/.dsh/skills (or $DSH_HOME/skills with --global). + ~/.local/bin/aloop.
          Run: dsh --profile aloop
"""
import json
import os
import re
import shutil
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
ROOT = os.path.dirname(HERE)
sys.path.insert(0, HERE)
import _paths  # noqa: E402
import _routes  # noqa: E402

PLANNING = _routes.GROUPS["planning"]          # the planning-route roles, mission roles included
MARK = "aloop (generated by aloop-install; re-run it instead of editing)"
# (plugin skill dir, OpenCode and dsh skill name); a skill missing from the plugin is skipped
HOST_SKILLS = (("aloop", "aloop"), ("aladdin", "aladdin"), ("init", "aloop-init"), ("mission", "aloop-mission"))
# Files written before the rename to aloop (v0.10.x). They are still ours: an install or
# uninstall removes them, so OpenCode never loads the old plugin next to the new one.
LEGACY_MARK = "agentic-agile (generated by agentic-install; re-run it instead of editing)"
LEGACY_OPENCODE = (os.path.join("commands", "agentic-init.md"), os.path.join("plugins", "agentic-agile.js"))
LEGACY_OPENCODE_SKILLS = ("agentic-agile", "agentic-agile-init")


# ── sources ───────────────────────────────────────────────────────────
def split_frontmatter(text):
    m = re.match(r"^---\n(.*?)\n---\n?(.*)$", text, re.S)
    if not m:
        return {}, text
    fm, key, block = {}, None, []
    for line in m.group(1).splitlines() + ["END:"]:
        mm = re.match(r"^([A-Za-z][\w-]*):\s*(.*)$", line)
        if not mm:
            if key and line.startswith((" ", "\t")):
                block.append(line.strip())        # continuation of a folded (>-, >, |) value
            continue
        if key:
            fm[key] = " ".join(block)
            key, block = None, []
        v = re.sub(r"\s+#.*$", "", mm.group(2)).strip()
        if v in (">-", ">", "|", "|-"):
            key = mm.group(1)
            continue
        if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
            v = v[1:-1]
        fm[mm.group(1)] = v
    fm.pop("END", None)
    return fm, m.group(2)


def agents():
    out = []
    for p in sorted(os.listdir(os.path.join(ROOT, "agents"))):
        if p.endswith(".md"):
            fm, body = split_frontmatter(open(os.path.join(ROOT, "agents", p)).read())
            out.append((fm.get("name") or p[:-3], fm.get("description", ""), body.strip() + "\n"))
    return out


def host_body(body, host):
    """Agent/skill text is written for Claude Code; add the host's dispatch vocabulary."""
    body = body.replace("${CLAUDE_PLUGIN_ROOT}", ROOT)
    note = {
        "codex": "\n\n## On Codex\nTools: call `aloop <tool>` (e.g. `aloop selfcheck`). If you were dispatched "
                 "with a worktree path, your FIRST command is `aloop bind <that path>`; then run every shell command as "
                 "`cd <worktree> && …` and patch only absolute paths under it (hooks enforce this).\n",
        "opencode": "\n\n## On OpenCode\nTools: call `aloop <tool>` (e.g. `aloop selfcheck`). If you were dispatched "
                    "with a worktree path, your FIRST command is `aloop bind <that path>`; the plugin then runs your "
                    "commands and edits inside it.\n",
        "dsh": "\n\n## On DeepSeek Harness (dsh)\nTools: call `aloop <tool>` (e.g. `aloop selfcheck`). Roles are "
               "dispatched with `subagent` (%s) or `subagent_planning` (%s), `agent_preset: aloop-<role>`. If you were "
               % (", ".join(_routes.GROUPS["worker"]), ", ".join(_routes.GROUPS["planning"])) +
               "dispatched with a worktree path, your FIRST command is `aloop bind <that path>`; then work only inside "
               "it (your commands run there; use absolute paths under it for every file). Calls outside it are refused. "
               "Do not `send_message` the supervisor: your result reaches it when your stop gate passes.\n",
    }.get(host, "")
    return body.rstrip() + "\n" + note


def model_for(host, planning, st):
    """The host's concrete id for the group's route (ROADMAP §3.6; see _routes / bin/models)."""
    return _routes.resolve(host, "planning" if planning else "worker", st)["model"]


# ── helpers ───────────────────────────────────────────────────────────
def write(path, text, written):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(text)
    written.append(path)


def ours(path):
    try:
        text = open(path).read()
    except OSError:
        return False
    return MARK in text or LEGACY_MARK in text


def remove_legacy_opencode(base, removed):
    for rel in LEGACY_OPENCODE:
        p = os.path.join(base, rel)
        if os.path.isfile(p) and (ours(p) or p.endswith("agentic-agile.js")):
            os.remove(p)
            removed.append(p)
    for s in LEGACY_OPENCODE_SKILLS:
        d = os.path.join(base, "skills", s)
        if os.path.isdir(d) and ours(os.path.join(d, "SKILL.md")):
            shutil.rmtree(d)
            removed.append(d)


def link_dispatcher(written):
    bin_dir = os.path.join(os.path.expanduser("~"), ".local", "bin")
    os.makedirs(bin_dir, exist_ok=True)
    for name in ("aloop", "aladdin", "agentic"):     # aladdin: the product CLI; agentic: the pre-rename alias
        dst, src = os.path.join(bin_dir, name), os.path.join(HERE, name)
        if os.path.islink(dst) or not os.path.exists(dst):
            if os.path.islink(dst):
                os.remove(dst)
            os.symlink(src, dst)
            written.append(dst + " -> " + src)
        else:
            print("  WARN: %s exists and is not our link; left untouched" % dst)
    if bin_dir not in os.environ.get("PATH", "").split(os.pathsep):
        print("  NOTE: %s is not on your PATH — add it (export PATH=\"$HOME/.local/bin:$PATH\")" % bin_dir)


def toml_str(s):
    if "'''" not in s:
        return "'''\n" + s + "'''"
    return json.dumps(s)                           # TOML basic strings share JSON escapes


# ── codex ─────────────────────────────────────────────────────────────
def codex_dir(opts):
    return os.path.join(os.path.expanduser("~"), ".codex") if opts.get("global") else os.path.join(opts["project"], ".codex")


def install_codex(opts, st):
    written, base = [], codex_dir(opts)
    for name, desc, body in agents():
        planning = name in PLANNING
        lines = ["# " + MARK, "name = %s" % json.dumps(name, ensure_ascii=False), "description = %s" % json.dumps(desc, ensure_ascii=False)]
        m = model_for("codex", planning, st)
        if m:
            lines.append("model = %s" % json.dumps(m))
        lines.append("model_reasoning_effort = %s" % json.dumps(st["EFFORT_%s_CODEX" % ("PLANNING" if planning else "WORKER")]))
        lines.append("developer_instructions = " + toml_str(host_body(body, "codex")))
        write(os.path.join(base, "agents", name + ".toml"), "\n".join(lines) + "\n", written)
    link_dispatcher(written)
    return written, [
        "codex plugin marketplace add %s   # or: adeelahmad/agentic-agile" % os.path.dirname(ROOT),
        "codex plugin add aloop@aloop-marketplace",
        "then in Codex: /hooks  → trust the aloop hooks (Codex runs only trusted hooks)",
    ]


# ── opencode ──────────────────────────────────────────────────────────
def opencode_dir(opts):
    if opts.get("global"):
        return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config"), "opencode")
    return os.path.join(opts["project"], ".opencode")


def install_opencode(opts, st):
    written, base = [], opencode_dir(opts)
    for name, desc, body in agents():
        planning = name in PLANNING
        fm = ["---", "description: %s" % json.dumps(desc, ensure_ascii=False), "mode: subagent"]
        m = model_for("opencode", planning, st)
        if m:
            fm.append("model: %s" % m)
        fm += ["---", "<!-- %s -->" % MARK, ""]
        write(os.path.join(base, "agents", name + ".md"), "\n".join(fm) + host_body(body, "opencode"), written)
    for skill, new_name in HOST_SKILLS:
        if not os.path.isfile(os.path.join(ROOT, "skills", skill, "SKILL.md")):
            continue                                  # a skill another track has not shipped yet
        fm, body = split_frontmatter(open(os.path.join(ROOT, "skills", skill, "SKILL.md")).read())
        desc = re.sub(r"\s+", " ", fm.get("description", "")).strip(" >-")[:1024]
        text = "---\nname: %s\ndescription: %s\n---\n<!-- %s -->\n%s" % (new_name, json.dumps(desc, ensure_ascii=False), MARK, host_body(body, "opencode"))
        write(os.path.join(base, "skills", new_name, "SKILL.md"), text, written)
        ref = os.path.join(ROOT, "skills", skill, "reference.md")   # the playbook's on-demand sections
        if os.path.isfile(ref):
            write(os.path.join(base, "skills", new_name, "reference.md"),
                  "<!-- %s -->\n%s" % (MARK, host_body(open(ref).read(), "opencode")), written)
    write(os.path.join(base, "commands", "aloop-init.md"),
          "---\ndescription: Set up aloop for this project (limits, models, .gitignore, commit author), then start sprint planning\n---\n"
          "<!-- %s -->\nLoad the `aloop-init` skill with the skill tool and follow it exactly. $ARGUMENTS\n" % MARK, written)
    js = open(os.path.join(ROOT, "hosts", "opencode", "aloop.js")).read().replace("__AGENTIC_ROOT__", ROOT)
    write(os.path.join(base, "plugins", "aloop.js"), js, written)
    removed = []
    remove_legacy_opencode(base, removed)
    for r in removed:
        print("  removed pre-rename " + r)
    link_dispatcher(written)
    return written, ["restart opencode in the project — the plugin, agents, skills and /aloop-init load at startup"]


# ── dsh (DeepSeek Harness) ────────────────────────────────────────────
DSH_PROVIDER = "deepseek-official"
DSH_BUNDLES = ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-headless"]


def dsh_home():
    return os.environ.get("DSH_HOME") or os.path.join(os.path.expanduser("~"), ".dsh")


def dsh_profile():
    return os.path.join(dsh_home(), "profiles", "aloop")


def dsh_skills_dir(opts):
    return os.path.join(dsh_home(), "skills") if opts.get("global") else os.path.join(opts["project"], ".dsh", "skills")


def yq(v):
    """A YAML scalar: a JSON string is valid YAML (double-quoted, JSON escapes)."""
    return json.dumps(v, ensure_ascii=False)


def dsh_agent_options(model):
    """agentOptions for a delegation tool; an empty model is the session's default model."""
    if not model:
        return None
    provider, slash, mid = model.partition("/")         # a provider id has no "/"; a model id may
    return {"provider": provider, "model": mid} if slash else {"provider": DSH_PROVIDER, "model": model}


OWNER = "# aloop-project: "


def dsh_root(path):
    """A project as the profile records it: its main tree (a linked worktree or a subdirectory is its project)."""
    return os.path.realpath(_paths.project(os.path.realpath(path)))


def dsh_owner(opts):
    """Whom the one global profile serves: the project it was rendered for, or (global)."""
    if "owner" in opts:
        return opts["owner"]         # a re-render keeps what the profile records ("" = unrecorded)
    return "(global)" if opts.get("global") else dsh_root(opts["project"])


def dsh_profile_owner():
    """The owner recorded in the installed profile; None when it records none (an older install)."""
    try:
        with open(os.path.join(dsh_profile(), "cordis.patch.yml")) as f:
            for ln in f:
                if ln.startswith(OWNER):
                    return ln[len(OWNER):].strip()
                if not ln.startswith("#"):
                    break
    except OSError:
        pass
    return None


def dsh_serves(project):
    """The profile is this project's to re-render or remove: rendered for it, for every project, or unrecorded."""
    return dsh_profile_owner() in (None, "(global)", dsh_root(project))


def dsh_patch(st, owner):
    """The aloop profile's cordis.patch.yml: patches on top of dsh's base + headless bundles."""
    roles = agents()
    work = ["aloop-" + n for n, _, _ in roles if n not in PLANNING]
    plan = ["aloop-" + n for n, _, _ in roles if n in PLANNING]
    models = {"subagent": model_for("dsh", False, st), "subagent_planning": model_for("dsh", True, st)}
    supervisor = _routes.table()["hosts"]["dsh"]["strong"]

    def tool_config(tool, allowed):
        c = "{provider: spawn, toolName: %s, allowedAgentPresets: [%s]" % (tool, ", ".join(allowed))
        ao = dsh_agent_options(models[tool])
        if ao:
            c += ", agentOptions: {provider: %s, model: %s}" % (yq(ao["provider"]), yq(ao["model"]))
        return c + "}"

    out = ["# " + MARK] + ([OWNER + owner] if owner else []) + [
           "# The aloop profile for DeepSeek Harness: `dsh --profile aloop`. Roles are agent presets",
           "# aloop-<role>; `subagent` dispatches the execution roles, `subagent_planning` the planning",
           "# roles; hosts/dsh/aloop.mjs runs the gates. Supervisor model: $ALOOP_DSH_MODEL.",
           "- id: tool-subagent-fork          # a fork child cannot take a role",
           "  disabled: true",
           "- id: tool-workflow               # workflow children carry no role",
           "  disabled: true",
           "- id: session-log-deepseek        # no session-log upload with each request",
           "  disabled: true",
           "- id: agent-default-model",
           "  config:",
           "    provider: %s" % DSH_PROVIDER,
           "    model: !!js process.env.ALOOP_DSH_MODEL || %s" % yq(supervisor),
           "- id: tool-subagent",
           "  config: %s" % tool_config("subagent", work),
           "- insert:",
           "    - id: tool-subagent-planning",
           "      name: '@deepseek-ai/dsh-tool-subagent'",
           "      config: %s" % tool_config("subagent_planning", plan),
           "    - id: aloop",
           "      name: %s" % yq(os.path.join(ROOT, "hosts", "dsh", "aloop.mjs")),
           "      config: {root: %s, project: %s, maxStopBlocks: 3, models: {subagent: %s, subagent_planning: %s}}" % (
               yq(ROOT), yq(owner or ""), yq(models["subagent"]), yq(models["subagent_planning"])),
           "    - id: agent-preset-registry",
           "      name: '@deepseek-ai/dsh-agent-preset-registry'",
           "      config: {default: aloop-supervisor}",
           "    - id: preset-aloop-supervisor",
           "      name: '@deepseek-ai/dsh-agent-preset'",
           "      config: {id: aloop-supervisor, name: aloop supervisor, description: %s, plugins: []}" % yq(
               "Drives the aloop loop and dispatches the aloop roles.")]
    for name, desc, body in roles:
        prefix = "You are aloop's `%s` role.\n\n%s" % (name, host_body(body, "dsh"))
        if "{{" in prefix:          # dsh-persona interpolates {{var}} strictly: an unknown var fails the role
            raise ValueError("agents/%s.md contains '{{', which dsh's persona prefix would interpolate" % name)
        out += ["    - id: preset-aloop-%s" % name,
                "      name: '@deepseek-ai/dsh-agent-preset'",
                "      config:",
                "        id: aloop-%s" % name,
                "        name: %s" % name,
                "        description: %s" % yq(desc),
                "        plugins:",
                "          - id: persona",
                "            name: '@deepseek-ai/dsh-persona'",
                "            config: {prefix: %s}" % yq(prefix)]
    return "\n".join(out) + "\n"


def install_dsh(opts, st):
    written, prof = [], dsh_profile()
    write(os.path.join(prof, "package.json"), json.dumps(
        {"name": "dsh-profile-aloop", "private": True, "description": MARK, "dependencies": {},
         "dsh": {"profile": {"bundles": DSH_BUNDLES}}}, indent=2) + "\n", written)
    write(os.path.join(prof, "cordis.patch.yml"), dsh_patch(st, dsh_owner(opts)), written)
    base = dsh_skills_dir(opts)
    for skill, new_name in HOST_SKILLS:
        if opts.get("skills") is False:
            break
        if not os.path.isfile(os.path.join(ROOT, "skills", skill, "SKILL.md")):
            continue                                  # a skill another track has not shipped yet
        fm, body = split_frontmatter(open(os.path.join(ROOT, "skills", skill, "SKILL.md")).read())
        desc = re.sub(r"\s+", " ", fm.get("description", "")).strip(" >-")[:1024]
        head = "---\nname: %s\ndescription: %s\n" % (new_name, json.dumps(desc, ensure_ascii=False))
        if fm.get("disable-model-invocation") == "true":
            head += "disable-model-invocation: true\n"
        write(os.path.join(base, new_name, "SKILL.md"), "%s---\n<!-- %s -->\n%s" % (head, MARK, host_body(body, "dsh")), written)
        ref = os.path.join(ROOT, "skills", skill, "reference.md")
        if os.path.isfile(ref):
            write(os.path.join(base, new_name, "reference.md"),
                  "<!-- %s -->\n%s" % (MARK, host_body(open(ref).read(), "dsh")), written)
    link_dispatcher(written)
    return written, [
        "npm install -g @deepseek-ai/dsh@0.2.1-rc.2   # if dsh is not installed",
        "export DEEPSEEK_API_KEY=sk-...                # or put it in $DSH_HOME/.env",
        "dsh --profile aloop \"Use the aloop skill. Intent: <one line>\"   (supervisor model: ALOOP_DSH_MODEL)",
    ]


INSTALLERS = {"codex": install_codex, "opencode": install_opencode, "dsh": install_dsh}


def uninstall(host, opts):
    removed = []
    if host == "codex":
        d = os.path.join(codex_dir(opts), "agents")
        for n, _, _ in agents():
            p = os.path.join(d, n + ".toml")
            if os.path.isfile(p) and ours(p):
                os.remove(p)
                removed.append(p)
    elif host == "opencode":
        b = opencode_dir(opts)
        paths = [os.path.join(b, "agents", n + ".md") for n, _, _ in agents()]
        paths += [os.path.join(b, "commands", "aloop-init.md"), os.path.join(b, "plugins", "aloop.js")]
        for p in paths:
            if os.path.isfile(p) and (ours(p) or p.endswith("aloop.js")):
                os.remove(p)
                removed.append(p)
        for _, s in HOST_SKILLS:
            d = os.path.join(b, "skills", s)
            if os.path.isdir(d):
                shutil.rmtree(d)
                removed.append(d)
        remove_legacy_opencode(b, removed)
    elif host == "dsh":
        prof = dsh_profile()
        if ours(os.path.join(prof, "cordis.patch.yml")):
            if opts.get("global") or dsh_serves(opts["project"]):
                shutil.rmtree(prof)
                removed.append(prof)
            else:
                print("  kept %s: it serves %s" % (prof, dsh_profile_owner()))
        for _, s in HOST_SKILLS:
            d = os.path.join(dsh_skills_dir(opts), s)
            if os.path.isdir(d) and ours(os.path.join(d, "SKILL.md")):
                shutil.rmtree(d)
                removed.append(d)
    for r in removed:
        print("  removed " + r)
    return 0


def installed(project):
    found = []
    for host, p in (("codex", os.path.join(project, ".codex", "agents", "planner.toml")),
                    ("codex", os.path.join(os.path.expanduser("~"), ".codex", "agents", "planner.toml")),
                    ("opencode", os.path.join(project, ".opencode", "agents", "planner.md")),
                    ("dsh", os.path.join(dsh_profile(), "cordis.patch.yml"))):
        if os.path.isfile(p) and ours(p) and (host != "dsh" or dsh_serves(project)):
            found.append((host, p))   # the dsh profile is global: only the project it serves re-renders it
    return found


def dsh_elsewhere(project):
    """The owner of an installed dsh profile that serves another project, else None."""
    p = os.path.join(dsh_profile(), "cordis.patch.yml")
    return dsh_profile_owner() if os.path.isfile(p) and ours(p) and not dsh_serves(project) else None


def rerender(project):
    """Called by aloop-init --apply: refresh every installed host with the new settings."""
    st = _paths.settings(project)
    for host, p in installed(project):
        opts = {"project": project, "global": not p.startswith(project)}
        if host == "dsh":           # one global profile; re-render the skills only where they already are
            has = lambda o: ours(os.path.join(dsh_skills_dir(o), "aloop", "SKILL.md"))  # noqa: E731
            opts["global"] = not has({"project": project})
            opts["skills"] = has(opts)
            # an older profile records no owner: only a project with its own skills (it ran
            # `install dsh --project`) claims it; any other re-render leaves it unrecorded
            opts["owner"] = dsh_profile_owner() or (dsh_root(project) if has({"project": project}) else "")
        INSTALLERS[host](opts, st)
        print("  re-rendered %s agents (%s)" % (host, os.path.dirname(p)))
    other = dsh_elsewhere(project)
    if other:
        print("  kept the dsh profile: it serves %s. Run `aloop install dsh --project %s` to switch it to this project." % (other, project))


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    host = argv[0]
    opts = {"project": _paths.project(os.getcwd())}
    it = iter(argv[1:])
    for a in it:
        if a == "--global":
            opts["global"] = True
        elif a == "--project":
            opts["project"] = os.path.abspath(next(it, "."))
        elif a == "--uninstall":
            opts["uninstall"] = True
        else:
            print("aloop-install: unknown option %s" % a, file=sys.stderr)
            return 64
    if host == "status":
        for h, p in installed(opts["project"]):
            print("%-9s %s" % (h, os.path.dirname(p)))
        other = dsh_elsewhere(opts["project"])
        if other:
            print("%-9s %s (serves %s, not this project)" % ("dsh", dsh_profile(), other))
        return 0
    if host == "claude":
        print("Claude Code:\n  /plugin marketplace add adeelahmad/agentic-agile\n  /plugin install aloop@aloop-marketplace")
        return 0
    host = {"deepseek": "dsh"}.get(host, host)
    if host not in INSTALLERS:
        print("aloop-install: host must be codex, opencode, dsh, claude or status", file=sys.stderr)
        return 64
    if opts.get("uninstall"):
        return uninstall(host, opts)
    st = _paths.settings(opts["project"])
    written, nxt = INSTALLERS[host](opts, st)
    print("installed aloop for %s:" % host)
    for w in written:
        print("  " + w)
    print("next:")
    for n in nxt:
        print("  " + n)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
