#!/usr/bin/env python3
"""intent — the internal Intent Contract (ROADMAP §4.1). The user never fills it in:
`intake` writes it, the harness issues its identity and checks it.

Usage:
  intent new --source prompt|file|issue|image|mixed [--raw "the request"] [--raw-ref PATH]
  intent new --source mission --goal GOAL_ID --gap GAP_ID [--raw "the gap"] [--raw-ref PATH]
        issue a canonical intent_id (never model text) and write the contract skeleton to
        docs/agents/intents/<intent_id>.json (prints the path); emits intent.received. A
        mission intent (ROADMAP §4.12) names its goal and gap, so lineage reaches the mission;
        it exists only while the goal passes `mission goal check` and lists that gap
  intent check FILE [--mode reviewed|autonomous]
        validate the contract: required fields, enums, ≥1 success and ≥1 failure scenario,
        and the clarification policy; a mission intent also passes its goal's gate, matches its
        intent.received, and is checked in the goal's autonomy. Exit 0 ok (emits
        intent.normalized) · 2 invalid · 3 needs the human (an `ask` question is unanswered —
        in BOTH modes)
  intent summary FILE
        the approval summary lines: defaults picked, assumptions recorded, spikes created
  intent release FILE   (stdin: the host's hook payload; run by gate-intake on `check` exit 3)
        a host's SubagentStop on a contract whose only problem is its unanswered `ask` questions is
        released at once as NEEDS-HUMAN, NOT verified (ROADMAP §4.9, as a STUCK release): the questions
        go to <run-data>/state/needs-human/<intent_id>.json and a gate.failed (released=needs-human) is
        emitted. Exit 0 released · 1 not a host's stop (a self-check, a direct run: the gate blocks)
  intent hook           (stdin: PostToolUse) the supervisor's next tool result carries each release
        once, while its questions are still open and its contract is the newest (Claude Code, Codex; the
        dsh and OpenCode plugins run it at the release itself, so a record is told once on any host)
  intent open           the unanswered `ask` questions of the newest contract (the one gate-intake judges),
        one quoted line each; gate-dispatch refuses a planner on them. Exit 3 when any are open · 0 when
        none are, or there is no contract (only the ask class: a mission goal's own questions are not these)

Clarification policy — every open question carries a class:
  assume   safe and reversible        → the planner assumes; `assumption` recorded
  default  material but recoverable   → a `default` is picked and surfaced for approval
  ask      irreversible / security-sensitive / changes intent → the human answers (`answer`)
  spike    unknown but testable       → a spike task is created (`spike_task`)
"""
import hashlib
import json
import os
import re
import secrets
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _events  # noqa: E402
import _paths  # noqa: E402

SOURCES = ("prompt", "file", "issue", "image", "mixed", "mission")
GOAL_ID = re.compile(r"^gol_[0-9a-f]{20}$")   # a mission goal (plugin/mission/goal.py)
CLASSES = {"assume": "assumption", "default": "default", "ask": "answer", "spike": "spike_task"}
ID = re.compile(r"^int_[0-9a-f]{12}[0-9a-f]{8}$")
TEXT = ("actor", "want", "why", "done_looks_like")
LISTS = ("constraints", "success_scenarios", "failure_scenarios", "connections", "open_questions", "assumptions")


def new_id():
    """Time-ordered, collision-safe, issued here — never by a model (invariant §7)."""
    return "int_%012x%s" % (int(time.time() * 1000), secrets.token_hex(4))


def intents_dir(cwd):
    return os.path.join(_paths.docs(cwd), "intents")


def mission_gate(cwd, goal, gap, mode=None):
    """A mission intent's goal gate (ROADMAP §4.12): the goal passes `mission goal check` and lists the
    gap, and its intents are checked in the goal's autonomy. Exit 0 · 2 · 3, reported."""
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "mission"))
    import goal as G
    rc, blocks, asks, facts = G.check(cwd, goal)
    if rc:
        G.report(blocks, asks)
        return rc
    g, _ = G.M.load(G.M.path_of(cwd, "goal", goal))
    if gap not in [x.get("gap_id") for x in g["gaps"]]:
        print("BLOCK[intent]: %s is not a gap of goal %s" % (gap, goal), file=sys.stderr)
        return 2
    if mode and mode != facts["autonomy"]:
        print("BLOCK[intent]: goal %s is %s: its intents are checked in that mode, not %s" % (goal, facts["autonomy"], mode),
              file=sys.stderr)
        return 2
    return 0


def cmd_new(cwd, source, raw="", raw_ref="", goal="", gap=""):
    if source not in SOURCES:
        print("intent new: --source must be one of %s" % ", ".join(SOURCES), file=sys.stderr)
        return 64
    if (source == "mission") != bool(goal) or (goal and not GOAL_ID.match(goal)) or bool(goal) != bool(gap):
        print("intent new: --goal gol_… --gap GAP_ID go with --source mission, and only with it (a mission intent "
              "names its goal and the gap it closes)", file=sys.stderr)
        return 64
    rc = mission_gate(cwd, goal, gap) if goal else 0
    if rc:
        return rc
    iid = new_id()
    doc = {"intent_id": iid, "source": source, "actor": "", "want": "", "why": "", "constraints": [],
           "success_scenarios": [], "failure_scenarios": [], "connections": [], "done_looks_like": "",
           "open_questions": [], "assumptions": [],
           "provenance": {"received_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "raw_ref": raw_ref,
                          "raw_sha256": hashlib.sha256(raw.encode()).hexdigest() if raw else ""}}
    if goal:
        doc["provenance"].update(goal_id=goal, gap_id=gap)
    os.makedirs(intents_dir(cwd), exist_ok=True)
    path = os.path.join(intents_dir(cwd), iid + ".json")
    with open(path, "w") as f:
        json.dump(doc, f, indent=1)
    derived = None
    for e in _events.read(cwd) if goal else ():   # the goal this intent serves: intent.received is caused by it
        if e.get("event") == "goal.derived" and (e.get("data") or {}).get("goal_id") == goal:
            derived = e
    _events.emit(cwd, "intent.received", role="intake", refs={"intent": path, "raw": raw_ref}, intent_id=iid, source=source,
                 caused_by=derived and derived.get("event_id"), **({"goal_id": goal, "gap_id": gap} if goal else {}))
    print(path)
    return 0


def problems(doc, path):
    p = []
    iid = doc.get("intent_id", "")
    if not ID.match(iid or ""):
        p.append("intent_id %r was not issued by `intent new`" % iid)
    elif os.path.basename(path) != iid + ".json":
        p.append("intent_id %s does not match the file name (ids are frozen once issued)" % iid)
    if doc.get("source") not in SOURCES:
        p.append("source must be one of %s" % ", ".join(SOURCES))
    for k in TEXT:
        if not isinstance(doc.get(k), str) or not doc[k].strip():
            p.append("%s is empty" % k)
    for k in LISTS:
        if not isinstance(doc.get(k), list):
            p.append("%s must be a list" % k)
    for k in ("success_scenarios", "failure_scenarios"):
        if isinstance(doc.get(k), list) and not [s for s in doc[k] if str(s).strip()]:
            p.append("%s needs at least one scenario" % k)
    prov = doc.get("provenance") or {}
    if not prov.get("received_at"):
        p.append("provenance.received_at missing")
    if doc.get("source") == "mission" and not GOAL_ID.match(str(prov.get("goal_id", ""))):
        p.append("a mission intent names its goal (provenance.goal_id gol_…, from `intent new --goal`)")
    for i, q in enumerate(doc.get("open_questions") or []):
        if not isinstance(q, dict) or not str(q.get("question", "")).strip():
            p.append("open_questions[%d] needs a question" % i)
            continue
        c = q.get("class")
        if c not in CLASSES:
            p.append("open_questions[%d] class must be one of %s" % (i, ", ".join(CLASSES)))
        elif c != "ask" and not str(q.get(CLASSES[c], "")).strip():
            p.append("open_questions[%d] (%s) must record its %s" % (i, c, CLASSES[c]))
    return p


def unanswered(doc):
    return [q["question"] for q in doc.get("open_questions") or []
            if isinstance(q, dict) and q.get("class") == "ask" and not str(q.get("answer", "")).strip()]


def load(path):
    try:
        with open(path) as f:
            return json.load(f), None
    except (OSError, ValueError) as e:
        return None, str(e)


def verdict(cwd, path, mode="reviewed"):
    """`intent check` without its event: (exit 0 · 2 · 3, the contract), the reasons on stderr. `mission
    tick` and `due` ask it in process, so a decision that records nothing emits no `intent.normalized`."""
    doc, err = load(path)
    if doc is None:
        print("BLOCK[intent]: cannot read %s: %s" % (path, err), file=sys.stderr)
        return 2, None
    bad = problems(doc, path)
    for b in bad:
        print("BLOCK[intent]: %s" % b, file=sys.stderr)
    if bad:
        return 2, doc
    if doc.get("source") == "mission":
        prov = doc["provenance"]
        rec = [e for e in _events.read(cwd) if e.get("event") == "intent.received"
               and (e.get("data") or {}).get("intent_id") == doc["intent_id"]]
        d = (rec[0].get("data") or {}) if rec else {}
        if d.get("source") != "mission" or (d.get("goal_id"), d.get("gap_id")) != (prov["goal_id"], prov.get("gap_id")):
            print("BLOCK[intent]: provenance (goal %s, gap %s) is not what its intent.received recorded (goal %s, gap %s)"
                  % (prov["goal_id"], prov.get("gap_id"), d.get("goal_id"), d.get("gap_id")), file=sys.stderr)
            return 2, doc
        rc = mission_gate(cwd, prov["goal_id"], prov.get("gap_id"), mode)
        if rc:
            return rc, doc
    asks = unanswered(doc)
    if asks:
        for q in asks:
            print("ASK[intent]: %s" % one_line(q), file=sys.stderr)
        print("intent: %d question(s) need the human (irreversible, security-sensitive or intent-changing) — "
              "%s mode does not proceed past them." % (len(asks), mode), file=sys.stderr)
        return 3, doc
    return 0, doc


def cmd_check(cwd, path, mode="reviewed"):
    rc, doc = verdict(cwd, path, mode)
    if rc:
        return rc
    _events.emit(cwd, "intent.normalized", role="intake", refs={"intent": path}, intent_id=doc["intent_id"], mode=mode)
    print("[intent] %s ok (%s mode)" % (doc["intent_id"], mode), file=sys.stderr)
    return 0


def payload_of(raw):
    try:
        p = json.loads(raw or "{}")
    except ValueError:
        return {}
    return p if isinstance(p, dict) else {}


def one_line(q, cap=300):
    """A question as one line: model-written text never starts a line of its own in a gate's output."""
    q = " ".join(str(q).split())
    return q if len(q) <= cap else q[:cap - 1] + "…"


def contract_of(cwd, path, iid):
    """True when `path` is the project's own contract file for `iid` (docs/agents/intents/<iid>.json)."""
    try:
        return os.path.samefile(path, os.path.join(intents_dir(cwd), iid + ".json"))
    except OSError:
        return False


def newest(cwd):
    """The contract gate-intake judges: the newest intents/int_*.json."""
    d = intents_dir(cwd)
    names = [n for n in os.listdir(d) if ID.match(n[:-5]) and n.endswith(".json")] if os.path.isdir(d) else []
    return max((os.path.join(d, n) for n in names), key=lambda f: (os.path.getmtime(f), f), default="")


def quoted(asks):
    """Each question as one quoted line: the intake's words, never a line in a gate's voice."""
    return "\n".join("- " + json.dumps(one_line(q), ensure_ascii=False) for q in asks)


def notice(rec, asks):
    """What the supervisor is told about one NEEDS-HUMAN release, on every host (dsh and OpenCode run `intent hook`
    too). Each question is one quoted line: the intake's words, never a line in the gate's voice."""
    return ("[aloop gate] %s %s: NEEDS-HUMAN — released UNVERIFIED (not a pass): its Intent Contract %s has questions only "
            "the human can answer (the intake's words, quoted):\n%s\nAsk the human each one, then re-dispatch %s with the "
            "answers in a ### Feedback block (it records each answer). Do not plan from it until gate-intake passes."
            % (rec.get("role", "intake"), one_line(rec.get("agent_id") or "?", 80), rec.get("contract", "?"),
               quoted(asks), rec.get("role", "intake")))


def cmd_open(cwd):
    """The newest contract's unanswered asks, the planner's gate (gate-dispatch): a NEEDS-HUMAN release passes the
    intake's stop unverified, and the notice can reach the supervisor after it dispatched the planner."""
    path = newest(cwd)
    doc, _ = load(path) if path else (None, None)
    asks = unanswered(doc) if isinstance(doc, dict) else []   # no contract (an older project), or none open
    if asks:
        print("the newest Intent Contract %s has %d question(s) only the human can answer (the intake's words, quoted):\n%s"
              % (path, len(asks), quoted(asks)))
    return 3 if asks else 0


def cmd_release(cwd, path, raw):
    p = payload_of(raw)
    if p.get("hook_event_name") != "SubagentStop" or _paths.env("SELFCHECK") == "1":
        return 1
    role = re.sub(r"^aloop[:-]", "", str(p.get("agent_type") or ""))
    if role and role != "intake":
        return 1                                     # only the intake's stop waits on the human
    doc, _ = load(path)
    if not isinstance(doc, dict) or problems(doc, path) or not contract_of(cwd, path, doc["intent_id"]) or not [
            e for e in _events.read(cwd) if e.get("event") == "intent.received"
            and (e.get("data") or {}).get("intent_id") == doc["intent_id"]]:
        return 1                                     # a contract `intent new` issued, in its place: never one a role made up
    asks = unanswered(doc)
    if not asks:
        return 1                                     # exit 3 from a mission goal's own questions: not this release
    agent = str(p.get("agent_id") or "")
    rec = {"intent_id": doc["intent_id"], "contract": os.path.realpath(path), "agent_id": agent, "role": "intake",
           "gate": "gate-intake", "questions": asks, "session_id": str(p.get("session_id") or ""),
           "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    out = os.path.join(_paths.home(cwd, "state/needs-human"), doc["intent_id"] + ".json")
    with open(out + ".tmp", "w") as f:
        json.dump(rec, f)
    os.replace(out + ".tmp", out)                    # whole, for a hook reading it at the same time
    _events.emit(cwd, "gate.failed", agent_id=agent, role="intake", refs={"intent": rec["contract"]}, gate="gate-intake",
                 exit=0, released="needs-human", intent_id=doc["intent_id"])
    return 0


def cmd_hook(raw):
    p = payload_of(raw)
    cwd = p.get("cwd") or os.getcwd()
    if os.environ.get("SKIP_HOOKS") == "1" or p.get("agent_id") or not os.path.isdir(_paths.docs(cwd)):
        return 0                                     # a role's own call: only the supervisor is told
    d = _paths.home(cwd, "state/needs-human", make=False)
    out, judged, session = [], newest(cwd), str(p.get("session_id") or "")
    for name in sorted(os.listdir(d)) if os.path.isdir(d) else []:
        f = os.path.join(d, name)
        if not name.endswith(".json"):
            continue
        rec, _ = load(f)
        rec = rec if isinstance(rec, dict) else {}
        if rec.get("session_id") and session and rec["session_id"] != session:
            continue                                 # another session's release: its supervisor is told, not this one
        try:
            os.replace(f, f + ".reported")           # claimed: a parallel hook that got there first tells it
        except OSError:
            continue
        iid, path = str(rec.get("intent_id") or ""), str(rec.get("contract") or "")
        if not ID.match(iid) or not contract_of(cwd, path, iid) or not judged or not os.path.samefile(path, judged):
            continue                                 # not a contract in its place, or a newer one superseded it
        doc, _ = load(path)
        asks = unanswered(doc) if isinstance(doc, dict) else []   # answered since (a re-dispatch): nothing to tell
        if asks:
            out.append(notice(rec, asks))
    if out:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": "\n\n".join(out)}}))
    return 0


def cmd_summary(path):
    doc, err = load(path)
    if doc is None:
        print("intent summary: %s" % err, file=sys.stderr)
        return 2
    out = []
    for q in doc.get("open_questions") or []:
        c = q.get("class")
        if c == "default":
            out.append("- DEFAULT picked: %s → %s" % (q["question"], q.get("default")))
        elif c == "assume":
            out.append("- ASSUMED: %s → %s" % (q["question"], q.get("assumption")))
        elif c == "spike":
            out.append("- SPIKE: %s → %s" % (q["question"], q.get("spike_task")))
        elif c == "ask":
            out.append("- ASKED: %s → %s" % (q["question"], q.get("answer") or "UNANSWERED"))
    out += ["- assumption: %s" % a for a in doc.get("assumptions") or []]
    print("\n".join(out) if out else "- no assumptions, defaults or spikes")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    opts, pos, k = {}, [], None
    for a in argv[1:]:
        if k:
            opts[k], k = a, None
        elif a.startswith("--"):
            k = a[2:].replace("-", "_")
        else:
            pos.append(a)
    cwd = os.getcwd()
    if argv[0] == "new":
        return cmd_new(cwd, opts.get("source", ""), opts.get("raw", ""), opts.get("raw_ref", ""), opts.get("goal", ""),
                       opts.get("gap", ""))
    if argv[0] == "check" and pos:
        return cmd_check(cwd, pos[0], opts.get("mode", "reviewed"))
    if argv[0] == "open":
        return cmd_open(cwd)
    if argv[0] == "summary" and pos:
        return cmd_summary(pos[0])
    if argv[0] == "release" and pos:
        return cmd_release(cwd, pos[0], "" if sys.stdin.isatty() else sys.stdin.read())
    if argv[0] == "hook":
        try:
            return cmd_hook("" if sys.stdin.isatty() else sys.stdin.read())
        except Exception:
            return 0                                 # never fails a tool call
    print("intent: unknown or incomplete command (see intent --help)", file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
