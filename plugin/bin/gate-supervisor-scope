#!/usr/bin/env bash
# gate-supervisor-scope — PreToolUse(Write|Edit|MultiEdit|NotebookEdit).
#
# Enforces two playbook invariants on the MAIN agent (the supervisor):
#   1. It never writes production source — code is written by a dispatched worker in
#      its own worktree (RED → SCAFFOLD → GREEN).
#   2. It never HAND-AUTHORS the planning artifacts — it DISPATCHES the activity:
#      stories/tasks/validate/plan/sprint-plan ← planner · intake.md ← intake ·
#      standards.md ← standards. (The supervisor kept hand-writing these despite the
#      SKILL guardrail; this is the deterministic backstop.)
# The supervisor owns only plan-ready.md, init.md, execution.log, memory.md.
#
# DISTINGUISHING supervisor from a dispatched sub-agent (per Claude Code hooks docs):
#   PreToolUse carries `agent_type` for a sub-agent's tool call, and NOT for the main
#   session. So a present agent_type ⇒ a dispatched agent doing its job ⇒ allow; an
#   absent agent_type ⇒ the supervisor ⇒ bound by the rules below.
#
# WHY a self-arming lock (not "a sprint dir exists"):
#   This plugin's hooks fire for EVERY session on the machine. Gating on the mere
#   presence of docs/agents/sprintN/ would permanently block source edits in any repo
#   that ever ran a sprint. Instead, writing a planning artifact arms a lock stamped with
#   the session id + a fresh mtime. The SOURCE block binds when the lock is THIS session's
#   OR was refreshed recently (within AGENTIC_SPRINT_LOCK_TTL, default 4h) — the recency
#   arm covers a RESUMED sprint session that acts before re-arming. A lock that is BOTH a
#   different session AND stale (no recent activity) is inert, so an old/abandoned sprint
#   never blocks unrelated future work. (The planner-artifact block is path-based and does
#   not depend on the lock at all.)
#
# Exit: 0 allow · 2 block (stderr handed back to the model). Honors SKIP_HOOKS=1.
set -uo pipefail
GATE_NAME=supervisor-scope

[ "${SKIP_HOOKS:-}" = "1" ] && exit 0

payload="$(cat 2>/dev/null || true)"
field() { printf '%s' "$payload" | sed -nE "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"([^\"]+)\".*/\1/p" | head -1; }
tool="$(field tool_name)"
file="$(field file_path)"
[ -n "$file" ] || file="$(field filePath)"
session="$(field session_id)"

# Codex edits files with apply_patch: tool_input is {"command": "<patch text>"}, the paths
# live in the patch headers. Check each path exactly as if it were a Write.
if [ "$tool" = "apply_patch" ] && command -v python3 >/dev/null 2>&1; then
  printf '%s' "$payload" | python3 -c '
import json, re, sys
p = json.load(sys.stdin)
patch = (p.get("tool_input") or {}).get("command") or ""
for a, b in re.findall(r"^\*\*\* (?:Add|Update|Delete) File: (.+)$|^\*\*\* Move to: (.+)$", patch, re.M):
    q = {k: v for k, v in p.items() if k in ("session_id", "agent_type", "agent_id", "cwd")}
    q["tool_name"] = "Write"; q["tool_input"] = {"file_path": (a or b).strip()}
    print(json.dumps(q))' | while IFS= read -r one; do
    printf '%s' "$one" | "$0" || exit 2
  done
  exit $?
fi

# Only guard file-mutating tools that carry a path.
case "$tool" in Write|Edit|MultiEdit|NotebookEdit) ;; *) exit 0 ;; esac
[ -n "$file" ] || exit 0

# No session id => fail OPEN (don't risk blocking a non-agentic session).
[ -n "$session" ] || exit 0

# Dispatched sub-agent (planner / intake / standards / red / scaffolder / green / …):
# agent_type is present ⇒ it is doing its designated job; its own SubagentStop gate
# constrains it. Never block a sub-agent here.
agent_type="$(field agent_type)"
# ...except the task contract and the supervisor's state: a worker that rewrites its contract
# (.agentic/state/tasks/<TASK_ID>.env, or the worktree copy) widens its own scope or budget.
if [ -n "$agent_type" ]; then
  case "$file" in .agentic/state/*|*/.agentic/state/*|.agentic/task.env|*/.agentic/task.env)
    echo "BLOCK[$GATE_NAME]: $file is the supervisor's task contract/state; a dispatched agent may not write it." >&2
    echo "  Your task contract is fixed at dispatch. If it is wrong, say so in your output.md report." >&2
    exit 2 ;;
  esac
  exit 0
fi

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
lock="$root/.agentic/state/sprint.lock"          # fixed path (bin/_paths.sh), git-ignored

# Fallback (only if a payload ever lacks agent_type): a worktree task.env naming a
# dispatched role still exempts that agent.
if [ -f "$root/.agentic/task.env" ] \
   && grep -qE '^[[:space:]]*AGENT_ROLE=("?)(red-worker|scaffolder|green-worker|planner|intake|standards|structural-reviewer|final-gate|archivist)\1' "$root/.agentic/task.env" 2>/dev/null; then
  exit 0
fi

# ── MAIN AGENT (the supervisor) from here on ───────────────────────────────
base="${file##*/}"

# (A) Planning artifacts are authored by a DISPATCHED activity, never hand-written by
# you. Path-based (fires even on the FIRST stories.md write, before any lock is armed).
case "$file" in docs/agents/*|*/docs/agents/*)
  case "$base" in stories.md|tasks.md|validate.md|plan.md|intake.md|standards.md)
    echo "BLOCK[$GATE_NAME]: dispatch the planning activity — do not hand-write this artifact:" >&2
    echo "    $file" >&2
    echo "  This is authored by a sub-agent you DISPATCH, not by you:" >&2
    echo "    stories/tasks/validate/plan/sprint-plan → the 'planner' agent" >&2
    echo "    intake.md → 'intake'  ·  standards.md → 'standards'" >&2
    echo "  Dispatch it (it writes the artifact); you review and approve the output. You own" >&2
    echo "  only plan-ready.md / init.md / execution.log / memory.md." >&2
    echo "  (Deliberate out-of-band edit outside the pipeline? Re-run with SKIP_HOOKS=1.)" >&2
    exit 2 ;;
  defaults.md|NEXT.md|stats.md)
    echo "BLOCK[$GATE_NAME]: $base is written by the harness, never by hand:" >&2
    echo "    defaults.md → \`aloop-init --apply …\` (the init skill, after the human confirms)" >&2
    echo "    NEXT.md / sprintN/stats.md → \`stats sprint-close\` (runs when FINAL-GATE passes)" >&2
    exit 2 ;;
  esac ;;
esac

# Classify the remaining target paths. Match relative AND absolute forms — do NOT
# prefix-strip against $root: on macOS `git rev-parse --show-toplevel` resolves /private
# symlinks and would not match the payload's /var path, silently disarming the guard.
case "$file" in
  docs/agents/*|*/docs/agents/*)                 is_docs=1; is_ctl=0 ;;
  .agentic/*|*/.agentic/*|.transcripts/*|*/.transcripts/*) is_docs=0; is_ctl=1 ;;
  # VCS hygiene the supervisor legitimately writes for the initial commit — never
  # application source, so allow without the SKIP_HOOKS dance.
  .gitignore|*/.gitignore|.gitattributes|*/.gitattributes) is_docs=0; is_ctl=1 ;;
  *)                                             is_docs=0; is_ctl=0 ;;
esac

# Supervisor-owned planning artifact (init.md / plan-ready.md / execution.log /
# memory.md): ARMS the lock for this session (a sprint is live here), allow.
if [ "$is_docs" = 1 ]; then
  mkdir -p "$(dirname "$lock")" 2>/dev/null && printf '%s\n' "$session" > "$lock" 2>/dev/null || true
  exit 0
fi
# Worktree control file the supervisor writes at dispatch: allow.
[ "$is_ctl" = 1 ] && exit 0

# Production source. A sprint is "live" if THIS session armed the lock, OR the lock was
# refreshed recently (within AGENTIC_SPRINT_LOCK_TTL, default 4h). The recency arm covers
# a RESUMED sprint session that reads existing plans and acts before it re-arms (e.g.
# hand-fixing code after a structural-review finding). A lock with no recent activity is
# inert, so an old/abandoned sprint never blocks unrelated future work.
# This repo has a sprint lock, so the event is ours to judge: from here a crash blocks.
# (Before this point the gate also sees every unrelated session on the machine; it stays
# fail-open there so a gate bug can never stall work outside a sprint.)
if [ -f "$lock" ]; then
  # shellcheck source=/dev/null
  . "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_failclosed.sh"
fi
lock_recent() {
  [ -f "$lock" ] || return 1
  local now m
  now="$(date +%s 2>/dev/null)" || return 1
  # GNU first: on Linux `stat -f` means "filesystem status" and prints a report instead of
  # failing, which used to crash this arm (and a crashed hook does not block).
  m="$(stat -c %Y "$lock" 2>/dev/null)" || m="$(stat -f %m "$lock" 2>/dev/null)" || return 1
  case "$m" in ''|*[!0-9]*) return 1 ;; esac
  [ $(( now - m )) -lt "${AGENTIC_SPRINT_LOCK_TTL:-14400}" ]
}
if [ -f "$lock" ] && { [ "$(head -1 "$lock" 2>/dev/null)" = "$session" ] || lock_recent; }; then
  echo "BLOCK[$GATE_NAME]: the supervisor may not write production source during a sprint:" >&2
  echo "    $file" >&2
  echo "  Code is written by a dispatched worker in its own worktree — you never edit source." >&2
  echo "  On a STRUCTURAL-REVIEW finding, RE-DISPATCH the implicated GREEN task with feedback" >&2
  echo "  (init.md); do NOT hand-fix the code yourself. For new work, dispatch red → scaffold" >&2
  echo "  → green. Ambiguous resume ('go on','continue') = re-dispatch the LAST activity." >&2
  echo "  (Deliberate out-of-band edit outside the pipeline? Re-run with SKIP_HOOKS=1.)" >&2
  exit 2
fi
exit 0
