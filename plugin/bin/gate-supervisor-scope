#!/usr/bin/env bash
# gate-supervisor-scope — PreToolUse(Write|Edit|MultiEdit|NotebookEdit|Bash|ScheduleWakeup).
#
# Enforces two playbook invariants on the MAIN agent (the supervisor):
#   1. It never writes production source — code is written by a dispatched worker in
#      its own worktree (RED → SCAFFOLD → GREEN).
#   2. It never HAND-AUTHORS the planning artifacts — it DISPATCHES the activity:
#      stories/tasks/validate/plan/sprint-plan ← planner · intake.md ← intake ·
#      standards.md ← standards. (The supervisor kept hand-writing these despite the
#      SKILL guardrail; this is the deterministic backstop.)
# The supervisor owns only plan-ready.md, init.md, execution.log, memory.md.
#
# DISTINGUISHING supervisor from a dispatched sub-agent (per Claude Code hooks docs):
#   PreToolUse carries `agent_type` for a sub-agent's tool call, and NOT for the main
#   session. So a present agent_type ⇒ a dispatched agent doing its job ⇒ allow; an
#   absent agent_type ⇒ the supervisor ⇒ bound by the rules below.
#
# WHY a self-arming lock (not "a sprint dir exists"):
#   This plugin's hooks fire for EVERY session on the machine. Gating on the mere
#   presence of docs/agents/sprintN/ would permanently block source edits in any repo
#   that ever ran a sprint. Instead, writing a planning artifact arms a lock stamped with
#   the session id + a fresh mtime. The SOURCE block binds when the lock is THIS session's
#   OR was refreshed recently (within AGENTIC_SPRINT_LOCK_TTL, default 4h) — the recency
#   arm covers a RESUMED sprint session that acts before re-arming. A lock that is BOTH a
#   different session AND stale (no recent activity) is inert, so an old/abandoned sprint
#   never blocks unrelated future work. (The planner-artifact block is path-based and does
#   not depend on the lock at all.)
#
# Exit: 0 allow · 2 block (stderr handed back to the model). Honors SKIP_HOOKS=1.
set -uo pipefail
GATE_NAME=supervisor-scope

[ "${SKIP_HOOKS:-}" = "1" ] && exit 0

payload="$(cat 2>/dev/null || true)"
# The payload, read as JSON: the host's fields from the top level, the path and the command from
# tool_input. A greedy sed over the raw text took the LAST `"<name>": "<value>"` anywhere, so a key
# the model added to its arguments (OpenCode hands them through: an `agent_type`, a `cwd`) stood in
# for the host's field, and an escaped quote cut a path short. One NUL-separated record; a payload
# that is not a JSON object, or a field holding a NUL, reads as `bad` (judged once the lock is known).
parsed="" tool="" file="" session="" agent_type="" agent_id="" cwd_p="" cmd=""
{ IFS= read -r -d '' parsed; IFS= read -r -d '' tool; IFS= read -r -d '' file; IFS= read -r -d '' session
  IFS= read -r -d '' agent_type; IFS= read -r -d '' agent_id; IFS= read -r -d '' cwd_p; IFS= read -r -d '' cmd; } < <(
  printf '%s' "$payload" | python3 -c '
import json, sys
raw = sys.stdin.read()
try:
    p = json.loads(raw) if raw.strip() else {}
except ValueError:
    p = None
ti = p.get("tool_input") if isinstance(p, dict) else None
ti = ti if isinstance(ti, dict) else {}
s = lambda v: v if isinstance(v, str) else ""
v = [s(p.get("tool_name")), s(ti.get("file_path")) or s(ti.get("filePath")), s(p.get("session_id")), s(p.get("agent_type")),
     s(p.get("agent_id")), s(p.get("cwd")), s(ti.get("command"))] if isinstance(p, dict) else []
sys.stdout.write("\0".join(["ok"] + v) + "\0" if v and not any("\0" in x for x in v) else "bad\0")' 2>/dev/null)

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
[ -n "${AGENTIC_HOME:-}" ] || . "$HERE/_paths.sh"
lock="$AGENTIC_HOME/state/sprint.lock"          # fixed path (bin/_paths.sh), git-ignored

# An unreadable payload is judged like a crash: it blocks while this repo has a sprint lock, and
# stays out of the way everywhere else (this gate sees every session on the machine).
if [ "$parsed" != ok ]; then
  [ -f "$lock" ] || exit 0
  echo "BLOCK[$GATE_NAME]: the hook payload is not a JSON object this gate can read (or python3 is missing) — failing closed while a sprint is live. (Deliberate bypass? SKIP_HOOKS=1.)" >&2
  exit 2
fi

lock_recent() {
  [ -f "$lock" ] || return 1
  local now m
  now="$(date +%s 2>/dev/null)" || return 1
  # A bad clock is a gate failure, not "lock is stale": bash 3.2 (macOS /bin/bash) does not
  # abort on `$(( not-a-number ))` under set -u, so the arm below would quietly allow.
  case "$now" in ''|*[!0-9]*) echo "$GATE_NAME: date +%s printed '$now'" >&2; exit 1 ;; esac
  # GNU first: on Linux `stat -f` means "filesystem status" and prints a report instead of
  # failing, which used to crash this arm (and a crashed hook does not block).
  m="$(stat -c %Y "$lock" 2>/dev/null)" || m="$(stat -f %m "$lock" 2>/dev/null)" || return 1
  case "$m" in ''|*[!0-9]*) return 1 ;; esac
  [ $(( now - m )) -lt "${AGENTIC_SPRINT_LOCK_TTL:-14400}" ]
}
# Codex edits files with apply_patch: tool_input is {"command": "<patch text>"}, the paths
# live in the patch headers. Check each path exactly as if it were a Write.
if [ "$tool" = "apply_patch" ] && command -v python3 >/dev/null 2>&1; then
  printf '%s' "$payload" | python3 -c '
import json, re, sys
p = json.load(sys.stdin)
patch = (p.get("tool_input") or {}).get("command") or ""
for a, b in re.findall(r"^\*\*\* (?:Add|Update|Delete) File: (.+)$|^\*\*\* Move to: (.+)$", patch, re.M):
    q = {k: v for k, v in p.items() if k in ("session_id", "agent_type", "agent_id", "cwd")}
    q["tool_name"] = "Write"; q["tool_input"] = {"file_path": (a or b).strip()}
    print(json.dumps(q))' | while IFS= read -r one; do
    printf '%s' "$one" | "$0" || exit 2
  done
  exit $?
fi

# The supervisor never schedules a wakeup while a sprint is live: a dispatched agent's result
# arrives on its own (its completion notification starts the next turn), and a pending wakeup
# outlives the sprint. Live e2e run 32: a 1200s "fallback heartbeat" set while the planner ran
# kept the headless session idle 12 minutes after the final gate had passed.
if [ "$tool" = "ScheduleWakeup" ]; then
  [ -z "$agent_type" ] && [ -f "$lock" ] || exit 0
  [ "$(head -1 "$lock" 2>/dev/null)" = "$session" ] || lock_recent || exit 0
  echo "BLOCK[$GATE_NAME]: no ScheduleWakeup during a sprint. A dispatched agent's result arrives on" >&2
  echo "  its own: its completion notification starts your next turn, even when the host moved it" >&2
  echo "  to the background. A pending wakeup outlives the sprint (live e2e run 32: 12 idle minutes" >&2
  echo "  after the final gate). End the turn, or do the next independent step." >&2
  exit 2
fi

# A dispatched agent's Bash may READ the task contract but not rewrite it (redirect, tee,
# sed -i, cp/mv/rm/...). Heuristic: the command names the contract AND has a write verb.
if [ "$tool" = "Bash" ]; then
  if [ -z "$agent_type" ]; then
    # MAIN agent: it never commits on main. Every commit on main arrives through
    # `task-worktree merge`, which is what makes it traceable to its task (events trace).
    # Live e2e run 16: a supervisor's `Track Cargo.lock` commit was the one commit that
    # traced to nothing. Judged only while a sprint is live here (lock), in the MAIN tree
    # (a commit inside a task worktree is a worker's, even if the supervisor runs it), and
    # never for an unborn repo (the initial commit is the worktree base SKILL.md asks for).
    [ -n "$session" ] || exit 0
    [ -f "$lock" ] || exit 0
    [ "$(head -1 "$lock" 2>/dev/null)" = "$session" ] || lock_recent || exit 0
    # Nor does it write an agent's output.md block (live e2e run 29: the final gate's report was
    # lost and the supervisor appended a final-gate block itself). A redirect or tee into a
    # docs/agents/**/output.md; reading it passes. Hosts with no agent_type (Codex, OpenCode) run
    # a worker's shell in its linked task worktree: that is the worker reporting, not judged.
    cwd0="$cwd_p"; [ -n "$cwd0" ] || cwd0="$PWD"
    wgd="$(cd "$cwd0" 2>/dev/null && cd "$(git rev-parse --git-dir 2>/dev/null)" 2>/dev/null && pwd -P)"
    wcd="$(cd "$cwd0" 2>/dev/null && cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd -P)"
    if [ -n "$wgd" ] && [ "$wgd" = "$wcd" ] && printf '%s' "$cmd" | python3 -c '
import re, sys
P = r"docs/agents/[^\s;&|]*output\.md(?=[\s\x27\x22;&|]|$)"
for seg in re.split(r"[;&|\n]+", sys.stdin.read()):
    if re.search(r">>?\s*[\x27\x22]?[^\s;&|]*" + P, seg) or re.search(r"(?:^|\s)tee(?:\s+-\w+)*\s+[\x27\x22]?[^\s;&|]*" + P, seg):
        sys.exit(0)
sys.exit(1)' 2>/dev/null; then
      echo "BLOCK[$GATE_NAME]: output.md is the dispatched agent's report; the supervisor never writes a block in it:" >&2
      echo "    $cmd" >&2
      echo "  If an agent's block is missing or wrong, re-dispatch that agent (a new attempt with a" >&2
      echo "  ### Feedback block in init.md); its gate tells it how to append." >&2
      exit 2
    fi
    # Per simple command: `git [-C <dir>] [opts] commit`. Prints the -C dir (or "") per hit.
    hits="$(printf '%s' "$cmd" | python3 -c '
import re, sys
cmd = sys.stdin.read()
for seg in re.split(r"[;&|\n]+", cmd):
    m = re.search(r"(?:^|[\s(])git(?:\s+-C\s+([^\s;&|]+))?(?:\s+-[-\w=]+)*\s+commit(?=\s|$)", seg)
    if m: print(m.group(1) or ".")' 2>/dev/null)"
    [ -n "$hits" ] || exit 0
    . "$HERE/_failclosed.sh"
    cwd="$cwd_p"; [ -n "$cwd" ] || cwd="$PWD"
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      case "$d" in /*) dir="$d" ;; *) dir="$cwd/$d" ;; esac
      git -C "$dir" rev-parse -q --verify HEAD >/dev/null 2>&1 || continue      # unborn: initial commit
      gd="$(cd "$dir" && cd "$(git rev-parse --git-dir 2>/dev/null)" 2>/dev/null && pwd -P)"
      cd_="$(cd "$dir" && cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd -P)"
      [ -n "$gd" ] && [ "$gd" = "$cd_" ] || continue                               # linked worktree: a worker's
      echo "BLOCK[$GATE_NAME]: the supervisor never commits on main during a sprint:" >&2
      echo "    $cmd" >&2
      echo "  Every commit on main arrives through \`aloop task-worktree merge\`, which is what makes it" >&2
      echo "  traceable to its task and intent (events trace). An untracked file you notice (a lockfile," >&2
      echo "  a generated file) is not yours to commit: leave it, or add it to the task whose worker" >&2
      echo "  produces it. (Deliberate out-of-band commit outside the pipeline? Re-run with SKIP_HOOKS=1.)" >&2
      exit 2
    done <<EOF_HITS
$hits
EOF_HITS
    exit 0
  fi
  # Per simple command (split on ; | & newlines): a redirect INTO the contract, or a write
  # verb in the same segment as a contract path.
  if printf '%s' "$payload" | python3 -c '
import json, re, sys
cmd = (json.load(sys.stdin).get("tool_input") or {}).get("command") or ""
P = r"\.(?:agentic|aladdin)/(?:state/|task\.env)"
VERB = re.compile(r"(?:^|[\s(])(?:tee|sed\s+-i\S*|perl\s+-\w*i|cp|mv|rm|ln|install|truncate|dd|touch|chmod)(?=\s|$)")
for seg in re.split(r"[;&|\n]+", cmd):
    if re.search(r">>?\s*[\x27\x22]?[^\s;&|]*" + P, seg) or (re.search(P, seg) and VERB.search(seg)):
        sys.exit(0)
sys.exit(1)' 2>/dev/null; then
    echo "BLOCK[$GATE_NAME]: this command rewrites the supervisor's task contract/state (<run-data>/state/ or the worktree's task.env copy); a dispatched agent may only read it." >&2
    echo "  Your task contract is fixed at dispatch. If it is wrong, say so in your output.md report." >&2
    exit 2
  fi
  exit 0
fi

# Only guard file-mutating tools that carry a path.
case "$tool" in Write|Edit|MultiEdit|NotebookEdit) ;; *) exit 0 ;; esac
[ -n "$file" ] || exit 0

# No session id => fail OPEN (don't risk blocking a non-agentic session).
[ -n "$session" ] || exit 0

# Classify where the write really lands: symlinks and `..` resolved as the OS resolves them, so
# `.aladdin/../src/a.rs` or `docs/agents/s1/../../../src/a.rs` is source. A relative path is the
# payload cwd's. Only suffix globs are matched below, so macOS's /var -> /private/var is harmless.
cwd_f="$cwd_p"; [ -n "$cwd_f" ] || cwd_f="$PWD"
case "$file" in /*) abs="$file" ;; *) abs="$cwd_f/$file" ;; esac
real="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$abs" 2>/dev/null)"
[ -n "$real" ] || real="$file"

# Dispatched sub-agent (planner / intake / standards / red / scaffolder / green / …):
# agent_type is present ⇒ it is doing its designated job; its own SubagentStop gate
# constrains it. Never block a sub-agent here.
# ...except the task contract and the supervisor's state: a worker that rewrites its contract
# (<run-data>/state/tasks/<TASK_ID>.env, or the worktree copy) widens its own scope or budget.
if [ -n "$agent_type" ]; then
  case "$real" in .agentic/state/*|*/.agentic/state/*|.aladdin/state/*|*/.aladdin/state/*|.agentic/task.env|*/.agentic/task.env|.aladdin/task.env|*/.aladdin/task.env)
    echo "BLOCK[$GATE_NAME]: $file is the supervisor's task contract/state; a dispatched agent may not write it." >&2
    echo "  Your task contract is fixed at dispatch. If it is wrong, say so in your output.md report." >&2
    exit 2 ;;
  esac
  exit 0
fi

# Fallback (only if a sub-agent's payload ever lacks agent_type): a worktree task.env naming a
# dispatched role still exempts that agent. Only a sub-agent's: the supervisor's payload carries
# no agent_id, and its hook may run inside a task worktree after a `cd` there.
if [ -n "$agent_id" ]; then
  for te in "$root/.aladdin/task.env" "$root/.agentic/task.env"; do
    if [ -f "$te" ] \
       && grep -qE '^[[:space:]]*AGENT_ROLE=("?)(red-worker|scaffolder|green-worker|planner|intake|standards|structural-reviewer|final-gate|archivist)\1' "$te" 2>/dev/null; then
      exit 0
    fi
  done
fi

# ── MAIN AGENT (the supervisor) from here on ───────────────────────────────
base="${real##*/}"

# (A) Planning artifacts are authored by a DISPATCHED activity, never hand-written by
# you. Path-based (fires even on the FIRST stories.md write, before any lock is armed).
case "$real" in docs/agents/*|*/docs/agents/*)
  case "$base" in stories.md|tasks.md|validate.md|plan.md|intake.md|standards.md)
    echo "BLOCK[$GATE_NAME]: dispatch the planning activity — do not hand-write this artifact:" >&2
    echo "    $file" >&2
    echo "  This is authored by a sub-agent you DISPATCH, not by you:" >&2
    echo "    stories/tasks/validate/plan/sprint-plan → the 'planner' agent" >&2
    echo "    intake.md → 'intake'  ·  standards.md → 'standards'" >&2
    echo "  Dispatch it (it writes the artifact); you review and approve the output. You own" >&2
    echo "  only plan-ready.md / init.md / execution.log / memory.md." >&2
    echo "  (Deliberate out-of-band edit outside the pipeline? Re-run with SKIP_HOOKS=1.)" >&2
    exit 2 ;;
  output.md)
    echo "BLOCK[$GATE_NAME]: output.md is the dispatched agent's report; the supervisor never writes a block in it:" >&2
    echo "    $file" >&2
    echo "  If an agent's block is missing or wrong, re-dispatch that agent (a new attempt with a" >&2
    echo "  ### Feedback block in init.md); its gate tells it how to append (live e2e run 29)." >&2
    exit 2 ;;
  defaults.md|NEXT.md|stats.md)
    echo "BLOCK[$GATE_NAME]: $base is written by the harness, never by hand:" >&2
    echo "    defaults.md → \`aloop-init --apply …\` (the init skill, after the human confirms)," >&2
    echo "                  or edit .aladdin/config.yaml and run \`aloop config sync\`" >&2
    echo "    NEXT.md / sprintN/stats.md → \`stats sprint-close\` (runs when FINAL-GATE passes)" >&2
    exit 2 ;;
  esac ;;
esac

# Classify the remaining target paths. Match relative AND absolute forms — do NOT
# prefix-strip against $root: on macOS `git rev-parse --show-toplevel` resolves /private
# symlinks and would not match the payload's /var path, silently disarming the guard.
case "$real" in
  # The mission layer's (gate-mission-scope judges it): a mission.json write is no sprint, so it
  # never arms the lock (ROADMAP §4.12, M9.9).
  docs/agents/mission/*|*/docs/agents/mission/*) is_docs=0; is_ctl=1 ;;
  docs/agents/*|*/docs/agents/*)                 is_docs=1; is_ctl=0 ;;
  # a task worktree lives under the run-data dir, but it is a checkout of the project: only its
  # own marker dir (the task.env copy) is a control file; the rest is production source
  .aladdin/worktrees/*/.aladdin/*|*/.aladdin/worktrees/*/.aladdin/*|.aladdin/worktrees/*/.agentic/*|*/.aladdin/worktrees/*/.agentic/*|\
  .agentic/worktrees/*/.aladdin/*|*/.agentic/worktrees/*/.aladdin/*|.agentic/worktrees/*/.agentic/*|*/.agentic/worktrees/*/.agentic/*) is_docs=0; is_ctl=1 ;;
  .aladdin/worktrees/*|*/.aladdin/worktrees/*|.agentic/worktrees/*|*/.agentic/worktrees/*) is_docs=0; is_ctl=0 ;;
  .agentic/*|*/.agentic/*|.aladdin/*|*/.aladdin/*|.transcripts/*|*/.transcripts/*) is_docs=0; is_ctl=1 ;;
  # VCS hygiene the supervisor legitimately writes for the initial commit — never
  # application source, so allow without the SKIP_HOOKS dance.
  .gitignore|*/.gitignore|.gitattributes|*/.gitattributes) is_docs=0; is_ctl=1 ;;
  *)                                             is_docs=0; is_ctl=0 ;;
esac

# Supervisor-owned planning artifact (init.md / plan-ready.md / execution.log /
# memory.md): ARMS the lock for this session (a sprint is live here), allow.
if [ "$is_docs" = 1 ]; then
  mkdir -p "$(dirname "$lock")" 2>/dev/null && printf '%s\n' "$session" > "$lock" 2>/dev/null || true
  exit 0
fi
# Worktree control file the supervisor writes at dispatch: allow.
[ "$is_ctl" = 1 ] && exit 0

# Production source. A sprint is "live" if THIS session armed the lock, OR the lock was
# refreshed recently (within AGENTIC_SPRINT_LOCK_TTL, default 4h). The recency arm covers
# a RESUMED sprint session that reads existing plans and acts before it re-arms (e.g.
# hand-fixing code after a structural-review finding). A lock with no recent activity is
# inert, so an old/abandoned sprint never blocks unrelated future work.
# This repo has a sprint lock, so the event is ours to judge: from here a crash blocks.
# (Before this point the gate also sees every unrelated session on the machine; it stays
# fail-open there so a gate bug can never stall work outside a sprint.)
if [ -f "$lock" ]; then
  # shellcheck source=/dev/null
  . "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_failclosed.sh"
fi
if [ -f "$lock" ] && { [ "$(head -1 "$lock" 2>/dev/null)" = "$session" ] || lock_recent; }; then
  echo "BLOCK[$GATE_NAME]: the supervisor may not write production source during a sprint:" >&2
  echo "    $file" >&2
  echo "  Code is written by a dispatched worker in its own worktree — you never edit source." >&2
  echo "  On a STRUCTURAL-REVIEW finding, RE-DISPATCH the implicated GREEN task with feedback" >&2
  echo "  (init.md); do NOT hand-fix the code yourself. For new work, dispatch red → scaffold" >&2
  echo "  → green. Ambiguous resume ('go on','continue') = re-dispatch the LAST activity." >&2
  echo "  (Deliberate out-of-band edit outside the pipeline? Re-run with SKIP_HOOKS=1.)" >&2
  exit 2
fi
exit 0
