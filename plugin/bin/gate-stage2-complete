#!/usr/bin/env bash
# PLANNING -> EXECUTION boundary (OPEN-3: run by the supervisor as a self-check
# before the first dispatch). Stage-2 must be complete for EVERY story, no TBW.
# md-db absent => WARN + structural fallback, never a false block / silent pass.
set -uo pipefail
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; export PATH="$BIN_DIR:$PATH"  # md-db shim -> real binary
GATE_NAME="gate-stage2-complete"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
: "${CLAUDE_PLUGIN_ROOT:=$(cd "$HERE/.." && pwd)}"

sprint_dir="${1:-${SPRINT_DIR:-}}"
if [ -z "$sprint_dir" ]; then
  sprint_dir="$(find . -maxdepth 5 -type d -name 'sprint*' 2>/dev/null | sort | tail -1)"
fi
if [ -z "$sprint_dir" ] || [ ! -d "$sprint_dir" ]; then
  echo "WARN[$GATE_NAME]: no sprint dir found; stage-2 check skipped (weaker)" >&2; exit 0
fi

# 1) No TBW placeholders anywhere.
if grep -rl 'TBW' "$sprint_dir" >/dev/null 2>&1; then
  echo "BLOCK[$GATE_NAME]: TBW remains in $sprint_dir (partial Stage-2 forbidden)" >&2
  exit 2
fi

# 2) Every SN-NN story in stories.md has a dir with tasks.md + validate.md + plan.md.
stories="$sprint_dir/stories.md"
if [ -f "$stories" ]; then
  ids="$(grep -oE 'S[0-9]+-[0-9]+' "$stories" | sort -u)"
  for id in $ids; do
    # match dir like s1-01-<slug> for S1-01
    lc="$(echo "$id" | tr 'A-Z' 'a-z')"          # s1-01
    dir="$(find "$sprint_dir" -maxdepth 1 -type d -name "${lc}-*" | head -1)"
    [ -n "$dir" ] || { echo "BLOCK[$GATE_NAME]: no story dir for $id" >&2; exit 2; }
    for f in tasks.md validate.md plan.md; do
      [ -f "$dir/$f" ] || { echo "BLOCK[$GATE_NAME]: $id missing $f" >&2; exit 2; }
    done
  done
else
  echo "WARN[$GATE_NAME]: stories.md not found in $sprint_dir" >&2
fi

# 3) Sprint containment: the supervisor clears context between sprints, so a sprint's
#    plan must not reference a LATER sprint's stories or defer work into one. Earlier
#    (already-merged) sprints are fine. stories.md (whose "Out of scope" legitimately
#    names future work) and the append-only comms (init.md/output.md) are exempt.
this_n="$(basename "$sprint_dir" | grep -oE '[0-9]+' | head -1)"
if [ -n "$this_n" ]; then
  later="$(find "$sprint_dir" -name '*.md' ! -name stories.md ! -name init.md ! -name output.md \
            -exec grep -hoE '\bS[0-9]+-[0-9]+\b' {} + 2>/dev/null \
            | sed -E 's/^S([0-9]+)-.*/\1/' | sort -un | awk -v n="$this_n" '$1>n' | head -1)"
  if [ -n "$later" ]; then
    echo "BLOCK[$GATE_NAME]: sprint $this_n references story IDs from later sprint $later —" \
         "a sprint must be self-contained (context is cleared between sprints). Cut the" \
         "dependency or move the story into this sprint." >&2
    exit 2
  fi
  spill="$(find "$sprint_dir" -name '*.md' ! -name stories.md ! -name init.md ! -name output.md \
             -exec grep -lEi '(continue|continued|finish|finished|complete|completed|defer|deferred|carry|carried|spill|pick(ed)? up)[a-z]* (it |this |the rest )?(in|into|to|over to|during) (the )?(next|later|following|future|subsequent) sprint|sprint ?(n ?\+ ?1|'"$((this_n+1))"')\b' {} + 2>/dev/null | head -1)"
  if [ -n "$spill" ]; then
    echo "BLOCK[$GATE_NAME]: $spill defers work into a later sprint — every task must" \
         "finish inside sprint $this_n. Cut the story smaller; list the remainder under" \
         "stories.md 'Out of scope'." >&2
    exit 2
  fi
fi

# 4) Identity + referential integrity (ROADMAP §4.5): issue canonical ids for every story
#    and task alias, check the structured references between artifacts, freeze the map.
"$BIN_DIR/ids" freeze "$sprint_dir" \
  || { echo "BLOCK[$GATE_NAME]: broken cross-artifact reference in $sprint_dir (see above)" >&2; exit 2; }

# 5) Structural validation via md-db (fallback to frontmatter check).
if "$BIN_DIR/ensure-tools" --resolve md-db >/dev/null 2>&1; then
  md-db validate "$sprint_dir" --schema "${CLAUDE_PLUGIN_ROOT}/schemas/planning-artifacts.kdl" \
    || { echo "BLOCK[$GATE_NAME]: md-db rejected $sprint_dir" >&2; exit 2; }
else
  echo "WARN[$GATE_NAME]: md-db absent; structural validation limited to dir/frontmatter checks" >&2
fi

echo "[$GATE_NAME] Stage-2 complete for all stories in $sprint_dir" >&2
exit 0
