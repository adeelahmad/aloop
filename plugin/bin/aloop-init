#!/usr/bin/env python3
"""aloop-init — project setup, done by the harness (the init skill only asks the human).

  aloop-init --show                 print the proposed settings for the human to confirm:
                                      limits, models, .gitignore changes, commit author,
                                      whether docs/agents/ is tracked (defaults: see below)
  aloop-init --apply KEY=VALUE ...  write docs/agents/defaults.md with the confirmed values
                                      (unlisted keys keep their current/default value), then
                                      apply them: .gitignore entries, repo-local git author
  aloop-init --ensure-gitignore     idempotent: re-add the managed .gitignore lines if the
                                      project opted in (SessionStart + worker hooks call it)

KEYS  TOKENS_SOFT TOKENS_HARD TIME_SOFT_MIN TIME_HARD_MIN MAX_REPLANS
      MODEL_PLANNING MODEL_WORKER
      GITIGNORE=yes|no        manage .gitignore (.agentic/, .transcripts/, docs/agents/)
      TRACK_DOCS=no|yes       keep docs/agents/ in git (default no -> it is git-ignored)
      COMMIT_AUTHOR_NAME / COMMIT_AUTHOR_EMAIL   who authors commits (default: your git
                              identity); set as this repo's git config user.name/email
      CLAUDE_COAUTHOR=no|yes  allow Claude co-author trailers in commits (default no)
"""
import datetime
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _paths  # noqa: E402

MANAGED_HEADER = "# aloop (managed by aloop-init)"
YESNO = {"GITIGNORE", "TRACK_DOCS", "CLAUDE_COAUTHOR"}
ORDER = ["TOKENS_SOFT", "TOKENS_HARD", "TIME_SOFT_MIN", "TIME_HARD_MIN", "MAX_REPLANS",
         "TOKEN_METER", "SPRINT_TOKENS_SOFT", "SPRINT_TOKENS_HARD",
         "MODEL_PLANNING", "MODEL_WORKER", "GITIGNORE", "TRACK_DOCS",
         "COMMIT_AUTHOR_NAME", "COMMIT_AUTHOR_EMAIL", "CLAUDE_COAUTHOR",
         "MODEL_PLANNING_CODEX", "MODEL_WORKER_CODEX", "EFFORT_PLANNING_CODEX", "EFFORT_WORKER_CODEX",
         "MODEL_PLANNING_OPENCODE", "MODEL_WORKER_OPENCODE"]
EXPLAIN = {
    "TOKENS_SOFT": "tokens — telemetry only: recorded for the next planning cycle, worker not told",
    "TOKENS_HARD": "tokens — worker is stopped by the hook; its task is split by the planner",
    "TIME_SOFT_MIN": "minutes — soft wall-clock limit per worker attempt",
    "TIME_HARD_MIN": "minutes — hard wall-clock limit per worker attempt",
    "MAX_REPLANS": "splits allowed per task lineage before the sprint hard-stops",
    "TOKEN_METER": "token charge: fresh (uncached input + output) or context (context in use + output)",
    "SPRINT_TOKENS_SOFT": "tokens — whole sprint: rollover warning (prefer critical-path tasks)",
    "SPRINT_TOKENS_HARD": "tokens — whole sprint: admission closes, not-started tasks carry over",
    "MODEL_PLANNING": "intake · standards · planner · archivist",
    "MODEL_WORKER": "red · scaffolder · green · structural-reviewer · final-gate (orchestrator: sonnet)",
    "GITIGNORE": "add .agentic/ and .transcripts/ (and docs/agents/ unless tracked) to .gitignore",
    "TRACK_DOCS": "commit docs/agents/ (planning docs) to git",
    "COMMIT_AUTHOR_NAME": "git author/committer name for every commit (repo-local git config)",
    "COMMIT_AUTHOR_EMAIL": "git author/committer email",
    "CLAUDE_COAUTHOR": "allow 'Co-Authored-By: Claude' / 'Generated with Claude Code' in commits",
    "MODEL_PLANNING_CODEX": "Codex planning agents' model (empty = the Codex session's model)",
    "MODEL_WORKER_CODEX": "Codex workers' model (empty = the Codex session's model)",
    "EFFORT_PLANNING_CODEX": "Codex planning agents' reasoning effort",
    "EFFORT_WORKER_CODEX": "Codex workers' reasoning effort",
    "MODEL_PLANNING_OPENCODE": "OpenCode planning agents' model (empty = anthropic/<MODEL_PLANNING>)",
    "MODEL_WORKER_OPENCODE": "OpenCode workers' model (empty = anthropic/<MODEL_WORKER>)",
}


def git(cwd, *args):
    try:
        return subprocess.run(("git", "-C", cwd) + args, capture_output=True, text=True, timeout=10).stdout.strip()
    except Exception:
        return ""


def current(cwd):
    vals = _paths.settings(cwd)
    if not vals["COMMIT_AUTHOR_NAME"]:
        vals["COMMIT_AUTHOR_NAME"] = git(cwd, "config", "user.name")
    if not vals["COMMIT_AUTHOR_EMAIL"]:
        vals["COMMIT_AUTHOR_EMAIL"] = git(cwd, "config", "user.email")
    return vals


def ignore_lines(vals):
    lines = [".agentic/", ".transcripts/"]
    if str(vals["TRACK_DOCS"]).lower() != "yes":
        lines.append("docs/agents/")
    return lines


def ensure_gitignore(cwd, vals, quiet=False):
    """Append the managed lines that are missing. Never removes anything."""
    root = _paths.project(cwd)
    gi = os.path.join(root, ".gitignore")
    try:
        existing = open(gi).read().splitlines()
    except OSError:
        existing = []
    have = {l.strip() for l in existing}
    missing = [l for l in ignore_lines(vals) if l not in have and "/" + l not in have]
    if not missing:
        return []
    lock = os.path.join(_paths.home(cwd, "state"), "gitignore.lock")
    try:
        os.mkdir(lock)
    except OSError:
        return []                                  # another hook is doing it right now
    try:
        with open(gi, "a") as f:
            if existing and existing[-1].strip():
                f.write("\n")
            if MANAGED_HEADER not in have:
                f.write(MANAGED_HEADER + "\n")
            for l in missing:
                f.write(l + "\n")
    finally:
        os.rmdir(lock)
    if not quiet:
        print("  .gitignore += " + " ".join(missing))
    return missing


def show(cwd):
    vals = current(cwd)
    exists = os.path.isfile(_paths.defaults_file(cwd))
    root = _paths.project(cwd)
    tracked = git(cwd, "ls-files", "docs/agents")
    print("## aloop project settings (%s)" % ("current: docs/agents/defaults.md" if exists else "proposed defaults — nothing saved yet"))
    print()
    print("| Setting | Value | Meaning |")
    print("|---|---|---|")
    for k in ORDER:
        empty = "(unset — git config has none)" if k.startswith("COMMIT_") else "(default)"
        print("| %s | %s | %s |" % (k, vals[k] if vals[k] != "" else empty, EXPLAIN[k]))
    print()
    if str(vals["GITIGNORE"]).lower() == "yes":
        print("`.gitignore` changes (%s): add %s" % (os.path.join(root, ".gitignore"), ", ".join("`%s`" % l for l in ignore_lines(vals))))
    if tracked and str(vals["TRACK_DOCS"]).lower() != "yes":
        print("Note: docs/agents/ is ALREADY tracked by git (%d files). Ignoring it stops new files only;"
              " untracking the existing ones needs `git rm -r --cached docs/agents` (ask the human)." % len(tracked.splitlines()))
    print()
    print("Ask the human to confirm or change each value (limits, models, the .gitignore edit, the"
          " commit author, tracking docs/agents/), then run: aloop init --apply KEY=VALUE ...")
    return 0


MEMORY_SEED = """---
type: memory
updated_at: %s
---
# aloop — agent memory

Curated at each retrospective (schema: schemas/memory.kdl). One row per lesson.

## Entries

| id | applies_to | text | origin | recurrence | added |
| --- | --- | --- | --- | --- | --- |
"""


def render(vals, who):
    today = datetime.date.today().isoformat()
    lines = ["---", "type: agentic-defaults", "confirmed_at: %s" % today, "---",
             "# aloop — project defaults", "",
             "Confirmed by %s on %s via `aloop-init --apply`. The hooks read these values;" % (who or "the human", today),
             "change them only by re-running the init skill (the supervisor may not hand-edit this file).", "",
             "## Settings", "", "```conf"]
    for k in ORDER:
        lines.append("AGENTIC_%s=%s" % (k, vals[k]))
    lines += ["```", "", "## What they mean", ""]
    for k in ORDER:
        lines.append("- `AGENTIC_%s` — %s" % (k, EXPLAIN[k]))
    lines += ["", "## Layout (fixed — bin/_paths.sh)", "",
              "- `.agentic/` — run data: transcripts, budget, token ledger, gate log, state. Always git-ignored.",
              "- `docs/agents/` — planning docs, `defaults.md`, `NEXT.md` (orchestrator handoff), `sprintN/stats.md`.", ""]
    return "\n".join(lines)


def apply(cwd, pairs):
    vals = current(cwd)
    for p in pairs:
        if "=" not in p:
            print("aloop-init: expected KEY=VALUE, got %r" % p, file=sys.stderr)
            return 64
        k, v = p.split("=", 1)
        k = k.strip().upper()
        k = k[len("AGENTIC_"):] if k.startswith("AGENTIC_") else k
        v = v.strip()
        if k not in _paths.DEFAULTS:
            print("aloop-init: unknown key %s (known: %s)" % (k, " ".join(ORDER)), file=sys.stderr)
            return 64
        if k in _paths.NUMERIC and not v.isdigit():
            print("aloop-init: %s must be a whole number" % k, file=sys.stderr)
            return 64
        if k == "TOKEN_METER" and v not in ("fresh", "context"):
            print("aloop-init: TOKEN_METER must be fresh or context", file=sys.stderr)
            return 64
        if k in YESNO and v.lower() not in ("yes", "no"):
            print("aloop-init: %s must be yes or no" % k, file=sys.stderr)
            return 64
        vals[k] = int(v) if k in _paths.NUMERIC else (v.lower() if k in YESNO else v)
    if vals["TOKENS_SOFT"] > vals["TOKENS_HARD"] or vals["TIME_SOFT_MIN"] > vals["TIME_HARD_MIN"] \
            or vals["SPRINT_TOKENS_SOFT"] > vals["SPRINT_TOKENS_HARD"]:
        print("aloop-init: a soft limit may not exceed its hard limit", file=sys.stderr)
        return 64
    os.makedirs(_paths.docs(cwd), exist_ok=True)
    with open(_paths.defaults_file(cwd), "w") as f:
        f.write(render(vals, vals["COMMIT_AUTHOR_NAME"]))
    print("wrote %s" % _paths.defaults_file(cwd))
    memory = os.path.join(_paths.docs(cwd), "memory.md")
    if not os.path.exists(memory):                   # seeded so no agent guesses its schema
        with open(memory, "w") as f:
            f.write(MEMORY_SEED % datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))
        print("wrote %s" % memory)
    if vals["GITIGNORE"] == "yes":
        ensure_gitignore(cwd, vals)
    for key, cfg in (("COMMIT_AUTHOR_NAME", "user.name"), ("COMMIT_AUTHOR_EMAIL", "user.email")):
        if vals[key] and git(cwd, "config", cfg) != vals[key]:
            git(cwd, "config", "--local", cfg, vals[key])
            print("  git config --local %s %s" % (cfg, vals[key]))
    _paths.home(cwd)                                 # create .agentic/ now that it is ignored
    try:                                             # keep Codex / OpenCode agents in step
        import importlib.machinery
        import importlib.util
        loader = importlib.machinery.SourceFileLoader("agentic_install", os.path.join(os.path.dirname(os.path.realpath(__file__)), "install"))
        spec = importlib.util.spec_from_loader("agentic_install", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        mod.rerender(_paths.project(cwd))
    except Exception as e:                           # never fail init over a host refresh
        print("  (host re-render skipped: %s)" % e)
    return 0


def main(argv):
    cwd = os.getcwd()
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv[0] == "--show":
        return show(cwd)
    if argv[0] == "--apply":
        return apply(cwd, argv[1:])
    if argv[0] == "--ensure-gitignore":
        if not os.path.isfile(_paths.defaults_file(cwd)):
            return 0                                   # project never opted in: touch nothing
        vals = _paths.settings(cwd)
        if vals["GITIGNORE"] == "yes":
            ensure_gitignore(cwd, vals, quiet=True)
        return 0
    print("aloop-init: unknown option %s" % argv[0], file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
