#!/usr/bin/env python3
"""module (aloop module) — modules that plug into the kernel (ROADMAP M12.7).

The host harness (Claude Code, Codex, OpenCode, dsh) is the hardware, aloop is the kernel, and a module
adds checks to the kernel's events. Use an existing module or build one for your project's needs
(docs/BUILD-A-MODULE.md).

  aloop module new <name> [--on EVENT]...   scaffold a module in ~/.aloop/modules/<name>/ (a commented,
                                            working example check)
  aloop module list                 installed modules (~/.aloop/modules/) and what this project runs
  aloop module add <name>           run <name> in this project, pinned to its current sha256
                                    (docs/agents/userspace/distro.json, in git); add it again after a change
  aloop module remove <name>        stop running it
  aloop module run <event> [--role R]   run this project's modules for an event by hand
                                        (SubagentStop, Stop); stdin is the hook payload
  aloop module hook                 the hook entry (SubagentStop, Stop): reads the payload, runs them

A module adds checks; it never removes or weakens a core gate (it runs beside them, and its pass decides
only itself). A module the project added that is missing, changed, crashes or times out blocks.
"""
import json
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import _kernel as K  # noqa: E402


def main(argv):
    cwd = os.getcwd()
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, rest = argv[0], argv[1:]
    try:
        if cmd == "list":
            d = K.distro(cwd)
            print("distro: %s" % d["distro"])
            names = sorted(set(K.installed()) | set(d["modules"]))
            for n in names:
                pinned = d["modules"].get(n)
                actual = K.module_sha(n)
                state = ("not added" if not pinned else "missing" if actual is None
                         else "added" if actual == pinned else "CHANGED since added")
                print("%-24s %-20s %s" % (n, state, (actual or "")[:12]))
            if not names:
                print("no modules (`aloop module new <name>` builds one in %s/)" % K.modules_dir())
            return 0
        if cmd == "new":
            if not rest:
                print("usage: aloop module new <name> [--on EVENT]...", file=sys.stderr)
                return 64
            on = [rest[i + 1] for i, a in enumerate(rest[:-1]) if a == "--on"]
            d = K.scaffold(rest[0], on or None)
            print("created %s (edit its check, then `aloop module add %s` in a project)" % (d, rest[0]))
            return 0
        if cmd in ("add", "remove"):
            if len(rest) != 1:
                print("usage: aloop module %s <name>" % cmd, file=sys.stderr)
                return 64
            if cmd == "add":
                print("added %s %s" % (rest[0], K.add(cwd, rest[0])[:12]))
            else:
                K.remove(cwd, rest[0])
                print("removed " + rest[0])
            return 0
        if cmd in ("run", "hook"):
            payload = "" if sys.stdin.isatty() else sys.stdin.read()
            if cmd == "run":
                if not rest:
                    print("usage: aloop module run <event> [--role R]", file=sys.stderr)
                    return 64
                event = rest[0]
                role = rest[rest.index("--role") + 1] if "--role" in rest[:-1] else ""
            else:
                if os.environ.get("SKIP_HOOKS") == "1":
                    return 0                     # the same escape hatch every core gate honors
                try:
                    p = json.loads(payload) if payload.strip() else {}
                except ValueError:
                    p = {}
                p = p if isinstance(p, dict) else {}
                if isinstance(p.get("cwd"), str) and os.path.isdir(p["cwd"]):
                    cwd = p["cwd"]
                    os.chdir(cwd)
                event = str(p.get("hook_event_name") or "SubagentStop")
                role = str(p.get("agent_type") or "").split(":")[-1]
            code, reasons = K.run(cwd, event, role, payload)
            for r in reasons:
                print("BLOCK[module]: " + r, file=sys.stderr)
            return code
    except ValueError as e:
        print("module: %s" % e, file=sys.stderr)
        return 64
    print("module: unknown command %r (aloop module --help)" % cmd, file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
