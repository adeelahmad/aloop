#!/usr/bin/env python3
"""run-summary — the measured record of one live run (ROADMAP §4.11: evidence, not claims).

    run-summary <run-dir> [--intent NAME] [--host claude|codex|opencode|dsh] [--checks N/M] [--secs WALL] [--plugin DIR]

Reads <run-dir>/out.jsonl (the supervisor's stream-json transcript) and the run repo's
gate log (<run-dir>/repo/.aladdin/logs/gates.jsonl, or .agentic/), writes
<run-dir>/summary.json and <run-dir>/summary.md, and prints the summary with a ready-to-paste
row for docs/evidence/README.md. Numbers come from the harness, never from the model:
  cost_usd / supervisor_turns  the LAST `result` line (a resumed session reports again);
                               Codex and OpenCode print none, so the cost is null and the row
                               says — (unmeasured), never $0.00
  cost_usd / cost_by_model     dsh prints none either, but its plugin logs each completed call's
    (--host dsh)               exact usage (<repo>/.aladdin/host/dsh: the supervisor and each role,
                               dsh's compaction and session-title calls too), so each call is priced
                               from the dated table in _prices.py; a model it has no price for keeps
                               its tokens with usd null, and then the run's cost is null too (never
                               a partial sum). Kept to the micro-dollar (a short DeepSeek run costs a
                               fraction of a cent), shown to four places, <$0.0001 below that (read
                               before rounding), so a measured nonzero cost never reads $0.00 or
                               $0.0000; scripts/test/evidence.test.py takes exactly these cells (and
                               Claude's $N.NN). Not in it: a retried attempt and server-side
                               Search/Fetch (ROADMAP §4.9)
  wakes                        how many `result` lines: one per supervisor wake
  plugin_reads                 sub-agent tool calls naming a plugin path, except a
                               `<plugin>/schemas/…` file (md-db's schema: a legitimate use,
                               also when bound to a shell variable first — run 19 counted 5
                               such `SCH=…; md-db describe --schema "$SCH"` calls as reads)
  gate_verdicts / gate_blocks  lines in gates.jsonl / those with "exit":2
  selfcheck_blocks             the blocks a worker's own `selfcheck` caught ("selfcheck":true): they
                               never reach the supervisor (run 27: 2 of its 3 blocks)
Exit 0; a missing out.jsonl is a usage error (64)."""
import glob
import json
import os
import re
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _prices  # noqa: E402
import _usage  # noqa: E402


def arg(flag, default=None):
    return sys.argv[sys.argv.index(flag) + 1] if flag in sys.argv[:-1] else default


def wall(secs):
    return "%dm%02ds" % (int(secs) // 60, int(secs) % 60)


def dsh_cost(repo):
    """(total USD or None, {model: calls, token classes, usd}) from the dsh plugin's usage logs:
    <run-data>/host/dsh/<root>.jsonl (the supervisor) and <root>/subagents/agent-<id>.jsonl (each
    role). No log is no measurement (None, {}); an unpriced model makes the total None."""
    by, raw = {}, {}
    for h in (".aladdin", ".agentic"):
        d = os.path.join(repo, h, "host", "dsh")
        if not os.path.isdir(d):
            continue
        for p in sorted(glob.glob(os.path.join(d, "*.jsonl")) + glob.glob(os.path.join(d, "*", "subagents", "agent-*.jsonl"))):
            for r in _usage.rows(p):
                m = r["model"] or "?"
                c = by.setdefault(m, {"calls": 0, "in": 0, "cache_read": 0, "cache_write": 0, "out": 0, "usd": None})
                c["calls"] += 1
                for k in ("in", "cache_read", "cache_write", "out"):
                    c[k] += r[k]
                u, was = _prices.usd(r), raw.get(m, 0.0)
                raw[m] = None if u is None or was is None else was + u
        break
    for m, u in raw.items():
        by[m]["usd"] = None if u is None else round(u, 6)
    total = None if not by or None in raw.values() else sum(raw.values())
    return total, by


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip()); return 0 if len(sys.argv) > 1 else 64
    run = os.path.abspath(sys.argv[1])
    out = os.path.join(run, "out.jsonl")
    if not os.path.isfile(out):
        print("run-summary: no out.jsonl in %s" % run, file=sys.stderr); return 64
    plugin = os.path.abspath(arg("--plugin") or os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
    pat = re.compile(re.escape(plugin) + r"/schemas/\S*")
    cost = None
    turns = wakes = reads = 0
    host = arg("--host") or "claude"
    secs = arg("--secs")
    for l in open(out):
        try:
            e = json.loads(l)
        except ValueError:
            continue
        if not isinstance(e, dict):
            continue
        if e.get("type") == "result":
            wakes += 1
            cost, turns = e.get("total_cost_usd") or 0, e.get("num_turns") or 0
            if secs is None and e.get("duration_ms"):
                secs = int(e["duration_ms"]) // 1000
        m = e.get("message")
        content = m.get("content") if isinstance(m, dict) else None
        for c in content if isinstance(content, list) else []:
            if not isinstance(c, dict) or c.get("type") != "tool_use":
                continue
            i = c.get("input") or {}
            text = i.get("command") or i.get("file_path") or i.get("path") or ""
            if plugin + "/" in pat.sub("", text):
                reads += 1
    repo = os.path.join(run, "repo")
    verdicts = blocks = self_blocks = 0
    for h in (".aladdin", ".agentic"):
        g = os.path.join(repo, h, "logs", "gates.jsonl")
        if os.path.isfile(g):
            for l in open(g):
                if l.strip():
                    verdicts += 1
                    try:
                        v = json.loads(l)
                    except ValueError:
                        continue
                    if isinstance(v, dict) and v.get("exit") == 2:
                        blocks += 1
                        self_blocks += v.get("selfcheck") is True
            break
    by = None
    if host == "dsh":       # dsh prints no cost line: price the usage its plugin logged per call
        cost, by = dsh_cost(repo)
    try:
        head = subprocess.run(["git", "-C", repo, "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
    except OSError:
        head = ""
    try:
        version = json.load(open(os.path.join(plugin, ".claude-plugin", "plugin.json"))).get("version", "")
    except (OSError, ValueError):
        version = ""
    intent = arg("--intent") or ""
    s = {"run_dir": run, "intent": intent, "host": host, "plugin_version": version, "checks": arg("--checks") or "",
         "wall": wall(secs or 0), "cost_usd": None if cost is None else round(float(cost), 6 if host == "dsh" else 2),
         "supervisor_turns": turns, "wakes": wakes,
         "plugin_reads": reads, "gate_verdicts": verdicts, "gate_blocks": blocks,
         "selfcheck_blocks": self_blocks, "run_repo_head": head,
         "reproduce": "make e2e-live YES=1" + (" INTENT=%s" % intent if intent else "") + (" HOST=%s" % host if host != "claude" else ""),
         "recorded_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    if by is not None:
        s.update(cost_by_model=by, prices=_prices.SOURCE)
    cost_cell = "—" if s["cost_usd"] is None else "$%.2f" % s["cost_usd"]
    if host == "dsh" and s["cost_usd"] is not None:     # DeepSeek bills 20-100x below Claude: cents would read a run as free
        # judged on the unrounded total: one under half a micro-dollar is stored as 0.0 but was measured
        cost_cell = "<$0.0001" if 0 < cost < 0.0001 else "$%.4f" % s["cost_usd"]
    label = (intent or "?") + ("" if host == "claude" else " (%s)" % host)
    row = "| %s | %s | v%s | %s | %s | %s | %s | %s | %s | `%s` |" % (
        os.path.basename(run), label, version, s["checks"] or "?", s["wall"], cost_cell, wakes, reads, blocks, s["reproduce"])
    md = ("# Live run %s\n\n| run | intent | plugin | checks | wall | cost | wakes | plugin reads | gate blocks | reproduce |\n"
          "|---|---|---|---|---|---|---|---|---|---|\n%s\n\nrun repo head: `%s` · gate verdicts: %d · supervisor turns: %d\n"
          % (os.path.basename(run), row, head, verdicts, turns))
    priced = ["%s: %d calls · in %d · cache read %d · cache write %d · out %d · %s" % (
        m, c["calls"], c["in"], c["cache_read"], c["cache_write"], c["out"],
        "no published price, cost unmeasured" if c["usd"] is None else "$%.6f" % c["usd"]) for m, c in sorted((by or {}).items())]
    if priced:
        md += "\ncost per model, priced per call from %s:\n\n%s\n" % (_prices.SOURCE, "\n".join("- " + p for p in priced))
    with open(os.path.join(run, "summary.json"), "w") as f:
        json.dump(s, f, indent=1)
    with open(os.path.join(run, "summary.md"), "w") as f:
        f.write(md)
    print("cost: %s · supervisor turns: %s · wall: %s" % (cost_cell, turns, s["wall"]))
    if priced:
        print("priced per call from %s:" % _prices.SOURCE)
        for p in priced:
            print("  " + p)
    print("supervisor wakes: %d · sub-agent reads of the plugin's own source: %d" % (wakes, reads))
    if verdicts:
        print("gate verdicts: %d (%d blocks%s)" % (verdicts, blocks,
              ", %d caught by the worker's own self-check" % self_blocks if self_blocks else ""))
    print("evidence row (docs/evidence/README.md):")
    print(row)
    return 0


if __name__ == "__main__":
    sys.exit(main())
