#!/usr/bin/env bash
# standards.md gate: every rule bullet under "## Active rules" must cite a real
# source (CLAUDE.md Rn, a rules/<lang>/<file>, or a docs/agents/*.md path). A bullet
# with no citation is a dangling rule. (No `set -e`: grep-no-match must not be read
# as a block; this gate emits exit 2 only for an actual dangling citation.)
set -uo pipefail
GATE_NAME="gate-standards-cited"
# shellcheck source=/dev/null
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_failclosed.sh"   # a crash blocks, never allows

# Resolve standards.md: $1, $STANDARDS_FILE, or auto-discover under the repo.
# shellcheck source=/dev/null
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_finddoc.sh"   # agentic_find_doc: never a host's agent definition
sf="${1:-${STANDARDS_FILE:-}}"
if [ -z "$sf" ]; then
  sf="$(agentic_find_doc standards.md)"
fi
if [ -z "$sf" ] || [ ! -f "$sf" ]; then
  echo "WARN[$GATE_NAME]: standards.md not found; citation check skipped (weaker)" >&2
  exit 0
fi

# Bullet lines in the "Active rules" section that carry no recognizable citation.
dangling="$(awk '
  /^#+.*[Aa]ctive rules/ {insec=1; next}
  insec && /^#+[[:space:]]/ {insec=0}
  insec && /^[[:space:]]*[-*][[:space:]]/ {print}
' "$sf" | grep -vE 'CLAUDE\.md|R[0-9]+|rules/|docs/|\.md|\.rs|\.toml' || true)"

# The gate matrix must parse: GREEN, RED and FINAL run exactly the fenced lines under a
# "## Gate matrix" heading. One they cannot read sends every worker gate to a fallback (live
# run 37: RED blocked 3x with "no gate matrix found" until the standards role was re-run).
# shellcheck source=/dev/null
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_matrix.sh"
if [ -z "$(standards_matrix_lines "$sf")" ]; then
  echo "BLOCK[$GATE_NAME]: $sf has no gate matrix the gates can run. Write a '## Gate matrix' heading followed by ONE fenced block (\`\`\`) holding the gated shell commands, one per line (e.g. the test, fmt and lint commands); the GREEN, RED and FINAL gates run exactly those lines. Explanations go after the block, outside it." >&2
  exit 2
fi

if [ -n "$dangling" ]; then
  echo "BLOCK[$GATE_NAME]: rule bullet(s) cite no source:" >&2
  echo "$dangling" >&2
  exit 2
fi

echo "[$GATE_NAME] all active-rule bullets carry a citation" >&2
exit 0
