#!/usr/bin/env bash
# agentic — the pre-rename name of `aloop`, kept so existing scripts, prompts and
# ~/.local/bin links keep working. Everything is forwarded to aloop unchanged.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
exec "$(cd "$(dirname "$src")" && pwd)/aloop" "$@"
