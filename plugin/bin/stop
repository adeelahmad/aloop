#!/usr/bin/env python3
"""stop — one stop for the whole project (ROADMAP M10.4).

  aloop stop [REASON]      stop now: every agent of this project (the supervisor, each worker in
                           its task worktree, each mission role) is refused every acting tool call
                           and ends at its next read; `mission tick` answers STOPPED. Records
                           run.stopped. Any shell may stop: stopping only ever takes power away.
  aloop stop --status      exit 0 running, 3 stopped (with the reason)
  aloop stop --clear       resume. Only the human, from their own terminal: a shell an agent host
                           runs is refused. Records run.resumed.

With a mission ledger (docs/agents/mission/ledger.jsonl) both records are ledger rows too, so a
fresh clone stays stopped until the human clears it there.
"""
import json
import os
import sys
import time

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _events  # noqa: E402
import _mission  # noqa: E402
import _paths  # noqa: E402
import _stop  # noqa: E402

# set in every shell an agent host runs (its Bash tool): a resume never comes from there. Claude
# Code, dsh and Codex set theirs; aloop's OpenCode plugin exports ALOOP_AGENT_SHELL (the door
# gate's list, M9.31)
AGENT_SHELL = ("CLAUDECODE", "DSH_SHELL", "CODEX_THREAD_ID", "ALOOP_AGENT_SHELL")


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def record(cwd, event, role, **data):
    """The stop or resume as a mission ledger row when the project has a ledger (its event comes with
    it), else as an event. A broken ledger takes no row: say so (BLOCK) and return False."""
    if not os.path.exists(_mission.ledger(cwd)):
        _events.emit(cwd, event, role=role, **data)
        return True
    try:
        _mission.record(cwd, event, "project", role, **data)
        return True
    except _mission.LedgerBroken as e:
        print("BLOCK[stop]: the mission ledger is broken (%s), so it cannot record %s: restore it "
              "(git checkout -- %s) and run this again" % (e, event, _mission.rel(cwd, _mission.ledger(cwd))),
              file=sys.stderr)
        return False


def main(argv):
    cwd = os.getcwd()
    rec = _stop.read(cwd)
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    if argv[:1] == ["--status"]:
        if rec:
            print("stopped: %s (at %s, by %s)" % (rec.get("reason") or "no reason given", rec.get("at") or "?",
                                                rec.get("by") or "?"))
            return 3
        print("running")
        return 0
    if argv[:1] == ["--clear"]:
        agent = [k for k in AGENT_SHELL if os.environ.get(k)]
        if agent:
            print("BLOCK[stop]: this shell belongs to an agent session (%s is set): the human resumes the "
                  "project in their own terminal (`aloop stop --clear`)" % " ".join(agent), file=sys.stderr)
            return 2
        if not rec:
            print("running (nothing to clear)")
            return 0
        info = dict(stopped_at=rec.get("at"), reason=rec.get("reason"))
        if _stop.ledger_stop(cwd):                    # the ledger's stop holds every clone: clear it there too
            if not record(cwd, "run.resumed", "human", **info):
                return 2
        else:
            _events.emit(cwd, "run.resumed", role="human", **info)
        if os.path.exists(_stop.path(cwd)):
            os.remove(_stop.path(cwd))
        print("running: the stop of %s is cleared" % (rec.get("at") or "?"))
        return 0
    if argv[:1] and argv[0].startswith("-"):
        print(__doc__.strip(), file=sys.stderr)
        return 64
    reason = " ".join(argv).strip()
    by = "agent" if any(os.environ.get(k) for k in AGENT_SHELL) else "human"
    if rec:
        print("stopped already: %s (at %s)" % (rec.get("reason") or "no reason given", rec.get("at")))
        return 0
    rec = {"at": now(), "reason": reason, "by": by}
    os.makedirs(os.path.dirname(_stop.path(cwd)), exist_ok=True)
    _paths.home(cwd)                                          # writes .aladdin/.gitignore if missing
    with open(_stop.path(cwd), "w") as f:
        json.dump(rec, f)
    record(cwd, "run.stopped", by, reason=reason)      # the flag holds here even when the ledger cannot
    print("stopped: every agent of %s is refused from its next tool call; `aloop stop --clear` in your "
          "own terminal resumes" % _paths.project(cwd))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
