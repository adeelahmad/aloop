#!/usr/bin/env python3
"""events — the aladdin.event/1 stream (.agentic/logs/events.jsonl).

Usage:
  events emit EVENT [--task T] [--attempt N] [--agent ID] [--role R] [--parent EVENT_ID]
                    [--caused-by EVENT_ID] [--ref name=path ...] [--data key=value ...]
                                       append one event; prints its event_id
  events query [--task T] [--event E] [--sprint S1]
                                       matching events, one compact line each
  events lineage TASK_ID               the task's chain: dispatch → attempts → gates →
                                       limits/decisions → worktree outcome (no transcripts)
  events trace SHA                     commit → task → gates/decisions → plan → intent →
                                       approver, from the stream alone (exit 1: unknown commit);
                                       a mission intent adds goal → eval → ethics → mission
  events commit-msg TASK_ID           a commit message built from the task's title (tasks.md),
                                       its recorded decisions and the intent, never model prose
  events graph [--format json|dot]     the stream as a graph (events, tasks, commits, intents;
                                       parent / caused_by / about edges); rebuildable, downstream
  events authority --initiated-by WHO --mode reviewed|autonomous --scope "..." [--sprint N]
                   [--policy P] [--override key=value ...]
                                       the run's authority record (human.approval);
                                       decisions default to it. With a sprint (reviewed: the
                                       latest frozen plan's by default) it is the human's grant
                                       and counts only in their own typed line: until a captured
                                       prompt says `approve SN <code>` (autonomous: `autonomous
                                       SN <code>`) it asks with that line (exit 3). An approved
                                       autonomous mission is that word for its own sprints
  events approval SPRINT|TASK_ID [--story-dir DIR] [--role ROLE]
                                       may an execution role of that sprint be dispatched now, on
                                       that STORY_DIR? (gate-dispatch asks): exit 0 yes, 2 no and why
                                       (ROADMAP M0.9)
  events decide KIND --reason "one line" [--task T] [--evidence ref ...] [--authority EVENT_ID]
                                       structured rationale (plan|split|target|
                                       implementation|replan|acceptance)
Emitting never fails a hook: an unknown event type is the only error (exit 64), besides the
human approvals (the authority record and plan.approved included), ethics verdicts and goal lineage of the
mission layer, which only their own commands write.
"""
import glob
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _approval  # noqa: E402
import _events  # noqa: E402
import _mission  # noqa: E402
import _paths  # noqa: E402

# events only their own command may write (ROADMAP §4.12): human decisions, the ethics and door gates'
# records and the goal lineage (`events trace` and `mission goal close` read them)
GATE_OWNED = set(_mission.HUMAN_EVENTS) | {"ethics.reviewed", "ethics.blocked", "goal.derived", "goal.met",
                                          "goal.retired",                      # `mission goal retire` (M9.50)
                                          "door.denied", "door.crossed",       # the door gate's own records (M9.30)
                                          "state.assessed", "eval.completed",  # what goals are derived and closed from
                                          "intent.received"}                   # an intent's lineage (`intent new`)
# the human's grant of a sprint (ROADMAP M0.9): only `events authority` writes it, from their typed line
GATE_OWNED |= {"human.approval", "plan.approved"}
# the project stop (ROADMAP M10.4): only `aloop stop` writes it
GATE_OWNED |= {"run.stopped", "run.resumed"}


def parse(argv):
    opts, pos, k = {"ref": [], "data": [], "evidence": [], "override": []}, [], None
    for a in argv:
        if k:
            (opts[k].append(a) if isinstance(opts.get(k), list) else opts.__setitem__(k, a))
            k = None
        elif a.startswith("--"):
            k = a[2:].replace("-", "_")
        else:
            pos.append(a)
    return opts, pos


def line(ev):
    ids = ev.get("ids") or {}
    d = ev.get("decision") or {}
    if d:
        return "%s %-24s %-10s %-12s %s: %s" % (ev.get("ts", "?"), ev.get("event"), ids.get("task", "-"), ev.get("role") or "-",
                                                d.get("kind"), d.get("reason"))
    extra = " ".join("%s=%s" % kv for kv in sorted((ev.get("data") or {}).items()) if kv[0] not in ("observe",))
    return "%s %-24s %-10s %-12s %s%s" % (ev.get("ts", "?"), ev.get("event", "?"), ids.get("task", "-"),
                                         ev.get("role") or "-", extra, (" parent=" + ev["parent_event_id"][:8]) if ev.get("parent_event_id") else "")


def trace(cwd, sha):
    """commit → attempt → decision → gate → plan → intent → approver, refs only."""
    evs = list(_events.read(cwd))
    commit = next((e for e in evs if e.get("event") == "commit.created" and sha
                   and str((e.get("data") or {}).get("sha", "")).startswith(sha)), None)
    if not commit:
        print("events trace: no commit.created for %s" % sha, file=sys.stderr)
        return 1
    d, task = commit["data"], (commit.get("ids") or {}).get("task", "")
    sprint = (commit.get("ids") or {}).get("sprint", "")
    print("commit   %s %s" % (d["sha"][:12], d.get("subject", "")))
    print("task     %s" % task)
    for e in evs:
        if (e.get("ids") or {}).get("task") != task:
            continue
        if e["event"] in ("gate.passed", "gate.failed", "decision.recorded", "task.token_hard_limit",
                          "task.time_hard_timeout", "worktree.merged"):
            print("  %s" % line(e))
    plan = None
    for e in evs:
        if e.get("event") in ("plan.created", "plan.revised") and (e.get("data") or {}).get("sprint") == sprint \
                and e.get("ts", "") <= commit.get("ts", ""):
            plan = e
    if not plan:
        print("plan     (missing: no plan.created for %s — was gate-stage2-complete run?)" % (sprint or "this sprint"))
        return 0
    print("plan     %s %s %s" % (plan["event"], sprint, " ".join("%s=%s" % kv for kv in sorted((plan.get("refs") or {}).items()))))
    by_id = {e.get("event_id"): e for e in evs}
    intent = by_id.get(plan.get("caused_by"))
    if intent:
        iid = (intent.get("data") or {}).get("intent_id", "")
        recv = next((e for e in evs if e.get("event") == "intent.received" and (e.get("data") or {}).get("intent_id") == iid), {})
        print("intent   %s %s raw=%s" % (iid, (intent.get("refs") or {}).get("intent", ""), (recv.get("refs") or {}).get("raw", "-")))
        mission_trace(evs, recv)
    else:
        print("intent   (missing: the plan names no intent.normalized)")
    appr = [e for e in evs if e.get("event") == "plan.approved" and e.get("caused_by") == plan.get("event_id")]
    if appr:
        a = appr[-1].get("authority") or {}
        print("approved %s (%s) scope=%r" % (a.get("initiated_by"), a.get("autonomy_mode"), a.get("scope")))
    else:
        auto = [e for e in evs if e.get("event") == "human.approval" and (e.get("authority") or {}).get("sprint") == sprint
                and (e.get("authority") or {}).get("autonomy_mode") == "autonomous" and e.get("ts", "") <= commit.get("ts", "")]
        if auto:
            a = auto[-1]["authority"]
            print("approved %s (autonomous) scope=%r" % (a.get("initiated_by"), a.get("scope")))
        else:
            print("approved (missing: no plan.approved for this plan)")
    return 0


def mission_trace(evs, recv):
    """intent → goal → eval → ethics → mission → its approver (ROADMAP §4.12), for an intent a
    mission goal handed off (`intent new --source mission --goal`)."""
    gid = (recv.get("data") or {}).get("goal_id")
    if not gid:
        return
    gd = None
    for e in evs:
        if e.get("event") == "goal.derived" and (e.get("data") or {}).get("goal_id") == gid:
            gd = e
    if not gd:
        print("goal     %s (missing: no goal.derived)" % gid)
        return
    d = gd.get("data") or {}
    ref = d.get("subject")              # the goal file the ledger row covers
    print("goal     %s from eval %s gaps=%s (%s)" % (gid, d.get("eval_id"), ",".join(d.get("gaps") or []), d.get("autonomy")))
    about = [e for e in evs if (e.get("data") or {}).get("subject") == ref and (e.get("data") or {}).get("sha256") == d.get("sha256")]
    tiers = [e["data"].get("tier") for e in about if e.get("event") == "ethics.reviewed"]
    consent = [e for e in about if e.get("event") == "ethics.consent"]
    if not tiers:
        print("ethics   (missing: no review of this goal's content)")
    else:
        tier = "hard" if "hard" in tiers else "gray" if "gray" in tiers else "clear"
        print("ethics   %s%s" % (tier, " (consent by %s)" % consent[-1]["data"].get("by") if tier == "gray" and consent else ""))
    ok = [e for e in evs if e.get("event") == "mission.approved" and (e.get("data") or {}).get("sha256") == d.get("mission_sha256")]
    if ok:
        print("mission  %s approved by %s" % (d.get("mission_id"), ok[-1]["data"].get("by")))
    else:
        print("mission  %s (missing: no mission.approved for the content the goal served)" % d.get("mission_id"))


def task_title(cwd, task):
    m = re.match(r"^S(\d+)-(\d+)-T(\d+)$", task or "")
    if not m:
        return ""
    for tf in glob.glob(os.path.join(_paths.docs(cwd), "sprint%s" % m.group(1), "s%s-%s-*" % (m.group(1), m.group(2)), "tasks.md")):
        h = re.search(r"(?m)^##\s+T%s\b\s*[—:-]*\s*(.*)$" % m.group(3), open(tf).read())
        if h:
            return h.group(1).strip()
    return ""


def commit_msg(cwd, task):
    """Subject from the planner's task title; body from recorded decisions; trailers link
    the task id, its canonical id and the intent. Built from the stream, never model prose."""
    title = task_title(cwd, task)
    if not title:
        print("events commit-msg: no ## heading for %s in tasks.md" % task, file=sys.stderr)
        return 1
    evs = list(_events.read(cwd))
    mine = [e for e in evs if (e.get("ids") or {}).get("task") == task]
    body = ["- %s: %s" % (e["decision"]["kind"], e["decision"]["reason"]) for e in mine if e.get("decision")]
    uid = next(((e.get("ids") or {}).get("task_uid") for e in reversed(mine) if (e.get("ids") or {}).get("task_uid")), "")
    sp = (_events.ids_for(task) or {}).get("sprint")
    plan = [e for e in evs if e.get("event") in ("plan.created", "plan.revised") and (e.get("data") or {}).get("sprint") == sp]
    intent = (plan[-1].get("data") or {}).get("intent_id") if plan else ""
    out = ["%s: %s" % (task, title)]
    if body:
        out += [""] + body
    out += ["", "Task: %s%s" % (task, " (%s)" % uid if uid else "")]
    if intent:
        out.append("Intent: %s" % intent)
    print("\n".join(out))
    return 0


def graph(cwd, fmt_):
    nodes, edges = {}, []
    for e in _events.read(cwd):
        eid = e.get("event_id")
        if not eid:
            continue
        nodes[eid] = {"id": eid, "type": "event", "event": e.get("event"), "ts": e.get("ts")}
        for rel in ("parent_event_id", "caused_by"):
            if e.get(rel):
                edges.append({"from": eid, "to": e[rel], "rel": "parent" if rel == "parent_event_id" else "caused_by"})
        task = (e.get("ids") or {}).get("task")
        if task:
            nodes.setdefault("task:" + task, {"id": "task:" + task, "type": "task"})
            edges.append({"from": eid, "to": "task:" + task, "rel": "about"})
        d = e.get("data") or {}
        if e.get("event") == "commit.created" and d.get("sha"):
            nodes.setdefault("commit:" + d["sha"], {"id": "commit:" + d["sha"], "type": "commit"})
            edges.append({"from": "commit:" + d["sha"], "to": eid, "rel": "recorded_by"})
        if d.get("intent_id"):
            nodes.setdefault("intent:" + d["intent_id"], {"id": "intent:" + d["intent_id"], "type": "intent"})
            edges.append({"from": eid, "to": "intent:" + d["intent_id"], "rel": "about"})
    if fmt_ == "dot":
        print("digraph aladdin {")
        for n in nodes.values():
            print('  "%s" [label="%s"];' % (n["id"], n.get("event") or n["id"]))
        for ed in edges:
            print('  "%s" -> "%s" [label="%s"];' % (ed["from"], ed["to"], ed["rel"]))
        print("}")
    else:
        print(json.dumps({"schema": "aladdin.graph/1", "nodes": list(nodes.values()), "edges": edges}))
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cmd, (opts, pos) = argv[0], parse(argv[1:])
    cwd = os.getcwd()
    if cmd == "emit":
        if not pos:
            print("events emit: need an EVENT", file=sys.stderr)
            return 64
        if pos[0] in GATE_OWNED:
            print("events emit: %s is a human approval or a gate's record; only its own command writes it "
                  "(aloop mission … approve / consent / record / goal / assess / evaluate; intent new)" % pos[0], file=sys.stderr)
            return 64
        try:
            eid = _events.emit(cwd, pos[0], task=opts.get("task", ""), attempt=opts.get("attempt", ""),
                               agent_id=opts.get("agent", ""), role=opts.get("role", ""),
                               parent_event_id=opts.get("parent"), caused_by=opts.get("caused_by"),
                               refs=dict(r.split("=", 1) for r in opts["ref"] if "=" in r),
                               **dict(d.split("=", 1) for d in opts["data"] if "=" in d))
        except ValueError as e:
            print("events: %s" % e, file=sys.stderr)
            return 64
        print(eid)
        return 0
    if cmd in ("authority", "decide"):
        try:
            if cmd == "authority":
                who, mode, scope = opts.get("initiated_by", ""), opts.get("mode", ""), opts.get("scope", "")
                if mode not in _events.AUTONOMY or not who or not scope:
                    raise ValueError("need --initiated-by WHO --mode %s --scope \"...\"" % "|".join(_events.AUTONOMY))
                policy = opts.get("policy", "default")
                overrides = dict(o.split("=", 1) for o in opts["override"] if "=" in o)
                try:
                    sprint, grant = _approval.grant_for(cwd, who, mode, scope, opts.get("sprint", ""), policy, overrides)
                except _mission.NeedsHuman as e:
                    print("ASK[events]: %s" % e, file=sys.stderr)
                    return 3
                eid = _events.record_authority(cwd, who, mode, scope, policy=policy, overrides=overrides,
                                               sprint=sprint, grant=grant)
                if grant:
                    print("[events] %s: the human's %s recorded (code %s)" % (
                        sprint, "plan approval" if grant["kind"] == "plan" else "grant of autonomy", _mission.code(grant["sha256"])),
                        file=sys.stderr)
            else:
                eid = _events.record_decision(cwd, pos[0] if pos else "", opts.get("reason", ""), task=opts.get("task", ""),
                                              evidence=opts["evidence"], authority_ref=opts.get("authority"),
                                              parent_event_id=opts.get("parent"), role=opts.get("role", ""))
        except ValueError as e:
            print("events %s: %s" % (cmd, e), file=sys.stderr)
            return 64
        print(eid)
        return 0
    if cmd == "approval":
        if not pos:
            print("events approval: need a SPRINT or TASK_ID", file=sys.stderr)
            return 64
        good, why = _approval.check(cwd, pos[0], opts.get("story_dir", ""), opts.get("role", ""))
        if good:
            print(why)
            return 0
        print("\n".join(why), file=sys.stderr)
        return 2
    if cmd == "query":
        for ev in _events.read(cwd):
            ids = ev.get("ids") or {}
            if opts.get("task") and ids.get("task", ev.get("task")) != opts["task"]:
                continue
            if opts.get("event") and ev.get("event") != opts["event"]:
                continue
            if opts.get("sprint") and ids.get("sprint") != opts["sprint"]:
                continue
            print(line(ev))
        return 0
    if cmd == "commit-msg":
        return commit_msg(cwd, pos[0] if pos else "")
    if cmd == "graph":
        return graph(cwd, opts.get("format", "json"))
    if cmd == "trace":
        return trace(cwd, pos[0] if pos else "")
    if cmd == "lineage":
        task = pos[0] if pos else ""
        evs = [ev for ev in _events.read(cwd) if (ev.get("ids") or {}).get("task", ev.get("task")) == task]
        if not evs:
            print("events lineage: no events for %s" % task, file=sys.stderr)
            return 1
        by_id = {ev.get("event_id"): ev for ev in evs}
        for ev in evs:
            depth, p = 0, ev.get("parent_event_id")
            while p in by_id and depth < 8:
                depth, p = depth + 1, by_id[p].get("parent_event_id")
            refs = " ".join("%s=%s" % kv for kv in sorted((ev.get("refs") or {}).items()))
            print("%s%s%s" % ("  " * depth, line(ev), ("  [" + refs + "]") if refs else ""))
        return 0
    print("events: unknown command %r" % cmd, file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
