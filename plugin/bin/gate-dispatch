#!/usr/bin/env bash
# gate-dispatch — PreToolUse(Agent|Task) on the SUPERVISOR's dispatch of an execution worker.
#
# A worker's gates read its task contract (<run-data>/state/tasks/<TASK_ID>.env), found through the
# `TASK_ID: <id>` line the dispatch prompt opens with. Dispatched before that contract exists, the
# worker's SubagentStop gate cannot find STORY_DIR and blocks on every stop — a block the worker
# cannot fix (live e2e run 6: 25 blocks). So the dispatch itself is refused until it is right. Every
# aloop role's model is checked too, and a planner waits while the newest Intent Contract has an open `ask`.
#
# Nor is anything of a sprint dispatched before the human approved its plan (ROADMAP M0.9): the
# sprint's newest grant (`events authority`, the human's typed line) must still cover the plan as it is.
#
# Only aloop execution roles, only from the main session (a sub-agent's own Agent calls carry
# agent_type), only in a repo with aloop state (.agentic/). Every host: Claude Code's Agent/Task
# (subagent_type, prompt), Codex's spawn_agent (agent_type, message), OpenCode's task and dsh's
# subagent (both through their plugins). Exit: 0 allow · 2 deny. SKIP_HOOKS=1.
set -uo pipefail
GATE_NAME=dispatch
[ "${SKIP_HOOKS:-}" = "1" ] && exit 0
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
payload="$(cat 2>/dev/null || true)"

command -v python3 >/dev/null 2>&1 || exit 0
read -r role tid model tool < <(printf '%s' "$payload" | python3 -c '
import json, re, sys
p = json.load(sys.stdin)
if p.get("agent_type"):
    print("- - - -"); sys.exit()
ti = p.get("tool_input") or {}
role = str(ti.get("subagent_type") or ti.get("agent_type") or "").split(":")[-1]   # Codex: agent_type
text = ti.get("prompt") or ti.get("message") or ""                                   # Codex: message (or items)
if not text and isinstance(ti.get("items"), list):
    text = "\n".join(str(i.get("text") or "") for i in ti["items"] if isinstance(i, dict))
m = re.match(r"\s*TASK_ID:\s*([A-Za-z0-9._-]+)", text if isinstance(text, str) else "")
model = re.sub(r"\s+", "", str(ti.get("model") or "")) or "-"
print(re.sub(r"\s+", "", role) or "-", m.group(1) if m else "-", model, re.sub(r"\s+", "", str(p.get("tool_name") or "")) or "-")' 2>/dev/null) || exit 0

case "$role" in red-worker|scaffolder|green-worker|structural-reviewer|final-gate|planner|intake|standards|archivist) ;;
  market-researcher|product-tester|state-assessor|evaluator|mission-planner|ethics-reviewer) ;;   # mission roles (§4.12)
  *) exit 0 ;; esac
# shellcheck source=/dev/null
. "$HERE/_paths.sh"
[ -d "$AGENTIC_HOME" ] || exit 0

# The model is the project's confirmed one (docs/agents/defaults.md → `aloop models resolve <role>`,
# ROADMAP §3.6), never the supervisor's pick: live e2e run 20 dispatched planners on opus and
# workers on sonnet with defaults.md saying haiku for both, and cost $2.79 instead of $0.99. A
# pinned id or a route is matched by model family (haiku / sonnet / opus), so `haiku` and
# `claude-haiku-5-5` are the same answer; an absent model would fall back to the agent file's
# default (opus for the planning roles), so it is refused too. An empty resolution (Codex: the
# session's own model) checks nothing.
# Codex's spawn_agent and OpenCode's task name no model per call: the role's agent file `aloop install`
# wrote from the same routes pins it, so there only a model the call does name is checked.
host="${AGENTIC_HOST:-}"; [ -z "$host" ] && [ "$tool" = spawn_agent ] && host=codex
want="$("$HERE/models" resolve "$role" ${host:+--host "$host"} 2>/dev/null)" || want=""
case "$host:$model" in codex:-|opencode:-) want="" ;; esac
if [ -n "$want" ]; then
  fam() { case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in *haiku*) echo haiku ;; *sonnet*) echo sonnet ;; *opus*) echo opus ;; *) echo "" ;; esac; }
  bad=0
  if [ "$model" = "-" ]; then bad=1
  elif [ "$model" != "$want" ]; then
    wf="$(fam "$want")"; mf="$(fam "$model")"
    { [ -z "$wf" ] || [ -z "$mf" ] || [ "$wf" != "$mf" ]; } && bad=1
  fi
  if [ "$bad" = 1 ]; then
    echo "BLOCK[$GATE_NAME]: dispatch $role with model: $want (the project's confirmed model for this role: \`aloop models resolve $role\`, from docs/agents/defaults.md)${model:+; this call passes $( [ "$model" = "-" ] && echo "no model, which would fall back to the agent file's default" || echo "model: $model")}." >&2
    echo "  The model per role is a project setting (confirmed at init), not a per-dispatch choice. To change it: re-run the init skill or edit .aladdin/config.yaml and \`aloop config sync\`." >&2
    exit 2
  fi
fi
# Plan only once gate-intake passes (ROADMAP §4.9): a NEEDS-HUMAN release lets the intake's stop through
# UNVERIFIED, and its notice can reach the supervisor after the planner's call (on Claude Code a PostToolUse,
# late when the intake ran in the background), so the planner is refused here while the newest Intent Contract
# has an unanswered `ask` (`intent open`, the one gate-intake judges). No contract at all is no block.
if [ "$role" = planner ]; then
  asks="$("$HERE/intent" open 2>/dev/null)"; orc=$?
  if [ "$orc" = 3 ]; then
    echo "BLOCK[$GATE_NAME]: dispatch the planner only once gate-intake passes: $asks" >&2
    echo "  Ask the human each one, then re-dispatch intake with the answers in a ### Feedback block (it records each answer)." >&2
    exit 2
  fi
fi
# Planning and mission roles have no task contract: the model check is all.
case "$role" in planner|intake|standards|archivist|market-researcher|product-tester|state-assessor|evaluator|mission-planner|ethics-reviewer) exit 0 ;; esac

if [ "$tid" = "-" ]; then
  echo "BLOCK[$GATE_NAME]: start the $role dispatch prompt with the line \`TASK_ID: <id>\` — its gates find the task contract through it." >&2
  exit 2
fi
if ! contract="$(agentic_contract_path "$tid")"; then
  echo "BLOCK[$GATE_NAME]: write the task contract before dispatching: $contract" >&2
  echo "  (TASK_ID, ATTEMPT, AGENT_ROLE=$role, STORY_DIR, SCOPE_GLOBS, BASE_REF, BUDGET_* — see the skill's \"The task contract\")" >&2
  exit 2
fi
# The contract must say WHERE the comms live: a worker whose contract has no STORY_DIR, or one
# naming a dir that does not exist, blocks on every stop (live e2e run 11: the structural
# reviewer's contract had none, since a per-wave review has no single story). A whole-wave review
# uses the sprint dir, whose init.md/output.md carry its dispatch and report blocks.
sd="$(sed -nE 's/^[[:space:]]*(export[[:space:]]+)?STORY_DIR=["'"'"']?([^"'"'"'#]*[^"'"'"'#[:space:]])["'"'"']?[[:space:]]*(#.*)?$/\2/p' "$contract" | tail -1)"
case "/$sd/" in
  */.aladdin/*|*/.agentic/*)
    # The comms live with the plan in docs/agents/sprintN/ (live e2e run 24: a haiku supervisor
    # put the whole sprint under .aladdin/sprint1/, git-ignored and never committed).
    _home="$(printf '%s' "/$sd/" | grep -oE '/\.(aladdin|agentic)/' | head -1 | tr -d /)"
    echo "BLOCK[$GATE_NAME]: STORY_DIR=$sd is in the run-data dir $_home/, which is git-ignored and never committed:" >&2
    echo "  the sprint and its story dirs live in docs/agents/sprintN/ (\`aloop layout show\`); move the sprint there and point STORY_DIR at it." >&2
    exit 2 ;;
esac
if [ -z "$sd" ] || [ ! -d "$sd" ]; then
  echo "BLOCK[$GATE_NAME]: the task contract $contract must set STORY_DIR to an existing dir${sd:+ (STORY_DIR=$sd does not exist)}:" >&2
  echo "  the ABSOLUTE path of the story's comms dir, docs/agents/sprintN/sN-NN-<slug>/ (holds init.md + output.md)." >&2
  [ "$role" = structural-reviewer ] && echo "  A structural review of a whole wave has no single story: use the sprint dir, docs/agents/sprintN/, and append its dispatch block to that dir's init.md." >&2
  exit 2
fi
# The plan is the human's (ROADMAP M0.9): the sprint's newest grant must hold now: their approval of
# exactly this plan (the typed line `approve SN <code>`), or autonomy they granted the sprint (their
# `autonomous SN <code>`, or an approved autonomous mission for its own sprints), and STORY_DIR and the task
# are of that plan (another sprint's story or an unplanned task is not covered). Before this it was a
# playbook rule, so a supervisor could dispatch workers before the human said go (2026-10-20 fact check).
if ! why="$("$HERE/events" approval "$tid" --story-dir "$sd" --role "$role" 2>&1 >/dev/null)"; then
  printf 'BLOCK[%s]: dispatch %s of %s: %s\n' "$GATE_NAME" "$role" "$tid" "${why:-the plan approval check failed}" >&2
  exit 2
fi
# A manual task worktree (`aloop task-worktree add`, the sanctioned equivalent of isolation:
# "worktree" and the Codex/OpenCode route) carries a copy of the contract: `aloop bind` checks it
# and the host binding needs it. Refreshed on every dispatch, since one task's contract changes role
# per stage (live e2e run 28: only the main-tree contract was written, RED's bind failed and its
# stop blocked twice in the shared tree).
_wt="$AGENTIC_HOME/worktrees/$tid"
if [ -f "$_wt/.git" ]; then
  _md="$(agentic_marker_dir "$_wt")" && cp "$contract" "$_md/task.env" 2>/dev/null \
    || echo "WARN[$GATE_NAME]: could not copy $contract into $_wt (aloop bind will fail)" >&2
fi
exit 0
