#!/usr/bin/env python3
"""secrets — credentials committed to the project (ROADMAP M10.2).

Acceptance proves behaviour, not safety: a test can pass with a live API key pasted into the
code. This scans for credential shapes that are near-certain on sight (private key blocks and
the fixed-prefix tokens of AWS, GitHub, GitLab, Slack, Stripe, Google, Anthropic and OpenAI).
Generic `password = "..."` heuristics are left out on purpose: a gate must not guess.
It prints `path:line: kind`, never the matched text, so the block message cannot leak it.

A line carrying `aloop: allow-secret` is skipped (a test fixture that must look like a key).

Usage:
  secrets scan [--base REF] [--root DIR]   with --base: lines added since REF (committed,
                                           staged, unstaged and untracked files);
                                           without: every tracked and untracked file.
                                           exit 2 if any credential is found
"""
import os
import re
import subprocess
import sys

KINDS = [
    ("private key", re.compile(r"-----BEGIN (?:RSA |EC |DSA |OPENSSH |ENCRYPTED |PGP )?PRIVATE KEY(?: BLOCK)?-----")),
    ("AWS access key id", re.compile(r"(?<![A-Z0-9])(?:AKIA|ASIA)[0-9A-Z]{16}(?![A-Z0-9])")),
    ("GitHub token", re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{60,})")),
    ("GitLab token", re.compile(r"\bglpat-[A-Za-z0-9_\-]{20,}")),
    ("Slack token", re.compile(r"\bxox[abposr]-[A-Za-z0-9\-]{10,}")),
    ("Stripe secret key", re.compile(r"\b[sr]k_live_[A-Za-z0-9]{20,}")),
    ("Google API key", re.compile(r"\bAIza[0-9A-Za-z_\-]{35}")),
    ("Anthropic API key", re.compile(r"\bsk-ant-[A-Za-z0-9_\-]{32,}")),
    ("OpenAI API key", re.compile(r"\bsk-(?:proj-|svcacct-)?[A-Za-z0-9_\-]{20,}T3BlbkFJ[A-Za-z0-9_\-]{20,}")),
]
ALLOW = "aloop: allow-secret"
SKIP_DIRS = ("node_modules/", "target/", ".git/", "vendor/", ".aladdin/", ".agentic/", ".venv/", "venv/")
MAX_BYTES = 1 << 20


def git(root, *args):
    r = subprocess.run(["git", "-C", root] + list(args), capture_output=True, text=True, errors="replace")
    return r.stdout if r.returncode == 0 else ""


def skipped(path):
    p = "/" + path
    return any("/" + d in p for d in SKIP_DIRS)


def read(root, path):
    full = os.path.join(root, path)
    try:
        if not os.path.isfile(full) or os.path.getsize(full) > MAX_BYTES:
            return None
        data = open(full, "rb").read()
    except OSError:
        return None
    if b"\0" in data[:8192]:
        return None
    return data.decode("utf-8", "replace")


def hits(line):
    if ALLOW in line:
        return []
    return [kind for kind, rx in KINDS if rx.search(line)]


def scan_files(root, paths):
    out = []
    for p in paths:
        text = read(root, p)
        if text is None:
            continue
        for i, line in enumerate(text.splitlines(), 1):
            out += [(p, i, k) for k in hits(line)]
    return out


def untracked(root):
    return git(root, "ls-files", "--others", "--exclude-standard").splitlines()


def scan_all(root):
    paths = sorted(set(git(root, "ls-files").splitlines() + untracked(root)))
    return scan_files(root, [p for p in paths if not skipped(p)])


HUNK = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@")


def scan_added(root, base):
    out, path, n = [], None, 0
    # the working tree against REF: committed, staged and unstaged changes in one diff
    for line in git(root, "diff", "--no-color", "--no-ext-diff", "-U0", base, "--").splitlines():
        if line.startswith("+++ "):
            path = line[6:] if line.startswith("+++ b/") else None
            if path and skipped(path):
                path = None
        elif line.startswith("@@"):
            m = HUNK.match(line)
            n = int(m.group(1)) if m else 0
        elif path and line.startswith("+"):
            out += [(path, n, k) for k in hits(line[1:])]
            n += 1
    return out + scan_files(root, [p for p in untracked(root) if not skipped(p)])


def main(argv):
    if not argv or argv[0] != "scan":
        print(__doc__, file=sys.stderr)
        return 64
    opts = dict(zip(argv[1::2], argv[2::2]))
    root = opts.get("--root") or os.getcwd()
    found = scan_added(root, opts["--base"]) if opts.get("--base") else scan_all(root)
    for p, i, k in found:
        print("%s:%d: %s" % (p, i, k))
    return 2 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
