#!/usr/bin/env bash
# RED gate: every NEW test fails BY ASSERTION (not compile error), none regressed,
# diff touches only test + shim files, output.md validates. (Target: Rust.)
GATE_NAME="gate-red-verify"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
: "${CLAUDE_PLUGIN_ROOT:=$(cd "$HERE/.." && pwd)}"
# shellcheck source=/dev/null
source "$HERE/_gatelib.sh"

# 0) Worktree isolation (invariant): this worker must run in a linked worktree.
assert_worktree_isolation
assert_work_committed

# 1) output.md / init.md structure.
validate_comms

# 2) Parse the LATEST output.md block's Result table: no NEW test (`::` Check) may be
#    PASS; >=1 FAIL. validate_comms already proved the block exists and is this dispatch's.
block="$(latest_block "${STORY_DIR:-}/output.md")"
test_rows="$(printf '%s\n' "$block" | grep -E '^\|.*::.*\|' || true)"
if [ -n "$test_rows" ]; then
  if printf '%s\n' "$test_rows" | grep -qiE '\|[[:space:]]*PASS[[:space:]]*\|'; then
    fail "a NEW test PASSED in RED (test exercises nothing) — latest output.md block has a PASS row"
  fi
  printf '%s\n' "$test_rows" | grep -qiE '\|[[:space:]]*FAIL[[:space:]]*\|' \
    || fail "no FAILing test row in the latest output.md block — RED produced no failing test"
else
  warn "latest output.md block has no recognizable test rows (path::fn); relying on cargo run"
fi
if printf '%s\n' "$block" | grep -qiE 'regressed=[1-9]'; then
  fail "RED regressed a previously-passing test (regressed>0 in latest output.md block)"
fi

# 3) Diff scope: only test files + shim module.
: "${TEST_GLOBS:=*/tests/*.rs tests/*.rs */tests/common/*.rs tests/common/*.rs **/tests/**}"
while IFS= read -r p; do
  [ -z "$p" ] && continue
  path_matches_any "$p" "$TEST_GLOBS" \
    || fail "RED diff touches a non-test path: $p (allowed: $TEST_GLOBS)"
done < <(changed_paths)

# 3b) Format: RED's files must pass the matrix's format check (GREEN may not reformat them).
run_format_checks

# 4) Fail-by-assertion: tests must COMPILE against shims, then FAIL.
if [ "${GATE_RUN_TESTS:-auto}" != "0" ] && is_cargo_repo; then
  root="$(repo_dir)"
  note "compiling tests (must succeed against mod-common shims)"
  ( cd "$root" && cargo test --no-run --workspace ) \
    || fail "RED tests do NOT compile — they fail by missing symbol, not by assertion (add mod-common shims)"
  note "running tests (must fail by assertion)"
  if ( cd "$root" && cargo test --workspace >/dev/null 2>&1 ); then
    fail "RED tests PASS with no production code — they exercise nothing"
  fi
  note "RED verified: compiles, fails by assertion"
else
  warn "cargo run skipped; fail-by-assertion not dynamically verified"
fi

exit 0
