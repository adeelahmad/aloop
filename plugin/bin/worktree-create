#!/usr/bin/env bash
# worktree-create — OPTIONAL git-worktree helper for `isolation: "worktree"`.
# Plain git repos are handled by the harness's BUILT-IN worktree isolation; you do NOT
# need this. It exists for a non-git VCS (or an env where the built-in can't create a
# worktree): wire it into your USER settings.json as a `WorktreeCreate` hook
# (WorktreeCreate/WorktreeRemove are settings.json-only — NOT valid in a plugin manifest).
#
# Contract (official): stdin = JSON { cwd, base_path, isolation_name, ... }. The hook
# MUST create the worktree and print its absolute path on STDOUT (nothing else), exit 0.
# Exit 2 blocks the dispatch (stderr shown). git's own chatter is sent to stderr so
# STDOUT stays a single clean path. Idempotent: an existing worktree at the target path
# is reused (lets a task's RED → SCAFFOLD → GREEN share one worktree).
#
# Worktrees are ALWAYS anchored to the MAIN working tree, never the dispatch `cwd` — a
# dispatch from inside a worktree must NOT nest a worktree under it
# (…/worktrees/A/.agentic/worktrees/B/…), which compounds and breaks consolidation.
set -uo pipefail

payload="$(cat 2>/dev/null || true)"
jstr() { printf '%s' "$payload" | sed -nE "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"([^\"]+)\".*/\1/p" | head -1; }

cwd="$(jstr cwd)";             [ -n "$cwd" ]  || cwd="$PWD"
name="$(jstr isolation_name)"; [ -n "$name" ] || name="$(jstr name)"
[ -n "$name" ] || name="iso"

git -C "$cwd" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  echo "WorktreeCreate: '$cwd' is not a git repository — run 'git init && git add -A && git commit -m init' first." >&2
  exit 2
}

# Resolve the MAIN working tree: the first entry of `git worktree list` is always the
# main tree, regardless of which (possibly nested) worktree `cwd` points at. ALL agentic
# worktrees become flat siblings under it — never nested.
main="$(git -C "$cwd" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | head -1)"
[ -n "$main" ] || main="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)"
[ -n "$main" ] || main="$cwd"

git -C "$main" rev-parse HEAD >/dev/null 2>&1 || {
  echo "WorktreeCreate: '$main' has no commits — make an initial commit before execution (it is the worktree base ref)." >&2
  exit 2
}

# the run-data dir (mirrors bin/_paths.sh agentic_home_name; this script has its own $main):
# .aladdin/ (ROADMAP M1), or the legacy .agentic/ until `aloop layout migrate`
aloop_home() {
  local p="$1" d
  for d in transcripts budget ledger logs state host worktrees; do [ -d "$p/.aladdin/$d" ] && { printf '%s\n' "$p/.aladdin"; return 0; }; done
  if [ -d "$p/.agentic" ]; then printf '%s\n' "$p/.agentic"; else printf '%s\n' "$p/.aladdin"; fi
}
aloop_home_guard() {   # .aladdin/.gitignore: config.yaml is committed, run data never is
  case "$1" in */.aladdin) [ -f "$1/.gitignore" ] || printf '%s\n' '# aloop run data (transcripts, budgets, ledger, logs, state) — never committed' '*' '!.gitignore' '!config.yaml' > "$1/.gitignore" 2>/dev/null || true ;; esac
}
home="$(aloop_home "$main")"
base="$home/worktrees"   # always under the MAIN tree (git-ignored, flat)
safe="$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//;s/-*$//')"
[ -n "$safe" ] || safe="iso"
path="$base/$safe"
branch="agentic/$safe"

mkdir -p "$base" 2>/dev/null || true

aloop_home_guard "$home"

# Idempotent reuse: a worktree already at this path is returned as-is. (The
# sparse-checkout / .gitignore hygiene below runs only on FRESH creation here — a
# reused worktree relies on bin/worktree-hygiene's SubagentStart hook to re-apply it.)
if [ -e "$path/.git" ]; then printf '%s\n' "$path"; exit 0; fi

# Create off the MAIN tree's HEAD (the integration ref). Reuse the branch if a prior
# attempt left it behind.
if git -C "$main" show-ref --quiet --verify "refs/heads/$branch"; then
  git -C "$main" worktree add "$path" "$branch" 1>&2 || true
else
  git -C "$main" worktree add -b "$branch" "$path" 1>&2 || true
fi
# Last resort: a detached worktree at HEAD.
[ -e "$path/.git" ] || git -C "$main" worktree add --detach "$path" 1>&2 || true

if [ -e "$path/.git" ]; then
  # Workers reach docs/agents/** via the absolute STORY_DIR path back into $main (see
  # bin/_gatelib.sh) — never their own worktree's copy. Sparse-checkout drops the
  # redundant, would-go-stale checkout of that tree from THIS worktree only (per-worktree
  # config; $main and sibling worktrees are untouched). Best-effort: an older git without
  # `sparse-checkout` just leaves the full checkout in place. If sparse-checkout was
  # somehow already configured here, merge our exclusion in rather than clobber it.
  sc_file="$(git -C "$path" rev-parse --git-path info/sparse-checkout 2>/dev/null)"
  if [ -n "$sc_file" ] && [ -s "$sc_file" ]; then
    if ! grep -qxF '!/docs/agents/' "$sc_file" 2>/dev/null; then
      { cat "$sc_file" 2>/dev/null; printf '%s\n' '!/docs/agents/'; } > "$sc_file.new" 2>/dev/null \
        && mv "$sc_file.new" "$sc_file" 2>/dev/null || true
      git -C "$path" sparse-checkout reapply >/dev/null 2>&1 || true
    fi
  else
    git -C "$path" sparse-checkout init --no-cone >/dev/null 2>&1 \
      && git -C "$path" sparse-checkout set '/*' '!/docs/agents/' >/dev/null 2>&1 || true
  fi

  # .gitignore bootstrap on $main, idempotent — a no-op check once the entries exist.
  # Locked so two concurrent WorktreeCreate dispatches can't both append (mkdir is
  # atomic; a plain grep-then-append check-then-act is not); only taken when something's
  # actually missing, so steady-state calls never pay for it.
  gi="$main/.gitignore"
  touch "$gi" 2>/dev/null || true
  need=0
  for pattern in '.agentic/' '.transcripts/'; do
    grep -qxF "$pattern" "$gi" 2>/dev/null || need=1
  done
  if [ "$need" = 1 ]; then
    lockdir="$home/.gitignore.lock"
    mkdir -p "$(dirname "$lockdir")" 2>/dev/null || true
    tries=0
    while ! mkdir "$lockdir" 2>/dev/null; do
      tries=$((tries + 1)); [ "$tries" -ge 20 ] && break
      sleep 0.1 2>/dev/null || sleep 1
    done
    for pattern in '.agentic/' '.transcripts/'; do
      grep -qxF "$pattern" "$gi" 2>/dev/null || printf '%s\n' "$pattern" >> "$gi" 2>/dev/null || true
    done
    rmdir "$lockdir" 2>/dev/null || true
  fi

  printf '%s\n' "$path"; exit 0
fi
echo "WorktreeCreate: failed to create a git worktree at '$path'." >&2
exit 2
