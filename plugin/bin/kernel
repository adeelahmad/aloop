#!/usr/bin/env python3
"""kernel (aloop kernel) — kernel extensions and the project's profile (ROADMAP M12.7, M12.8).

  aloop kernel list                 installed extensions (~/.aloop/kernel/) and what this project pins
  aloop kernel pin <name>           load <name> in this project, pinned to its current sha256
                                    (docs/agents/userspace/profile.json, in git); re-run after a change
  aloop kernel unpin <name>         stop loading it
  aloop kernel profile [<name>]     show or set the profile (default: software, the TDD loop)
  aloop kernel run <event> [--role R]   run the pinned extensions for an event by hand
                                        (SubagentStop, Stop); stdin is the hook payload
  aloop kernel hook                 the hook entry (SubagentStop, Stop): reads the payload, runs them

An extension adds checks; it never removes or weakens a core gate (it runs beside them, and its pass
decides only itself). A pinned extension that is missing, changed, crashes or times out blocks.
"""
import json
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import _kernel as K  # noqa: E402


def main(argv):
    cwd = os.getcwd()
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, rest = argv[0], argv[1:]
    try:
        if cmd == "list":
            prof = K.profile(cwd)
            print("profile: %s" % prof["profile"])
            names = sorted(set(K.installed()) | set(prof["extensions"]))
            for n in names:
                pinned = prof["extensions"].get(n)
                actual = K.module_sha(n)
                state = ("not pinned" if not pinned else "missing" if actual is None
                         else "pinned" if actual == pinned else "CHANGED since pin")
                print("%-24s %-18s %s" % (n, state, (actual or "")[:12]))
            if not names:
                print("no kernel extensions (install one into %s/<name>/)" % K.kernel_dir())
            return 0
        if cmd in ("pin", "unpin"):
            if len(rest) != 1:
                print("usage: aloop kernel %s <name>" % cmd, file=sys.stderr)
                return 64
            if cmd == "pin":
                print("pinned %s %s" % (rest[0], K.pin(cwd, rest[0])[:12]))
            else:
                K.unpin(cwd, rest[0])
                print("unpinned " + rest[0])
            return 0
        if cmd == "profile":
            p = K.profile(cwd)
            if rest:
                if not K.NAME.match(rest[0]):
                    raise ValueError("bad profile name %r" % rest[0])
                p["profile"] = rest[0]
                K.save_profile(cwd, p)
            print(p["profile"])
            return 0
        if cmd in ("run", "hook"):
            payload = "" if sys.stdin.isatty() else sys.stdin.read()
            if cmd == "run":
                if not rest:
                    print("usage: aloop kernel run <event> [--role R]", file=sys.stderr)
                    return 64
                event = rest[0]
                role = rest[rest.index("--role") + 1] if "--role" in rest[:-1] else ""
            else:
                if os.environ.get("SKIP_HOOKS") == "1":
                    return 0                     # the same escape hatch every core gate honors
                try:
                    p = json.loads(payload) if payload.strip() else {}
                except ValueError:
                    p = {}
                p = p if isinstance(p, dict) else {}
                if isinstance(p.get("cwd"), str) and os.path.isdir(p["cwd"]):
                    cwd = p["cwd"]
                    os.chdir(cwd)
                event = str(p.get("hook_event_name") or "SubagentStop")
                role = str(p.get("agent_type") or "").split(":")[-1]
            code, reasons = K.run(cwd, event, role, payload)
            for r in reasons:
                print("BLOCK[kernel]: " + r, file=sys.stderr)
            return code
    except ValueError as e:
        print("kernel: %s" % e, file=sys.stderr)
        return 64
    print("kernel: unknown command %r (aloop kernel --help)" % cmd, file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
