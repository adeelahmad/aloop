DEPTH = 8                                             # nested shell strings read before giving up
# a find is judged once per start path for each -exec word, and a word climbing out of {} once per depth: past these
# bounds (no real find comes near) it is blocked, so its judging stays linear in the command's length
FIND_WORK, CLIMB = 100000, 32
GIT_ASKS = 16                                         # distinct `git ls-files` asks one call makes (git_untracked)
TRANSCRIPT_HOOKS = {"prompt", "record", "snapshot", "stop", "stage-in"}
# the hosts, and their subcommands that start no session (any other word is a prompt or a session)
HOSTS = {"claude": {"plugin", "plugins", "mcp", "config", "doctor", "update", "install", "migrate-installer",
                    "setup-token"},
         "codex": {"login", "logout", "mcp", "completion", "debug", "apply", "a", "help", "features"},
         "opencode": {"auth", "models", "upgrade", "mcp", "agent", "github", "stats", "export", "import",
                      "uninstall", "debug", "help"},
         "dsh": {"plugin"}}                           # dsh's first word is a profile to boot (aloop, headless…)


class Block(Exception):
    pass


# ── values: a word resolved as far as the gate can, a list of str and None (unknown) ─────
def text(v):
    return "".join(v) if v is not None and None not in v else None


def prefix(v):
    out = []
    for p in v or []:
        if p is None:
            break
        out.append(p)
    return "".join(out)


def basename(v):
    """The command name even when its directory is unknown ("$(aloop --root)/bin/mission")."""
    t = text(v)
    if t is not None:
        return os.path.basename(t)
    last = v[-1] if v else None
    return os.path.basename(last) if last and "/" in last else None


def tail(v, n):
    """The word `v` after its first n characters (all inside its known start)."""
    out = list(v)
    while n and out:
        if len(out[0]) <= n:
            n -= len(out.pop(0))
        else:
            out[0], n = out[0][n:], 0
    return out


def optlike(v):
    """An option word, also one whose value is known only at run time (`-t"$D"`, `--dir=$D`)."""
    a = text(v)
    if a is not None:
        return a.startswith("-") and a != "-"
    pre = prefix(v)
    return pre.startswith("--") and "=" in pre or not pre.startswith("--") and len(pre) >= 2 and pre[0] == "-"


class Match(list):
    """A find -exec {} word: a match under a start path, which find's -name tests bound (`tests`, [] for none)."""

    def __init__(self, parts, tests):
        super().__init__(parts)
        self.tests = tests


def opts(args, value="", long_value=(), words=False):
    """(index of the first operand, {option: value}) for GNU-style options. `value` names the
    short options that take a value (attached or the next word); `long_value` the long ones.
    A value is its text (None when unknown), or with `words` the word itself, so a computed
    one is still judged by its known start."""
    found, i = {}, 0
    val = (lambda w: w) if words else text
    while i < len(args):
        if not optlike(args[i]):
            break
        a = text(args[i])
        if a == "--":
            i += 1
            break
        a = prefix(args[i]) if a is None else a           # an unknown value after the known option
        if a.startswith("--"):
            k, eq, v = a.partition("=")
            v = val(tail(args[i], len(k) + 1) or [""])
            if not eq and k in long_value and i + 1 < len(args):
                i += 1
                v = val(args[i])
            found[k] = v if eq or k in long_value else True
            i += 1
            continue
        j = 1
        while j < len(a):
            ch = a[j]
            if ch in value:
                rest = tail(args[i], j + 1)
                if not rest and i + 1 < len(args):
                    i += 1
                    rest = args[i]
                found["-" + ch] = val(rest or [""])
                break
            found["-" + ch] = True
            j += 1
        i += 1
    return i, found


def operands(args, value="", long_value=(), words=False):
    """(the non-option words, {option: value}), options anywhere (GNU order)."""
    out, found, i = [], {}, 0
    while i < len(args):
        if optlike(args[i]):
            if text(args[i]) == "--":
                out += args[i + 1:]
                break
            j, f = opts(args[i:], value, long_value, words)
            found.update(f)
            i += max(j, 1)
            continue
        out.append(args[i])
        i += 1
    return out, found


# ── the rules ──────────────────────────────────────────────────────────────────────
class Scope:
    def __init__(self, R, payload, project):
        self.R = R
        self.agent_type = payload.get("agent_type") or ""
        self.role = R.role_of(self.agent_type)
        self.main = os.path.realpath(project)
        self.roots = R.roots(project)
        self.who = self.role or self.agent_type
        self.seen = {}                                    # what the disk and git said, asked once per call

    def path(self, target, base, what, bare=False, tree=None, extract=False):
        """Raise Block when writing `target` is not this caller's to do. `bare`: the command may name
        docs/agents/mission itself (mkdir, touch). `tree`: it removes everything under `target`
        (rm -r, find -delete, a moved dir), bounded by find's -name tests when it has some. `extract`:
        it unpacks an archive into `target` (an archive's top-level mission/ lands in docs/agents/)."""
        R = self.R
        if not target or target == "-" or (base is None and not target.startswith(("/", "~"))):
            return                                        # stdout, or a dir the gate cannot know
        root, rel = R.locate(target, base or "/", self.roots)
        if rel is None:
            return                                        # outside the project: a scratch dir
        in_mission = R.under(rel, R.MISSION)
        # an ancestor of the mission dir: "." is one in the main tree and in a dispatched agent's worktree (the
        # supervisor removing a whole task worktree is its cleanup, not a write of the mission dir)
        above = R.MISSION.startswith(rel + "/") or rel == "." and (root == self.main or bool(self.agent_type))
        whole = tree is not None and above and self.reaches(root, rel, tree)   # the mission dir goes with it
        over = extract and rel == os.path.dirname(R.MISSION.rstrip("/"))       # an archive's mission/ lands over it
        if R.is_prompt_log(rel):
            raise Block("%s holds the human's captured prompts: only the UserPromptSubmit hook writes it, and a mission"
                        " grant is read from the human's own words there (M9.17). Never a %s by %s."
                        % (rel, what, self.who or "the supervisor"))
        if rel == R.LEDGER:
            raise Block(self.ledger_advice(root, rel, what))
        if self.role in R.ROLES:
            if R.is_run_data(rel) and not R.is_harness_state(rel):
                return
            if root == self.main and any(R.under(rel, p) for p in R.writes(self.role)):
                return
            own = R.owners(rel)
            where = ("the event log or the gates' state (the harness's)" if R.is_run_data(rel) else
                     "a task worktree" if root != self.main else
                     "another role's artifacts (%s)" % ", ".join(own) if own else
                     "the mission itself (the human's, sealed by `mission approve`)" if in_mission else
                     "Aladdin's planning docs" if R.under(rel, "docs/agents/") else "source")
            raise Block("%s writes only %s (plus run data, or a scratch dir outside the project); this %s is %s:\n"
                        "    %s\n  A grader never builds: the mission roles never write source, and each writes only its own"
                        " artifacts.\n  If the work needs a change there, say so in your artifact: its owner is dispatched for it."
                        % (self.role, ", ".join("`%s`" % p for p in R.writes(self.role)), what, where, rel))
        if whole or over:
            raise Block("this %s by %s %s %s, docs/agents/mission/ with it (the ledger and every role's artifacts):\n"
                        "    %s\n  Only the mission CLI and the six mission roles write there (ROADMAP §4.12).%s"
                        % (what, self.who or "the supervisor", "removes everything under" if whole else
                           "extracts an archive into its parent, where a mission/ in it lands over", rel, rel,
                           "" if self.agent_type else
                           "\n  (Deliberate out-of-band edit outside the loop? Re-run with SKIP_HOOKS=1.)"))
        if self.agent_type:
            if in_mission:
                raise Block("%s may not write the mission layer's artifacts (%s):\n    %s\n  A builder never grades its own"
                            " work: docs/agents/mission/ is written only by the six mission roles (ROADMAP §4.12)."
                            % (self.who, what, rel))
            return
        if in_mission and rel != R.MISSION + "mission.json" and not (bare and rel == R.MISSION.rstrip("/")):
            own = R.owners(rel)                           # the supervisor
            raise Block("the supervisor never hand-writes a mission role's artifact (%s):\n    %s\n  Dispatch %s: it writes"
                        " it, and its stop gate checks it. You run `aloop mission tick` and dispatch (ROADMAP §4.12).\n"
                        "  (Deliberate out-of-band edit outside the loop? Re-run with SKIP_HOOKS=1.)"
                        % (what, rel, " or ".join("`%s`" % o for o in own) if own else "the role that owns it"))

    def ledger_advice(self, root, rel, what):
        """Why the ledger is no one's to write, and how a damage no gate saw is undone in this layout. Each
        row is chained to the one before and the run log keeps every row's event, so `mission check` fails on
        a forged or edited line and on a lost one alike: a fix keeps every row the CLI appended (real-areas F9)."""
        import _paths
        head = "%s is the mission's ledger: only `aloop mission …` commands append to it (each row is chained to the one" \
               " before), never a %s by %s.\n  This write was blocked, so the ledger is as it was: leave it (a checkout" \
               " would drop the rows appended since its last commit, and `mission check` fails on each lost row)." \
               % (rel, what, self.who or "the supervisor")
        if _paths._git(root, "ls-files", "--", rel):
            return head + ("\n  Only if `aloop mission check` names a damaged line (a write no gate saw): `git diff HEAD --"
                           " %s` shows what changed since its last commit. When that is only the damage, `git checkout"
                           " HEAD -- %s` puts it back; when the CLI appended rows since, only the human repairs it,"
                           " outside the loop (SKIP_HOOKS=1): delete each forged line and put each edited one back from"
                           " `git show HEAD:%s`, keeping every other row." % (rel, rel, rel))
        return head + ("\n  Only if `aloop mission check` names a damaged line (a write no gate saw): docs/agents/ is not"
                       " tracked, so git holds no copy of it and only the human repairs it, outside the loop"
                       " (SKIP_HOOKS=1): delete each forged line and put each edited one back from a copy, keeping every"
                       " other row (a deleted CLI row fails the check too).")

    def reaches(self, root, rel, names):
        """Does a removal of `rel` (an ancestor of the mission dir) reach it? Unbounded, always; bounded by
        find's -name tests ((pattern, ignore case), all must match), when the mission dir, a dir between it
        and `rel`, or an entry under it matches them now (a matched dir is removed with all it holds)."""
        if not names:
            return True
        key = ("reaches", root, rel, tuple(names))
        if key not in self.seen:
            if ("walk", root) not in self.seen:
                self.seen[("walk", root)] = [f for _, dirs, files in os.walk(os.path.join(root, self.R.MISSION))
                                             for f in dirs + files]

            def hit(f):
                return all(fnmatch.fnmatchcase(f.lower() if i else f, p.lower() if i else p) for p, i in names)
            parts = self.R.MISSION.rstrip("/").split("/")
            self.seen[key] = any(hit(f) for f in parts[0 if rel == "." else len(rel.split("/")) - 1:]
                                 + self.seen[("walk", root)])
        return self.seen[key]

    def write(self, v, base, what, bare=False, tree=None, extract=False, removes=False):
        """Judge a written word: all of it when known, else the directory its known start names. A find
        {} match that is removed (`removes`, or a `tree`) reaches only what find's tests let it."""
        if isinstance(v, Match) and (tree is not None or removes):
            tree = v.tests
        t = text(v)
        if t is None:
            pre = prefix(v)
            t = pre[:pre.rfind("/") + 1] if "/" in pre else ""
        if t:
            self.path(os.path.expanduser(t), base, what, bare, tree, extract)

    def mission_cli(self, args):
        R = self.R
        if args is None or not self.agent_type:
            return                                        # the supervisor relays the human (M9.17 binds approvals)
        ts = [text(a) for a in args]
        cmd = ts[0] if ts else ""
        verbs = [a for a in ts[1:] if a is not None and not a.startswith("-")]
        sub = verbs[0] if verbs and cmd not in LOOP else ""
        if cmd in LOOP or sub in R.HUMAN_VERBS:
            raise Block("`mission %s` is not a dispatched agent's to run: approvals, confirmations, consents and vetoes are"
                        " the human's, and the loop (init, tick, cron) is the supervisor's.\n  If the loop needs the"
                        " human, say so in your artifact: the supervisor asks them." % " ".join(t or "…" for t in ts[:2]))
        if self.role in R.ROLES:
            return
        if not ts or cmd in R.READ_ONLY or sub in R.READ_ONLY or (cmd and not sub and ts[1:] and set(ts[1:]) <= {"--help", "-h"}):
            return                                        # a bare area runs (`mission evaluate` writes a report)
        raise Block("%s may run only the read-only mission commands (status, show, check, list, diff, --help), not:\n"
                    "    mission %s\n  The mission layer's artifacts are written only by the six mission roles."
                    % (self.who, " ".join(t or "…" for t in ts)))

    def events_cli(self, args):
        """`events authority` is the human's authority record, and an event or decision with role `human` (or
        a human decision's type) is the human's word: none is a dispatched agent's to record."""
        if not self.agent_type:
            return
        ts = [text(a) for a in args]
        opt, pos, k = {}, [], None
        for t in ts[1:]:                                  # as bin/events parses: `--key value`
            if k:
                opt[k], k = t, None
            elif t is not None and t.startswith("--"):
                k = t[2:].replace("-", "_")
            else:
                pos.append(t)
        cmd, event, role = (ts[0] if ts else ""), (pos[0] if pos else ""), opt.get("role", "")
        as_human = role is None or role.strip().lower() == "human"
        if cmd == "emit" and event and event.split(".")[0] in self.R.MISSION_EVENTS:
            raise Block("`events emit %s` is not a dispatched agent's to run: the mission layer's events (%s.*) are"
                        " written only by its own commands (`aloop mission …`) and its gates, so a hand-written one"
                        " would pass for theirs." % (event, event.split(".")[0]))
        if cmd == "emit" and event and event.startswith("intent."):
            raise Block("`events emit %s` is not a dispatched agent's to run: intake's events are written only by"
                        " `intent new` and `intent check`, so a hand-written one would pass an intent as checked." % event)
        human = (cmd == "authority" or cmd == "decide" and as_human or
                 cmd == "emit" and (as_human or event is None or event in self.R.M.HUMAN_EVENTS + HUMAN_TYPES
                                    or event.startswith("human.")))
        if human:
            raise Block("`events %s` is not a dispatched agent's to run: the authority record, an event with role `human`"
                        " and a human decision (%s) are the human's word.\n  If the run needs the human, say so in your"
                        " final message: the supervisor asks them."
                        % (" ".join(t or "…" for t in ts[:2]), ", ".join(sorted(self.R.M.HUMAN_EVENTS))))

    def transcripts_cli(self, args):
        """`transcripts prompt|record|…` are the hooks' own commands (they read the hook payload on stdin)."""
        sub = text(args[0]) if args else ""
        if sub is None or sub in TRANSCRIPT_HOOKS:
            raise Block("`transcripts %s` is a hook's own command (UserPromptSubmit, PostToolUse, Stop), never a tool"
                        " call's: the prompts it captures are the human's own words, which a mission grant reads (M9.17)."
                        % (sub or "…"))

    def host(self, name, args):
        """A host session started from a tool call (`claude -p`, `codex exec`, `opencode run`, `dsh`) fires its own
        UserPromptSubmit hook, so its prompt would be captured as the human's words (M9.17)."""
        if self.role not in self.R.ROLES and not os.path.isdir(os.path.join(self.main, self.R.MISSION)):
            return                                        # no mission here: no grant to forge
        ts = [text(a) for a in args]
        if ts and all(t in ("--version", "-v", "-V", "--help", "-h") for t in ts):
            return
        pos = [t for t in ts if t is None or not t.startswith("-")]
        if pos and pos[0] in HOSTS[name]:
            return                                        # a tool of the host (plugin validate, mcp list), no session
        raise Block("%s starts a %s session from a tool call: its prompt fires the UserPromptSubmit hook and would be"
                    " captured as the human's own words, which a mission grant reads (M9.17).\n  A role never starts"
                    " another agent; a session the human wants runs from their own terminal or the mission's cron line."
                    % (self.who or "the supervisor", name))

    def intents_cli(self, cli, args):
        """`intent new` and `aladdin [run] "<intent>"` create an Aladdin intent (docs/agents/intents/), and
        `intent check|normalize` runs intake on one (emitting its intent.normalized): only the mission-planner
        does that among the roles; the rest would skip it and the ethics review, or pass an edit of the human's
        intent as intake's. `aladdin <tool>` that execs an aloop tool reaches here as that tool (command())."""
        if self.role not in self.R.ROLES or self.role == "mission-planner":
            return                                        # the planner owns intents; a builder/supervisor is not a role
        pos = [text(a) for a in args if not (text(a) or "").startswith("-")]
        a0 = text(args[0]) if args else ""
        if cli == "aladdin":                              # bin/aladdin's own words; anything else is the intent itself
            if not args or a0 in ALADDIN_READS or (a0 == "run" and len(pos) < 2):
                return                                    # a read verb, or `aladdin run` of the pending intent
            if a0 is not None and a0 != "run" and (a0.startswith("-") or "/" in a0):
                return                                    # an unknown option or tool: aladdin refuses it (exit 64)
            what = "`aladdin%s` hands a goal to Aladdin" % (" " + a0 if a0 else "")
        elif a0 in INTENT_READS or not args:
            return
        else:
            what = "`intent %s` %s" % (a0 or "…", "records a goal for Aladdin" if a0 == "new" else
                                       "runs intake on an intent (its intent.normalized)")
        raise Block("%s does not create or check Aladdin intents: %s, skipping the mission-planner and the ethics"
                    " review.\n  Only the mission-planner turns a gap into a goal and its intents (ROADMAP §4.12); say"
                    " the gap in your artifact and it is dispatched." % (self.who, what))

    def judge_env(self, names):
        """A mission role or a builder may not set the judge command (or its time box): the command it
        picks could grade its own work (M9.42). The evaluator runs the pinned `mission judge run`."""
        if not self.agent_type:
            return                                        # the supervisor sets it, outside the loop
        for n in names:
            if n in JUDGE_NAMES:
                raise Block("%s may not set %s in a Bash command: the judge command a role picks could grade its own"
                            " work (M9.42). The evaluator runs the pinned `aloop mission judge run`; the supervisor sets"
                            " the judge command, outside the loop." % (self.who, n))

    def judge_code(self, s):
        """A script string run through bash -c or an interpreter: setting the judge command there (an assignment,
        an env mapping, putenv…), or its `$` expansion in a shell string, is out of a role's and a builder's
        hands. Naming it as data (a grep pattern, a string compared, a quoted heredoc's text) is not."""
        if self.agent_type and s and JUDGE_SET.search(heredoc_free(s)):
            raise Block("%s may not set %s through a script string: a role's judge command could grade its own work"
                        " (M9.42). The evaluator runs the pinned `aloop mission judge run`; the supervisor sets the judge"
                        " command, outside the loop." % (self.who, "ALOOP_JUDGE_CMD / ALOOP_JUDGE_TIMEOUT"))

    def git(self, args, st, base, depth):
        """Judge a git command: a mission role never writes the project's repo, a builder never writes
        docs/agents/mission/ through a pathspec, the supervisor never removes it (git rm|mv, or a clean or
        stash -u that takes its untracked files), and bisect/rebase/submodule run their command too."""
        d, i, wt = base, 0, None
        while i < len(args):
            a = text(args[i])
            if a is None or not a.startswith("-"):
                break
            if a in ("-C", "--git-dir", "--work-tree") and i + 1 < len(args):
                v = text(args[i + 1])
                if a == "-C":
                    d = os.path.join(d or "/", os.path.expanduser(v)) if v is not None else None  # absolute v ignores d
                else:
                    wt = os.path.join(d or "/", v) if v is not None else None
                i += 2
            elif a.startswith(("--git-dir=", "--work-tree=")):
                v = a.split("=", 1)[1]
                wt = os.path.join(d or "/", v)
                i += 1
            elif a in ("-c", "--namespace", "--exec-path", "--config-env", "--super-prefix") and i + 1 < len(args):
                i += 2
            else:
                i += 1
        sub = text(args[i]) if i < len(args) else ""
        rest = args[i + 1:]
        where = wt or d
        if sub == "clone":
            ops, _ = operands(rest, "bocju", ("--branch", "--origin", "--upload-pack", "--depth", "--reference",
                                               "--separate-git-dir", "--config", "--template", "--jobs", "--filter",
                                               "--shallow-since", "--shallow-exclude", "--server-option"))
            if len(ops) >= 2:
                self.write(ops[1], d, "git clone")
            elif ops and text(ops[0]):
                self.write([re.sub(r"\.git$", "", os.path.basename(text(ops[0]).rstrip("/")))], d, "git clone")
            return
        if sub in ("format-patch", "archive", "bundle", "init", "merge-file"):
            self.git_output(sub, rest, d)                 # a file or dir git writes, judged by the caller's rules
            return
        self.git_subcmd(sub, rest, st, where, depth)      # bisect run / rebase -x / submodule foreach: a command too
        if self.role in self.R.ROLES:
            if git_write(sub, [text(a) for a in rest]):
                root, rel = (None, None) if where is None else self.R.locate(where, "/", self.roots)
                if where is not None and root is not None and not self.R.is_run_data(rel):
                    raise Block("%s never runs `git %s` in the project: a mission role writes only its own artifacts,"
                                " and committing them is the supervisor's call outside the loop." % (self.role, sub))
            return
        if sub in ("clean", "stash") and where is not None:
            self.git_untracked(sub, rest, where)
        if sub in GIT_PATHS and (self.agent_type or sub in ("rm", "mv")):
            top = self.R.locate(where, "/", self.roots)[0] if where is not None else None
            for v, from_top, tree in git_pathspecs(sub, rest, where):   # a pathspec into docs/agents/mission/
                self.write(v, top if from_top else where, "git %s" % sub, tree=tree)

    def git_untracked(self, sub, rest, where):
        """`git clean` and `git stash -u|-a` delete untracked files (with -x/-a, ignored ones too) under their
        pathspecs (clean: from the cwd down): blocked when docs/agents/mission/'s files are among them, as when
        docs/agents/ is untracked, or ignored as in the default layout (ls-files says which, in that tree)."""
        R = self.R
        ts = [text(a) for a in rest]
        flags = {t.split("=", 1)[0] for t in ts if t and t.startswith("--")}
        short = "".join(t[1:] for t in ts if t and t.startswith("-") and not t.startswith("--"))
        ops, f = operands(rest, "em", ("--exclude", "--message", "--pathspec-from-file"), words=True)
        if sub == "clean":
            if "--dry-run" in flags or "--interactive" in flags or "n" in short or "i" in short:
                return
            ls = ["-i", "--exclude-standard"] if "X" in short else [] if "x" in short else ["--exclude-standard"]
            ls += ["--exclude=" + t for t in (text(v) for k, v in f.items() if k in ("-e", "--exclude")) if t]
            specs = ops or [["."]]
        else:
            verb = text(ops[0]) if ops else None
            if verb not in (None, "push") or not ({"--all", "--include-untracked"} & flags or set("au") & set(short)):
                return                                    # list/show/pop/…, or no untracked files taken
            ls = [] if "--all" in flags or "a" in short else ["--exclude-standard"]
            specs = ops[1:] or [[":/"]]
        top = R.locate(where, "/", self.roots)[0]
        for v in specs:
            p = pathspec(text(v)) if text(v) is not None else None
            if p is None or p[1] and top is None:
                continue                                  # an exclusion, or a path only running it would tell
            root, rel = R.locate(p[0] or ".", top if p[1] else where, self.roots)
            if rel is None or not (R.under(rel, R.MISSION) or R.MISSION.startswith(rel + "/") or rel == "."):
                continue
            import _paths
            key = ("untracked", root, tuple(ls))
            if key not in self.seen:
                if sum(1 for k in self.seen if k[0] == "untracked") >= GIT_ASKS:
                    raise Block("this command runs more than %d differently-filtered git clean/stash forms, too many to"
                                " judge here: split it" % GIT_ASKS)
                self.seen[key] = bool(_paths._git(root, "ls-files", "-o", *ls, "--", R.MISSION.rstrip("/")))
            if self.seen[key]:
                raise Block("this git %s by %s deletes the untracked files of docs/agents/mission/ (the ledger and every"
                            " role's artifacts, when docs/agents/ is not tracked):\n    %s\n  Only the mission CLI and"
                            " the six mission roles write there (ROADMAP §4.12). Name what to clean (`git clean -fdx"
                            " build/`), or keep it out (`-e docs/agents/`).%s"
                            % (sub, self.who or "the supervisor", rel, "" if self.agent_type else
                               "\n  (Deliberate out-of-band edit outside the loop? Re-run with SKIP_HOOKS=1.)"))

    def git_output(self, sub, rest, d):
        """format-patch, archive, bundle, init, merge-file: the file or directory git writes (else nothing/stdout)."""
        if sub == "format-patch":
            _, f = operands(rest, "o", ("--output-directory",), words=True)
            if not f.get("--stdout"):
                self.write(f.get("-o") or f.get("--output-directory") or ["."], d, "git format-patch")
        elif sub == "merge-file":
            ops, f = operands(rest, "L", ("--marker-size", "--diff-algorithm"), words=True)
            if ops and not (f.get("-p") or f.get("--stdout")):
                self.write(ops[0], d, "git merge-file")   # the current file, merged in place
        elif sub == "archive":
            _, f = operands(rest, "o", ("--output",), words=True)
            out = f.get("-o") or f.get("--output")
            if out:
                self.write(out, d, "git archive")
        elif sub == "bundle":
            ops, _ = operands(rest, "", (), words=True)
            if len(ops) >= 2 and text(ops[0]) == "create":
                self.write(ops[1], d, "git bundle")
        elif sub == "init":
            ops, _ = operands(rest, "", ("--template", "--separate-git-dir", "--initial-branch", "-b", "--object-format"),
                              words=True)
            self.write(ops[0] if ops else ["."], d, "git init")

    def git_subcmd(self, sub, rest, st, where, depth):
        """bisect run CMD, rebase -x/--exec CMD, submodule foreach CMD: CMD is a command of its own."""
        base = where if where is not None else st["base"]
        if sub == "bisect" and rest and text(rest[0]) == "run" and len(rest) > 1:
            self.run(rest[1:], st, depth + 1, base=base)
        elif sub == "rebase":
            i = 0
            while i < len(rest):
                a = text(rest[i])
                if a in ("-x", "--exec") and i + 1 < len(rest):
                    c = text(rest[i + 1])
                    if c is not None:
                        self.shell(c, None, dict(st, base=base), depth + 1)
                    i += 2
                    continue
                if a and a.startswith("--exec="):
                    self.shell(a.split("=", 1)[1], None, dict(st, base=base), depth + 1)
                i += 1
        elif sub == "submodule":
            ops, _ = operands(rest, "", ())
            if ops and text(ops[0]) == "foreach" and len(ops) > 1 and text(ops[1]) is not None:
                self.shell(text(ops[1]), None, dict(st, base=base), depth + 1)

    def subst(self, src, st):
        """The value of $(…) when the gate can know it: pwd, mktemp, git rev-parse --show-toplevel."""
        cmds = [c for c in SR.read(src) if isinstance(c, SR.Cmd) and c.words]
        if len(cmds) != 1:
            return None
        ws = [self.resolve(w.parts, st) for w in cmds[0].words]
        name, args = basename(ws[0]), ws[1:]
        if name == "pwd":
            return st["base"]
        if name == "mktemp":
            ops, f = operands(args, "p", ("--tmpdir", "--suffix"))
            d = f.get("-p") or (f.get("--tmpdir") if isinstance(f.get("--tmpdir"), str) else None)
            if d:
                return os.path.join(d, "tmp.XXXXXXXX")
            if not ops or f.get("-t") or f.get("--tmpdir"):
                return MKTEMP
            t = text(ops[0])
            return os.path.join(st["base"], t) if t and st["base"] else None
        if name == "git" and [text(a) for a in args] == ["rev-parse", "--show-toplevel"] and st["base"]:
            return self.R.locate(st["base"], "/", self.roots)[0]
        return None

    def resolve(self, parts, st):
        out = []
        for p in parts:
            if isinstance(p, str):
                out.append(p)
            elif p[0] == "var":
                v = st["vars"].get(p[1])
                if v is None and p[1] not in st["vars"]:
                    env = {"PWD": st["base"], "OLDPWD": st["old"], "HOME": os.path.expanduser("~")}
                    e = env[p[1]] if p[1] in env else os.environ.get(p[1])
                    v = [e] if e is not None else (self.resolve(p[2], st) if p[2] is not None else None)
                out += v if v is not None else [None]
            elif p[0] == "cmd":
                out.append(self.subst(p[1], st))
            else:
                out.append(None)
        return out

    def shell(self, cmd, base, st=None, depth=0):
        st = st or {"base": base, "old": None, "vars": {}, "stack": [], "dirs": [], "cwd": []}
        if depth > DEPTH:
            return
        if depth:
            self.judge_code(cmd)                          # a recursed string (bash -c, eval, $(…)): the judge var
        for c in SR.read(cmd):
            if c == "(":
                st["stack"].append((st["base"], st["old"], dict(st["vars"])))
                continue
            if c == ")":
                if st["stack"]:
                    st["base"], st["old"], st["vars"] = st["stack"].pop()
                continue
            if c == "cwd+":                               # a compound/group opens: its `cd` is scoped
                st["cwd"].append((st["base"], st["old"]))
                continue
            if c == "cwd-":
                if st["cwd"]:
                    st["base"], st["old"] = st["cwd"].pop()
                continue
            saved = (st["base"], st["old"]) if c.pipe else None   # a pipeline element's `cd` does not leak
            for sub in c.subs:                            # $(…), `…`, <(…): a subshell of their own
                self.shell(sub, None, {"base": st["base"], "old": st["old"], "vars": dict(st["vars"]),
                                       "stack": [], "dirs": [], "cwd": []}, depth + 1)
            if c.loop:                                    # for/select NAME in LIST: NAME is one of the items
                name, lst = c.loop
                st["vars"][name] = self.resolve(lst[0].parts, st) if lst else [None]
                continue
            self.judge_env(name for name, _ in c.assigns)
            for name, parts in c.assigns:
                st["vars"][name] = self.resolve(parts, st)
            self.exports(c, st)                           # export/declare/local/readonly/typeset NAME=…
            ws = [self.resolve(w.parts, st) for w in c.words]
            for op, fd, w in c.redirs:
                if op in (">", ">>", ">|", "&>", "&>>", "<>") or (op == ">&" and not re.fullmatch(r"\d+|-", w.text() or "0")):
                    self.write(self.resolve(w.parts, st), st["base"], "Bash write")
            if ws:
                self.run(ws, st, depth, stdin=self.stdin_script(c.redirs))
            if saved is not None:
                st["base"], st["old"] = saved

    def exports(self, c, st):
        """export/declare/typeset/local/readonly NAME=VALUE records NAME, as a bare `NAME=VALUE` does."""
        if not c.words or c.words[0].text() not in ("export", "declare", "typeset", "local", "readonly"):
            return
        for w in c.words[1:]:
            if w.assign is not None:
                st["vars"][w.assign] = self.resolve(w.value(), st)

    def stdin_script(self, redirs):
        """A program the shell would read on its stdin: a heredoc body or a `<<<` here-string word."""
        for op, fd, w in redirs:
            if fd not in ("", "0"):
                continue
            if op in ("<<", "<<-") and w.body is not None:
                return w.body
            if op == "<<<":
                return w.text()
        return None

    def run(self, ws, st, depth, base=None, stdin=None):
        """Judge one command (after its wrappers) at the current dir."""
        base = st["base"] if base is None else base
        while ws:
            name, args = basename(ws[0]), ws[1:]
            if name is None:
                return
            if name in ("sudo", "doas"):
                i, _ = opts(args, "ugCDhprtTU")
                while i < len(args) and re.match(r"^[A-Za-z_]\w*=", text(args[i]) or ""):
                    self.judge_env([text(args[i]).split("=", 1)[0]])
                    i += 1
                ws = args[i:]
            elif name == "env":
                i, f = opts(args, "uCS", ("--unset", "--chdir", "--split-string"))
                d = f.get("-C") or f.get("--chdir")
                if isinstance(d, str):
                    base = os.path.join(base, d) if base else (d if d.startswith("/") else None)
                while i < len(args) and re.match(r"^[A-Za-z_]\w*=", text(args[i]) or ""):
                    self.judge_env([text(args[i]).split("=", 1)[0]])
                    i += 1
                split = f.get("-S") or f.get("--split-string")
                if isinstance(split, str):
                    rest = [text(a) for a in args[i:]]
                    if None not in rest:
                        self.shell(" ".join([split] + [shq(r) for r in rest]), None, dict(st, base=base), depth + 1)
                    return
                ws = args[i:]
            elif name in ("nice", "nohup", "command", "builtin", "exec", "time", "stdbuf", "ionice", "chronic",
                          "unbuffer", "timeout", "taskset", "caffeinate", "setsid"):
                if name == "command" and any(text(a) in ("-v", "-V") for a in args[:2]):
                    return
                i, f = opts(args, {"nice": "n", "exec": "a", "time": "fo", "stdbuf": "ioe", "ionice": "cnpPu",
                                   "timeout": "sk", "caffeinate": "tw"}.get(name, ""),
                            ("--adjustment", "--format", "--output", "--input", "--error", "--signal", "--kill-after"))
                if name == "time" and isinstance(f.get("-o") or f.get("--output"), str):
                    self.path(f.get("-o") or f.get("--output"), base, "Bash write")
                if name in ("timeout", "taskset") and i < len(args):
                    i += 1                                # the duration, the cpu mask
                ws = args[i:]
            elif name == "npx":
                i, f = opts(args, "pc", ("--package", "--call"))
                c = f.get("-c") or f.get("--call")
                if isinstance(c, str):
                    self.shell(c, None, dict(st, base=base), depth + 1)
                    return
                ws = args[i:]                             # npx [flags] CMD …: judge CMD (F12)
                if not ws:
                    return
            elif name == "xargs":
                i, f = opts(args, "adEeIiLlnPs", ("--arg-file", "--delimiter", "--eof", "--replace", "--max-lines",
                                                  "--max-args", "--max-procs", "--max-chars", "--process-slot-var"))
                rep = f.get("-I") or f.get("-i") or f.get("--replace")

                def sub_rep(a):                           # replace only the {} inside a word (sh -c '… {} …')
                    t = text(a)
                    return [t.replace(rep, '"$__xargs"')] if isinstance(rep, str) and t is not None and rep in t else a
                rest = [sub_rep(a) for a in args[i:]]
                ws = (rest or [["echo"]]) + ([] if rep else [[None]])
            elif name == "flock":
                i, f = opts(args, "wEc", ("--timeout", "--conflict-exit-code", "--command"))
                c = f.get("-c") or f.get("--command")
                if not isinstance(c, str):
                    k = [text(a) for a in args[i + 1:]]
                    if "-c" in k and k.index("-c") + 1 < len(k):
                        c = k[k.index("-c") + 1]
                if isinstance(c, str):
                    self.shell(c, None, dict(st, base=base), depth + 1)
                    return
                ws = args[i + 1:]
            elif name == "watch":
                i, f = opts(args, "ndq", ("--interval", "--differences", "--equexit"))
                rest = [text(a) for a in args[i:]]
                if f.get("-x") or f.get("--exec"):
                    ws = args[i:]
                elif None not in rest:
                    self.shell(" ".join(rest), None, dict(st, base=base), depth + 1)
                    return
                else:
                    return
            elif name == "su":
                _, f = operands(args, "csgG", ("--command", "--shell", "--group"))   # `su USER -c …`: -c anywhere
                c = f.get("-c") or f.get("--command")
                if isinstance(c, str):
                    self.shell(c, None, dict(st, base=base), depth + 1)
                return
            elif name == "runuser":
                i, f = opts(args, "ucgGs", ("--user", "--command", "--group", "--shell"))
                c = f.get("-c") or f.get("--command")
                if isinstance(c, str):
                    self.shell(c, None, dict(st, base=base), depth + 1)
                    return
                ws = args[i:]                             # `runuser -u USER -- CMD …`: CMD runs
            elif name in SHELLS:
                i, f = opts(args, "oO", ("--rcfile", "--init-file"))
                if any(k.startswith("-") and len(k) == 2 and k[1] == "c" for k in f) or "-c" in f:
                    c = text(args[i]) if i < len(args) else None
                    if c is not None:
                        self.shell(c, None, dict(st, base=base), depth + 1)
                    return
                ws = args[i:]                             # a script: judged by its name below
                if not ws:
                    if stdin is not None:                 # `bash <<EOF …`, `bash -s <<<…`: the body is its program
                        self.shell(stdin, None, dict(st, base=base), depth + 1)
                    return
            elif PYTHON.match(name):
                i, f = opts(args, "WXQ")
                if "-c" in f and i < len(args):
                    self.judge_code(text(args[i]))        # the judge var set or read in -c code
                if "-c" in f or "-m" in f or i >= len(args):
                    return                                # code the gate cannot read
                ws = args[i:]
            elif INTERPRETERS.match(name):
                self.judge_code(" ".join(t for t in (text(a) for a in args) if t))   # -e/-c code: the judge var
                return                                    # interpreter code the gate cannot read
            elif name == "eval":
                t = [text(a) for a in args]
                if None not in t:
                    self.shell(" ".join(t), None, dict(st, base=base), depth + 1)
                return
            else:
                return self.command(name, args, st, base, depth)

    def command(self, name, args, st, base, depth):
        if name in ("cd", "pushd", "popd"):
            if name == "popd":
                st["base"] = st["dirs"].pop() if st["dirs"] else None
                return
            ops, _ = operands(args, "")
            t = text(ops[0]) if ops else os.path.expanduser("~")
            new = (st["old"] if t == "-" else
                   None if t is None or re.match(r"^[+-]\d+$", t) else
                   os.path.join(base, os.path.expanduser(t)) if base else
                   (os.path.expanduser(t) if t.startswith(("/", "~")) else None))
            if name == "pushd":
                st["dirs"].append(st["base"])
            st["old"], st["base"] = st["base"], new
            return
        while name in CLI and args:                       # `aloop|agentic <tool> …` exec bin/<tool>, and so does
            t = text(args[0])                             # `aladdin <tool> …` but for its own verbs and an intent
            if t is None or name == "aladdin" and (t in ALADDIN_READS or t == "run"):
                break
            t = "aloop-init" if t == "init" else t
            if not re.fullmatch(r"[A-Za-z0-9][\w.-]*", t) or not os.access(os.path.join(BIN, t), os.X_OK):
                break                                     # aladdin: the intent itself; aloop: an unknown tool
            name, args = t, args[1:]
        if self.runner(name, args, st, base, depth):
            return
        name = re.sub(r"(?<=.)@[^/@]*$", "", name)        # `npx prettier@3`: the package's own command
        if name in DECLARE:
            self.judge_env(re.split(r"[-+=]", text(a) or "", maxsplit=1)[0] for a in args
                           if not (text(a) or "").startswith("-"))
            if name != "export" and any(re.fullmatch(r"-[a-zA-Z]*n[a-zA-Z]*", text(a) or "") for a in args):
                self.judge_env((text(a) or "").split("=", 1)[1] for a in args if "=" in (text(a) or ""))  # nameref target
        if name in SETTERS or name == "let":
            self.judge_env(set_names(name, args))         # read/mapfile/printf -v/let NAME: a set too
        if name in ("perl", "awk", "gawk", "mawk", "nawk"):
            self.judge_code(" ".join(t for t in (text(a) for a in args) if t))   # its program sets the judge var
        for v, meta in write_targets(name, args):
            self.write(v, base, "Bash write", **meta)
        if name == "find":
            self.find(args, st, base, depth)
        if name == "mission":
            self.mission_cli(args)
        elif name == "events":
            self.events_cli(args)
        elif name in ("intent", "aladdin"):
            self.intents_cli(name, args)
        elif name == "git":
            self.git(args, st, base, depth)
        elif name == "transcripts":
            self.transcripts_cli(args)
        elif name in HOSTS:
            self.host(name, args)

    def runner(self, name, args, st, base, depth):
        """A package runner (npm exec|x, pnpm|yarn dlx|exec, bunx) runs a package's command, which is
        judged as that command (npx is a wrapper); True when `name` was one."""
        a0 = text(args[0]) if args else None
        if name == "bunx":
            rest = args
        elif a0 is not None and a0 in {"npm": ("exec", "x"), "pnpm": ("dlx", "exec"),
                                       "yarn": ("dlx", "exec")}.get(name, ()):
            rest = args[1:]
        else:
            return False
        i, f = opts(rest, "pc", ("--package", "--call"))
        c = f.get("-c") or f.get("--call")
        if isinstance(c, str):
            self.shell(c, None, dict(st, base=base), depth + 1)
        elif rest[i:]:
            self.run(rest[i:], st, depth, base=base)
        return True

    def find(self, args, st, base, depth):
        """find … -exec CMD {} ; and -execdir / -ok: CMD is a command too, once for each start path. {} is a
        match under that start (GNU substitutes it inside any argument, and the text around it is kept);
        -execdir runs in the match's dir, where {} is ./<name> (F5). One too large to judge (FIND_WORK) blocks."""
        starts, tests = find_parts(args)
        segs, i, seen = [], 0, set()
        while i < len(args):
            a = text(args[i])
            if a in ("-exec", "-execdir", "-ok", "-okdir"):
                j = i + 1
                while j < len(args) and text(args[j]) not in (";", "+"):
                    j += 1
                segs.append((a in ("-execdir", "-okdir"), args[i + 1:j]))
                i = j
            i += 1
        if len(starts or "x") * sum(len(text(w) or "") + 1 for _, ws in segs for w in ws) > FIND_WORK:
            raise Block("this find runs its -exec commands once per start path (%d), too much to judge here: split it,"
                        " or run each command on the paths it names" % len(starts))
        for here, ws in segs:
            for sw in starts or [["."]]:
                start = text(sw)
                d = base if not here else (os.path.join(base, start) if base and start is not None else
                                           start if start and start.startswith("/") else None)
                alts = [brace(w, start, here, tests) for w in ws]
                for k in range(max([len(x) for x in alts] or [0])):
                    sub = [x[min(k, len(x) - 1)] for x in alts]
                    key = repr((sub, d))
                    if key not in seen:                    # the same command at the same dir: judged once
                        seen.add(key)
                        self.run(sub, st, depth + 1, base=d)


def shq(s):
    return "'" + s.replace("'", "'\\''") + "'"


def find_parts(args):
    """find's start paths (where its matches live; the leading -H/-L/-P/-O/-D options skipped) and the -name
    tests every match passes, as (pattern, ignore case): [] when it has none, or when an -o, !, -not, a
    comma or an unknown pattern makes them no bound on what it matches."""
    i = 0
    while i < len(args) and re.fullmatch(r"-[HLP]|-O\d?|-D", text(args[i]) or ""):
        i += 2 if text(args[i]) == "-D" else 1
    starts = []
    while i < len(args) and not re.match(r"^[-(!),]", text(args[i]) or "x"):
        starts.append(args[i])
        i += 1
    names = []
    while i < len(args):
        t = text(args[i])
        if t in ("-exec", "-execdir", "-ok", "-okdir"):
            while i < len(args) and text(args[i]) not in (";", "+"):
                i += 1                                    # its command's words are not find's tests
        elif t in ("-o", "-or", "!", "-not", ","):
            return starts, []
        elif t in ("-name", "-iname", "-path", "-ipath", "-wholename", "-iwholename", "-regex", "-iregex",
                   "-lname", "-ilname") and i + 1 < len(args):
            v = text(args[i + 1])
            if t in ("-name", "-iname"):
                if v is None:
                    return starts, []
                names.append((v, t == "-iname"))
            i += 1
        i += 1
    return starts, names


def brace(w, start, here, tests):
    """An -exec argument's alternatives. A word with no {} is itself; a bare {} is a match under `start`
    (in an -execdir dir, ./<name> there), bounded by find's tests (a Match); a word around {} keeps its
    text, and each depth that the text after {} can climb out of a match (`{}/../x`) is judged too."""
    t = text(w)
    if t is None or "{}" not in t:
        return [w]
    if t == "{}":
        return [Match(["./", None] if here else [None] if start is None else [start.rstrip("/") + "/", None], tests)]
    if not here and start is None:
        return [[None]]
    pre, _, suf = t.partition("{}")
    climb = suf.replace("{}", "/").split("/").count("..")
    if climb > CLIMB:
        raise Block("a find -exec word climbs %d levels out of its match ({}/../…), more than the %d judged here:"
                    " name the path it writes instead" % (climb, CLIMB))
    matches = (["./\0"] if here else [start] * bool(climb) +
               [start.rstrip("/") + "/\0" * d for d in range(1, climb + 2)])   # \0: a name only find knows
    out = []
    for m in matches:
        full = posixpath.normpath(pre + m + suf.replace("{}", m))
        k = full.find("\0")
        out.append([full] if k < 0 else [full[:k] or "./", None])
    return out


def heredoc_free(s):
    """`s` without its quoted heredocs' bodies (data, in a shell and in perl), in one linear pass."""
    out, i = [], 0
    while True:
        m = QUOTED_HEREDOC.search(s, i)
        nl = s.find("\n", m.end()) if m else -1
        if nl < 0:
            return "".join(out) + s[i:]
        out.append(s[i:nl + 1])
        delim = re.escape(m.group(1) or m.group(2) or m.group(3))
        end = re.compile(r"^[ \t]*%s[ \t]*$" % delim, re.M).search(s, nl + 1)
        if end is None:
            return "".join(out)
        i = end.end()


def set_names(name, args):
    """The variables a builtin sets: read/mapfile/readarray/getopts NAME, printf -v NAME, let NAME=…."""
    if name == "let":
        return [re.split(r"[-+*/%<>&|^]?=", text(a) or "", maxsplit=1)[0].strip() for a in args]
    ops, f = operands(args, SETTERS[name])
    ts = [text(o) for o in ops]
    if name == "printf":
        return [f.get("-v")]
    if name == "read":
        return ts + [f.get("-a")]
    return ts[1:2] if name == "getopts" else ts[:1]


def git_write(sub, rest):
    """Is `git <sub> <rest…>` a write? The list and read forms of branch, tag, stash, config… are not."""
    if sub not in GIT_WRITES:
        return False
    args = [a for a in rest if a is not None]
    if sub in ("tag", "branch"):                          # a --sort/--format/… value is not a bundle of short flags
        vopt = ("--sort", "--format", "--contains", "--no-contains", "--points-at", "--merged", "--no-merged")
        cleaned, k = [], 0
        for a in args:
            if k:
                k = 0
                continue
            if a in vopt:
                k = 1
                continue
            cleaned.append(a)
        args = cleaned
    flags = {a.split("=", 1)[0] for a in args if a.startswith("--")}
    short = "".join(a[1:] for a in args if a.startswith("-") and not a.startswith("--"))
    pos = [a for a in args if not a.startswith("-")]
    if "--dry-run" in flags or (sub in ("add", "rm", "clean", "push", "mv") and "n" in short):
        return False
    if sub == "bisect":
        return not (pos and pos[0] in ("log", "view", "visualize", "help", "terms"))
    if sub == "remote":
        return bool(pos) and pos[0] in ("add", "remove", "rm", "rename", "set-url", "set-head", "set-branches",
                                        "prune", "update")
    if sub == "symbolic-ref":
        return "--delete" in flags or "d" in short or len(pos) >= 2
    if sub == "lfs":
        return bool(pos) and pos[0] in ("pull", "checkout", "fetch", "prune", "migrate", "push", "clean",
                                        "install", "uninstall", "track", "untrack")
    if sub == "hash-object":
        return "w" in short
    if sub == "stash":
        return not (pos and pos[0] in ("list", "show"))
    if sub == "worktree":
        return not (pos and pos[0] == "list")
    if sub == "notes":
        return bool(pos) and pos[0] not in ("list", "show")
    if sub == "submodule":
        return bool(pos) and pos[0] not in ("status", "summary", "foreach")
    if sub == "apply":
        return not ({"--check", "--stat", "--numstat", "--summary"} & flags) or "--apply" in flags
    if sub == "config":
        if {"--global", "--system"} & flags or {"--get", "--get-all", "--get-regexp", "--get-urlmatch", "--list",
                                                  "--show-origin", "--show-scope", "--get-color"} & flags or "l" in short:
            return False
        if pos and pos[0] in ("get", "list", "get-regexp", "get-all", "get-urlmatch"):   # git >= 2.46 read verbs
            return False
        return len(pos) >= 2 or bool({"--unset", "--unset-all", "--add", "--replace-all", "--rename-section",
                                      "--remove-section", "--edit"} & flags) or "e" in short
    if sub == "branch":
        if set(short) & set("dDmMcCfut") or {"--delete", "--move", "--copy", "--force", "--set-upstream-to",
                                              "--unset-upstream", "--edit-description", "--track", "--no-track",
                                              "--create-reflog"} & flags:
            return True
        return bool(pos) and not (set(short) & set("arlv") or flags - {"--quiet"})
    if sub == "tag":
        if set(short) & set("dasufmFe") or {"--delete", "--annotate", "--sign", "--local-user", "--force", "--message",
                                             "--file", "--edit", "--cleanup", "--trailer"} & flags:
            return True
        return bool(pos) and not (set(short) & set("lnvi") or flags)
    return True


def _word(v):
    """A directory-option value as a word to judge (prefix-judged when computed), or None when absent."""
    return v if isinstance(v, list) else None


def pathspec(t):
    """A git pathspec as (the path it names, from the worktree's top), or None for an exclusion (:!x, :^x,
    :(exclude)x). Magic (:/, :(top,glob…)) is read; a glob is judged by the dir before its first wildcard."""
    top = False
    if t.startswith(":"):
        m = re.match(r"^:\(([^)]*)\)(.*)$", t) or re.match(r"^:([/!^]*):?(.*)$", t)
        sig = m.group(1)
        if "exclude" in sig or "!" in sig or "^" in sig:
            return None
        top, t = "/" in sig or "top" in sig, m.group(2)
    g = re.search(r"[*?\[]", t)
    if g:
        t = t[:t.rfind("/", 0, g.start()) + 1]
    return t, top


def git_pathspecs(sub, rest, where):
    """A caller's git pathspecs as (word, from the top, tree): every operand of rm/mv/restore/clean; for
    checkout/reset the operands after a tree-ish (with or without `--`), for stash push its own. A removal
    (rm -r, an mv source) or another commit's files (a tree-ish or --source but HEAD) reach everything under a
    dir (`tree`); a restore from the index or HEAD does not. Bare branch/ref ops judge as harmless names."""
    sv, lv, _ = GIT_PATHS[sub]
    texts = [text(a) for a in rest]
    cut = texts.index("--") if "--" in texts else len(rest)
    ops, f = operands(rest[:cut], sv, lv, words=True)
    after = list(rest[cut + 1:])
    if "-n" in f or "--dry-run" in f:
        return []
    tree, src = None, None
    if sub in ("rm", "mv", "restore", "clean"):
        specs = ops + after
        if sub == "rm" and ("-r" in f or "-R" in f):
            tree = []
        src = text(_word(f.get("-s") or f.get("--source")) or ["HEAD"]) if sub == "restore" else None
    elif sub == "stash":
        verb = text(ops[0]) if ops else None
        specs = (ops[1:] + after) if verb == "push" else after if not ops else []
    else:                                                 # checkout/reset [<tree-ish>] [--] <pathspec>…
        if after or cut < len(rest):
            src, specs = (text(ops[0]) if ops else None), after
        elif len(ops) >= 2 and not (where and text(ops[0]) and os.path.exists(os.path.join(where, text(ops[0])))):
            src, specs = text(ops[0]), ops[1:]
        else:
            specs = ops
    if src not in (None, "HEAD", "@"):
        tree = []                                         # another commit's files land under each dir
    out = []
    for i, v in enumerate(specs):
        t = text(v)
        p = pathspec(t) if t is not None else (None, False)
        if p is None:
            continue
        word = v if t is None else [p[0] or "."]
        mv_dest = sub == "mv" and i == len(specs) - 1
        out.append((word, p[1], None if mv_dest else ([] if sub == "mv" else tree)))
    return out


def write_targets(name, args):
    """The files a simple command writes, as (value, meta): meta may mark `bare` (may name the mission
    dir itself: mkdir/touch), `tree` (removes everything under it, bounded by a name list or []),
    `removes` (removes the file: a find {} match there is bounded as a tree) or `extract` (an archive
    is unpacked into it)."""
    if name in ("cp", "mv", "ln", "install"):
        ops, f = operands(args, {"install": "tmogS"}.get(name, "tS"),
                          ("--target-directory", "--suffix", "--mode", "--owner", "--group"), words=True)
        t = _word(f.get("-t") or f.get("--target-directory"))
        if t is not None:                                 # the target dir (F8: never a source operand, but mv
            return [(t, {})] + [(s, {"tree": []}) for s in ops if name == "mv"]   # removes each one, F6)
        if name == "install" and (f.get("-d") or f.get("--directory")):
            return [(o, {}) for o in ops]
        if name == "ln" and len(ops) == 1 and text(ops[0]):
            return [([os.path.basename(text(ops[0]))], {})]
        if len(ops) < 2:
            return []
        dest, srcs, dt = ops[-1], ops[:-1], text(ops[-1])
        if dt is not None and dt.endswith("/"):           # copy INTO a dir: dir + basename(source) (F5)
            out = [([dt + os.path.basename(text(s))] if text(s) else dest, {}) for s in srcs]
        else:
            out = [(dest, {})]
        if name == "mv":                                  # mv removes each source (F6)
            out += [(s, {"tree": []}) for s in srcs]
        return out
    if name == "rsync":
        ops, f = operands(args, "eBfT", ("--exclude", "--include", "--filter", "--exclude-from", "--include-from",
                                         "--files-from", "--rsh", "--rsync-path", "--log-file", "--partial-dir",
                                         "--temp-dir", "--compare-dest", "--copy-dest", "--link-dest", "--backup-dir",
                                         "--suffix", "--chmod", "--password-file", "--timeout", "--bwlimit"), words=True)
        if len(ops) < 2:
            return []
        dest = ops[-1]
        if ":" in prefix(dest).split("/")[0]:
            return []                                     # a remote destination (host:path)
        meta = {"tree": []} if any(k.startswith("--delete") for k in f) else {}
        out = [(dest, meta)]
        if "--remove-source-files" in f:                  # rsync removes each source (F6)
            out += [(s, {}) for s in ops[:-1]]
        return out
    if name in ("rm", "rmdir", "unlink", "shred", "tee", "mkdir", "touch", "truncate"):
        ops, f = operands(args, {"shred": "ns", "mkdir": "mZ", "touch": "drt", "truncate": "sr"}.get(name, ""),
                          ("--mode", "--date", "--reference", "--size", "--iterations", "--random-source", "--context"))
        if name == "rm" and ("-r" in f or "-R" in f or "--recursive" in f):
            return [(o, {"tree": []}) for o in ops]       # a recursive rm reaches everything under each path (F5)
        meta = {"bare": True} if name in ("mkdir", "touch") else {"removes": True} if name in (
            "rm", "rmdir", "unlink", "shred") else {}
        return [(o, meta) for o in ops]
    if name == "sed":
        ops, f = operands(args, "efl", ("--expression", "--file", "--line-length"))
        if not any(k == "-i" or k.startswith("--in-place") for k in f):
            return []
        if "-i" in f and ops and text(ops[0]) == "":      # BSD `sed -i '' …`: '' is the suffix, not the script (F3)
            ops = ops[1:]
        files = ops if any(k in f for k in ("-e", "-f", "--expression", "--file")) else ops[1:]
        return [(o, {}) for o in files]
    if name == "perl":
        ops, f = operands(args, "eEMmIx")             # -0/-l take only an octal value, so they do not hide a clustered -i
        if "-i" not in f and not any(k.startswith("-i") for k in f):
            return []
        return [(o, {}) for o in (ops if ("-e" in f or "-E" in f) else ops[1:])]
    if name in ("awk", "gawk"):
        ops, f = operands(args, "fvFie", ("--file", "--assign", "--field-separator", "--include", "--source"))
        if "inplace" not in (f.get("-i"), f.get("--include")):
            return []
        ops = [o for o in ops if not re.match(r"^[A-Za-z_]\w*=", text(o) or "")]
        return [(o, {}) for o in (ops if any(k in f for k in ("-f", "--file", "-e", "--source")) else ops[1:])]
    if name == "dd":
        return [([text(a)[3:]], {}) for a in args if (text(a) or "").startswith("of=")]
    if name in ("sort", "sponge", "yq", "dos2unix", "unix2dos", "iconv", "split", "mktemp", "scp",
                "gzip", "gunzip", "xz", "bzip2", "ed", "ex", "vi", "vim", "view", "nvim", "ruff",
                "clang-format") or name in FORMATTERS:
        return inplace_targets(name, args)
    if name == "curl":
        _, f = operands(args, "dDeEFHKmoPQrTuUwxXyYzAbcCt", ("--output", "--data", "--header", "--request", "--user",
                                                              "--url", "--config", "--write-out", "--max-time",
                                                              "--output-dir"), words=True)
        out = _word(f.get("-o") or f.get("--output"))
        if out is not None:
            return [(out, {})]
        if f.get("-O") or f.get("--remote-name") or f.get("--remote-name-all") or f.get("-J") \
                or f.get("--remote-header-name"):          # a remote-named download into --output-dir or the cwd (F4)
            return [(_word(f.get("--output-dir")) or ["."], {})]
        return []
    if name == "wget":
        _, f = operands(args, "OPoaieUtTwQBD", ("--output-document", "--directory-prefix", "--output-file",
                                                 "--append-output"), words=True)
        logs = [(v, {}) for v in (_word(f.get(k)) for k in ("-o", "--output-file", "-a", "--append-output")) if v]
        if any(k in f for k in ("--spider", "-V", "--version", "-h", "--help")):
            return logs                                   # it checks a URL or prints: no document is saved
        out = _word(f.get("-O") or f.get("--output-document"))
        if out is not None:
            return [(out, {})] + logs                     # an explicit document ("-" is stdout, skipped above)
        return [(_word(f.get("-P") or f.get("--directory-prefix")) or ["."], {})] + logs   # cwd/-P: -r/-m too (F4)
    if name in ("gh", "npm", "pnpm", "yarn", "pip", "pip3"):
        return fetch_targets(name, args)                  # clones and installs with a fixed output location (F9)
    if name == "find":
        paths, names = find_parts(args)
        return [(p, {"tree": names}) for p in (paths or [["."]])] if any(text(a) == "-delete" for a in args) else []
    if name == "tar":
        first = text(args[0]) if args else ""
        _, f = operands(args, "CfbFgKLNTVX", ("--directory", "--file"), words=True)
        mode = (first or "").lstrip("-") if first and not first.startswith("--") else ""
        if "x" in mode.split("f")[0] or "-x" in f or "--extract" in f or "--get" in f:
            if "O" in mode or "-O" in f or "--to-stdout" in f:
                return []                                 # extract to stdout: nothing written (F9)
            return [(_word(f.get("-C") or f.get("--directory")) or ["."], {"extract": True})]   # the extract dir (F4)
        if ("c" in mode.split("f")[0] or "-c" in f or "--create" in f) and "--remove-files" in f:
            ops, _ = operands(args, "CfbFgKLNTVX", ("--directory", "--file"), words=True)
            return [(o, {"tree": []}) for o in ops]       # --remove-files deletes each archived path (F6)
        return []
    if name == "unzip":
        ops, f = operands(args, "dxP", words=True)
        if not ops or any(k in f for k in ("-l", "-t", "-v", "-Z", "-p", "-c", "-z", "-h")) or "--help" in f:
            return []                                     # its usage, a listing, test, pipe to stdout, or help (F10)
        return [(_word(f.get("-d")) or ["."], {"extract": True})]
    if name == "zip":
        ops, f = operands(args, "bnPtZsO", ("--out", "--temp-path", "--password", "--suffixes"), words=True)
        out = _word(f.get("-O") or f.get("--out")) or (ops[0] if ops else None)
        moved = ops[1:] if f.get("-m") or f.get("--move") else []
        return ([(out, {})] if out is not None else []) + [(o, {"tree": []}) for o in moved]   # -m removes them (F6)
    if name == "patch":
        ops, f = operands(args, "pdiorBDFgVYz", ("--directory", "--input", "--output", "--strip"), words=True)
        if "--dry-run" in f:
            return []
        out = _word(f.get("-o") or f.get("--output"))
        if out is not None:
            return [(out, {})]
        if ops:
            return [(ops[0], {})]
        return [(_word(f.get("-d") or f.get("--directory")) or ["."], {})]   # the -d dir (F4)
    return []


def inplace_targets(name, args):
    """In-place editors and formatters (F12): they rewrite the files/dirs they are handed."""
    if name == "sort":
        _, f = operands(args, "o", ("--output",), words=True)
        out = _word(f.get("-o") or f.get("--output"))
        return [(out, {})] if out is not None else []
    if name == "sponge":
        ops, _ = operands(args, "", words=True)           # -a appends: a flag, the file is still its operand
        return [(ops[0], {})] if ops else []
    if name == "yq":                                      # yq -i EXPR FILE…: the first file (python yq: each)
        ops, f = operands(args, "opI", ("--output-format", "--input-format", "--indent", "--from-file",
                                        "--front-matter", "--expression"), words=True)
        if not (f.get("-i") or f.get("--inplace") or f.get("--in-place")):
            return []
        if ops and text(ops[0]) in ("e", "eval", "ea", "eval-all"):
            ops = ops[1:]
        return [(o, {}) for o in (ops if f.get("--from-file") or f.get("--expression") else ops[1:])]
    if name in ("dos2unix", "unix2dos"):                  # -n IN OUT…: only OUT is written; -o FILE… in place
        out, pair, k, skip = [], False, 0, False
        for a in args:
            t = text(a)
            if skip:
                skip = False
            elif t in ("-n", "--newfile", "-o", "--oldfile"):
                pair, k = t in ("-n", "--newfile"), 0
            elif t in ("-c", "--convmode", "-D", "--display-enc"):
                skip = True
            elif t is None or not t.startswith("-") or t == "-":
                k += 1
                if not pair or k % 2 == 0:
                    out.append((a, {}))
        return out
    if name == "iconv":
        _, f = operands(args, "fto", ("--from-code", "--to-code", "--output"), words=True)
        out = _word(f.get("-o") or f.get("--output"))
        return [(out, {})] if out is not None else []
    if name == "split":                                   # the prefix operand, else x in the cwd (xaa, xab…)
        ops, _ = operands(args, "ablCnt", ("--bytes", "--lines", "--number", "--suffix-length", "--separator"),
                          words=True)
        return [(ops[1] if len(ops) >= 2 else ["x"], {})]
    if name == "mktemp":
        ops, f = operands(args, "p", ("--suffix",), words=True)   # --tmpdir[=DIR]: its value only when attached
        d = _word(f.get("-p")) or _word(f.get("--tmpdir"))
        if d is not None:
            return [(d, {"bare": True})]                  # a temp file created under -p DIR / --tmpdir=DIR
        if ops and not (f.get("-t") or f.get("--tmpdir")):
            return [(ops[0], {})]                         # a template under the cwd
        return []
    if name in ("ed", "ex", "vi", "vim", "view", "nvim"):
        ops, f = operands(args, "cSuUiwWT", ("--cmd",), words=True)
        cmds = [o for o in ops if (text(o) or "").startswith("+")]   # +CMD: an Ex command run on the file
        scripted = name in ("ed", "ex") or cmds or any(k in f for k in ("-c", "--cmd", "-s", "-e", "-E", "-S",
                                                                         "--headless"))
        return [(o, {}) for o in ops if all(o is not c for c in cmds) and text(o) != "-"] if scripted else []
    if name == "scp":
        ops, _ = operands(args, "iloFScJ", (), words=True)
        dest = ops[-1] if len(ops) >= 2 else None
        return [(dest, {})] if dest is not None and ":" not in prefix(dest).split("/")[0] else []
    if name in ("gzip", "gunzip", "xz", "bzip2"):
        ops, f = operands(args, "S", ("--suffix",), words=True)
        if f.get("-c") or f.get("--stdout") or f.get("--to-stdout") or f.get("-t") or f.get("--test") \
                or f.get("-l") or f.get("--list"):
            return []                                     # stdout, test or list: the file is not replaced
        return [(o, {}) for o in ops]
    if name == "ruff":                                    # check --fix|--add-noqa, format: the paths, else the cwd
        ops, f = operands(args, "o", RUFF_VALUES, words=True)
        sub = text(ops[0]) if ops else None
        out = [(v, {}) for v in (_word(f.get(k)) for k in ("-o", "--output-file")) if v]
        if sub in ("check", "format"):
            ops = ops[1:]
        elif sub in ("rule", "config", "linter", "clean", "version", "help", "server", "analyze"):
            return out
        if sub == "format":
            writes = not {"--check", "--diff"} & set(f)
        else:                                             # check, or the legacy `ruff [--fix] PATH…`
            writes = bool({"--fix", "--fix-only", "--add-noqa"} & set(f)) and not {"--diff", "--no-fix"} & set(f)
        return out + ([(o, {}) for o in ops or [["."]]] if writes else [])
    if name == "clang-format":                            # LLVM-style options (-style=file): only -i rewrites
        ts = [text(a) for a in args]
        return [(a, {}) for a, t in zip(args, ts) if t is None or not t.startswith("-")] if "-i" in ts else []
    writes, reads, sv, lv, cwd = FORMATTERS[name]         # black, isort, prettier, gofmt, eslint
    ops, f = operands(args, sv, lv, words=True)
    out = [(v, {}) for v in (_word(f.get(k)) for k in ("-o", "--output-file")) if v] if name == "eslint" else []
    if reads & set(f) or writes is not None and not writes & set(f):
        return out
    ops = [o for o in ops if text(o) != "-"]              # "-": stdin to stdout
    return out + [(o, {}) for o in ops or ([["."]] if cwd else [])]


def fetch_targets(name, args):
    """Clones, downloads and installs with a fixed output location (F9): gh repo|gist clone, gh repo fork
    --clone, gh release|run download, gh pr checkout (the cwd's repo), npm/pnpm/yarn installs (a global
    one lands outside the project), pip download|wheel|install --target."""
    if name == "gh":
        ops, f = operands(args, "RDOpnAb", ("--repo", "--dir", "--output", "--pattern", "--name", "--archive",
                                            "--remote-name", "--org", "--fork-name", "--branch"), words=True)
        verb = [text(o) for o in ops[:2]]
        clone = f.get("--clone")
        if verb in (["repo", "clone"], ["gist", "clone"]) or verb == ["repo", "fork"] and (
                clone is True or isinstance(clone, list) and text(clone) not in ("false", "0")):
            if len(ops) >= 4 and text(ops[3]) and verb[1] == "clone":
                return [(ops[3], {})]                     # an explicit destination
            if len(ops) >= 3 and text(ops[2]):
                return [([re.sub(r"\.git$", "", os.path.basename(text(ops[2]).rstrip("/")))], {})]
            return []
        if verb == ["release", "download"] and _word(f.get("-O") or f.get("--output")) is not None:
            return [(_word(f.get("-O") or f.get("--output")), {})]   # one file ("-" is stdout)
        if verb in (["release", "download"], ["run", "download"]):
            return [(_word(f.get("-D") or f.get("--dir")) or ["."], {})]
        if verb == ["pr", "checkout"]:
            return [(["."], {})]                          # it switches the cwd's repo to the PR's branch
        return []
    if name in ("npm", "pnpm", "yarn"):
        ops, f = operands(args, "C", ("--prefix", "--cwd", "--location"), words=True)
        if f.get("-g") or f.get("--global") or text(_word(f.get("--location")) or [""]) == "global":
            return []                                     # a global install lands outside the project
        verb = text(ops[0]) if ops else None
        bare = name == "yarn" and not ops and not any(k in f for k in ("-v", "--version", "-h", "--help"))
        if bare or verb in NPM_WRITES:                    # bare `yarn` installs
            return [(_word(f.get("--prefix") or f.get("-C") or f.get("--cwd")) or ["."], {})]
        return []
    if name in ("pip", "pip3"):
        ops, f = operands(args, "dtwreci", ("--dest", "--target", "--wheel-dir", "--requirement", "--constraint",
                                            "--index-url", "--extra-index-url", "--editable", "--prefix", "--root"),
                          words=True)
        verb = text(ops[0]) if ops else None
        if verb in ("download", "wheel"):
            return [(_word(f.get("-d") or f.get("--dest") or f.get("-w") or f.get("--wheel-dir") or f.get("-t")
                           or f.get("--target")) or ["."], {})]
        if verb == "install":
            t = _word(f.get("-t") or f.get("--target") or f.get("--prefix") or f.get("--root"))
            return [(t, {})] if t is not None else []
        return []
    return []


def main(state):
    if os.environ.get("SKIP_HOOKS") == "1":
        return 0
    raw = "" if sys.stdin.isatty() else sys.stdin.read()
    try:
        p = json.loads(raw or "{}")
    except ValueError:
        return 0
    tool = p.get("tool_name") or ""
    if tool not in EDIT_TOOLS + SHELL_TOOLS + ("apply_patch",):
        return 0
    cwd = p.get("cwd") or os.getcwd()
    import _paths
    if not os.path.isdir(_paths.docs(cwd)):
        return 0                                          # not an aloop project
    state["ours"] = True
    import _mission_roles as R
    s = Scope(R, p, _paths.project(cwd))
    ti = p.get("tool_input") or {}
    if tool in EDIT_TOOLS:
        target = ti.get("file_path") or ti.get("filePath") or ti.get("notebook_path") or ""
        if target:
            s.path(target, cwd, tool)
    elif tool == "apply_patch":
        for a, b in PATCH_PATHS.findall(ti.get("command") or ti.get("patchText") or ""):
            s.path((a or b).strip(), cwd, "apply_patch")
    else:
        s.shell(ti.get("command") or "", ti.get("workdir") or cwd)
    return 0


if __name__ == "__main__":
    st = {"ours": False}
    try:
        rc = main(st)
    except Block as e:
        print("BLOCK[%s]: %s" % (GATE, e), file=sys.stderr)
        rc = 2
    except Exception as e:                                # noqa: BLE001 — a crashed gate blocks, once the call is ours
        if not st["ours"]:
            sys.exit(0)
        print("BLOCK[%s]: the gate itself failed (%s: %s), failing closed. This is a gate bug, not your work:"
              " report it with this line. (Deliberate bypass? SKIP_HOOKS=1.)" % (GATE, type(e).__name__, e), file=sys.stderr)
        rc = 2
    sys.exit(rc)
