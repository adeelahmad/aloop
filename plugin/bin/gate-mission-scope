                 "-h", "--help", "--list", "--root"}  # `aladdin` verbs that record no intent
INTENT_READS = {"summary", "-h", "--help"}            # `intent` verbs that write no intent and emit no intake event
BIN = os.path.dirname(os.path.realpath(__file__))    # `aloop|aladdin <tool>` execs BIN/<tool> (bin/aloop, bin/aladdin)
JUDGE_NAMES = {"ALOOP_JUDGE_CMD", "ALOOP_JUDGE_TIMEOUT"}         # the judge command and its time box (M9.42)
# the judge var SET in a script string run elsewhere (shell or interpreter code); a mention as data is no set
JUDGE_SET = re.compile(r"""(?<![\w$]){n}\+?=                # NAME=… (assignment, env, export, putenv("NAME=…"))
    | \$\{{?{n}\b                                           # its expansion in a shell string (round 3's row)
    | \.{n}\s*=(?!=)                                         # process.env.NAME = …
    | [\[{{]\s*["']?{n}["']?\s*[\]}}]\s*=(?!=)               # os.environ["NAME"] =, ENVIRON[…] =, $ENV{{NAME}} =
    | ["']{n}["']\s*(?::|=>)                                 # {{"NAME": …}}, "NAME" => …: an env mapping
    | [{{,]\s*{n}\s*:(?!:)                                   # {{NAME: …}}: a JS env object
    | (?:[Ss]etenv|putenv|set_var|setdefault|store|set)\s*\(\s*["']{n}   # os.putenv("NAME", …), Deno.env.set(…)
    """.format(n=r"ALOOP_JUDGE_(?:CMD|TIMEOUT)"), re.X)
QUOTED_HEREDOC = re.compile(r"""<<-?[ \t]*(?:'([^'\n]{1,64})'|"([^"\n]{1,64})"|\\(\w{1,64}))""")   # its body is data
INTERPRETERS = re.compile(r"^(?:node|nodejs|ruby|php|deno|bun|lua|osascript)[0-9.]*$")   # perl keeps its write_targets path
DECLARE = {"export", "declare", "typeset", "local", "readonly"}
# builtins that set the variables they name, and their short options that take a value
SETTERS = {"read": "adinNptu", "mapfile": "dnOsuCc", "readarray": "dnOsuCc", "printf": "v", "getopts": ""}
