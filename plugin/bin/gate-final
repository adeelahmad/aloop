#!/usr/bin/env bash
# FINAL GATE (sprint sign-off): full standards matrix green, zero suppressions,
# every plan-ready.md fully [x]. (Target: Rust; matrix from standards.md.)
GATE_NAME="gate-final"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
: "${CLAUDE_PLUGIN_ROOT:=$(cd "$HERE/.." && pwd)}"
# shellcheck source=/dev/null
source "$HERE/_gatelib.sh"

root="$(repo_dir)"

# 1) Zero suppressions anywhere.
assert_no_suppression

# 2) Every plan-ready.md fully ticked — in this tree AND in the sprint's docs in the main
#    tree (a worker worktree has docs/agents/ sparse-checked out, so look there too).
sprint_dir="${SPRINT_DIR:-}"
[ -z "$sprint_dir" ] && [ -n "${STORY_DIR:-}" ] && sprint_dir="$(dirname "$STORY_DIR")"
if [ -z "$sprint_dir" ]; then
  sprint_dir="$(find "$AGENTIC_DOCS" -maxdepth 1 -type d -name 'sprint[0-9]*' 2>/dev/null \
                | awk -F'sprint' '{print $NF"\t"$0}' | sort -n | tail -1 | cut -f2-)"
fi
if [ -n "$sprint_dir" ] && [ -f "$sprint_dir/rollover.md" ]; then
  # admission closed (sprint envelope): only carried-over tasks may stay unticked
  "$HERE/budget" rollover-check "$sprint_dir" \
    || fail "rolled-over sprint: an unticked plan-ready.md box belongs to a task not listed in $sprint_dir/rollover.md"
else
  for d in "$root" ${sprint_dir:+"$sprint_dir"}; do
    if grep -rl '\- \[ \]' --include='plan-ready.md' "$d" 2>/dev/null | grep -q .; then
      fail "an unticked plan-ready.md box remains in $d (sprint not GREEN-complete)"
    fi
  done
fi

# 3) Full gate matrix (from standards.md) green.
run_standards_matrix

note "FINAL gate passed: matrix green, zero suppressions, all plan-ready ticked"

# 4) Sprint close — by the harness, only on the real SubagentStop run (never a self-check):
#    sprintN/stats.md, docs/agents/NEXT.md (the post-/clear handoff), token totals.
if [ "${AGENTIC_SELFCHECK:-}" != 1 ] && [ -n "$sprint_dir" ]; then
  ( cd "$AGENTIC_PROJECT" && "$HERE/stats" sprint-close "$sprint_dir" ) >&2 || warn "stats sprint-close failed (sprint still passed)"
fi
exit 0
