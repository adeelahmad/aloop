#!/usr/bin/env bash
# session-start — SessionStart hook (startup · resume · clear · compact). Deterministic:
#   1. re-applies the project's managed .gitignore lines (only if init opted in), so run
#      data (.agentic/) and — by default — docs/agents/ can never leak into a commit;
#   2. loads docs/agents/NEXT.md — the orchestrator handoff the harness wrote when the last
#      sprint closed — into the fresh context. This is how the supervisor resumes after
#      /clear: from the file, not from memory.
# Never blocks (always exit 0).
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
payload="$([ -t 0 ] || cat 2>/dev/null || true)"
cwd="$(printf '%s' "$payload" | sed -nE 's/.*"cwd"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' | head -1)"
if [ -n "$cwd" ] && [ -d "$cwd" ]; then cd "$cwd" || exit 0; fi
# shellcheck source=/dev/null
. "$HERE/_paths.sh"

"$HERE/config" sync >/dev/null 2>&1 || true             # .aladdin/config.yaml -> defaults.md
"$HERE/aloop-init" --ensure-gitignore >/dev/null 2>&1 || true

# the context boundary, observed (ROADMAP §4.4): a cleared session is a rotation, a host
# compaction is recorded as one — never inferred
src="$(printf '%s' "$payload" | sed -nE 's/.*"source"[[:space:]]*:[[:space:]]*"([a-z]+)".*/\1/p' | head -1)"
case "$src" in
  clear)   "$HERE/events" emit context.rotated --role supervisor --data "source=clear" >/dev/null 2>&1 || true ;;
  compact) "$HERE/events" emit context.compacted --role supervisor --data "source=compact" >/dev/null 2>&1 || true ;;
esac

# a host swap (ROADMAP §4.9): `host swap --to <this host>` left .agentic/state/host-swap.json;
# this host consumes it — the sprint resumes from the same portable state, and the swap is
# recorded as the rotation it is
swapped=""
swapf="$AGENTIC_STATE/host-swap.json"
if [ -f "$swapf" ]; then
  to="$(sed -nE 's/.*"to"[[:space:]]*:[[:space:]]*"([a-z]+)".*/\1/p' "$swapf" | head -1)"
  from="$(sed -nE 's/.*"from"[[:space:]]*:[[:space:]]*"([a-z]+)".*/\1/p' "$swapf" | head -1)"
  if [ "$to" = "${AGENTIC_HOST:-claude}" ]; then
    swapped="Resumed on $to after a host swap from $from. The state is portable: the sprint dir (handoff.json / plan-ready.md), .aladdin/config.yaml and .agentic/logs — nothing from the $from session is needed. Capability differences, if any, are listed in .agentic/state/host-swap.json; the harness already takes the correctness path for them."
    "$HERE/events" emit context.rotated --role supervisor --data "source=host-swap" --data "from=$from" --data "to=$to" >/dev/null 2>&1 || true
    mv "$swapf" "$swapf.consumed" 2>/dev/null || true
  fi
fi

[ -f "$AGENTIC_NEXT" ] || [ -n "$swapped" ] || exit 0
# the resume rule: tasks shown done without gate evidence are named, so they get re-gated
rerun="$("$HERE/stats" resume-check 2>/dev/null || true)"
ctx="${swapped:+$swapped

}aloop handoff — docs/agents/NEXT.md, loaded automatically by the SessionStart hook:

$([ -f "$AGENTIC_NEXT" ] && head -c 12000 "$AGENTIC_NEXT" || echo "(no NEXT.md yet: the sprint is mid-flight; resume from plan-ready.md and the gate evidence)")${rerun:+

Resume check (from the gate log, now):
$rerun}"
if command -v python3 >/dev/null 2>&1; then
  CTX="$ctx" python3 -c 'import json,os;print(json.dumps({"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":os.environ["CTX"]}}))'
else
  printf '%s\n' "$ctx"
fi
exit 0
