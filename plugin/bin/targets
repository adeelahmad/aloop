#!/usr/bin/env python3
"""targets — the semantic execution map, first slice (ROADMAP §4.6).

The planner writes structured change targets in <story dir>/targets.json; workers start
from the resolved target instead of scanning the repo. Planned files and symbols form a
shadow workspace: queryable before the code exists, with no stub created in the tree.

targets.json (the semantic plan; with "tasks" it is the execution source and the three
md files are rendered from it — derive anything that can be derived):
  {"story": "S1-01",
   "tasks": [{"id": "T1", "title": "csv writer", "summary": "…", "budget": "tokens_hard=800000",
              "tests": [{"path": "tests/test_csv.py", "fn": "test_writes_rows", "assert": "two rows → two lines"}],
              "validate": [{"run": "python3 -m pytest tests/test_csv.py -q", "expect": "1 passed"}]}],
   "targets": [{"change_ref": "C1", "task": "T1", "operation": "create|modify|extend|refactor|replace|delete",
                "path": "src/x.py", "symbol": "existing_fn" | "planned_symbol": "new_fn",
                "reason": "one line", "evidence_refs": ["..."], "constraints": ["..."]}]}

Usage:
  targets check STORY_DIR             validate every target against tasks.md and the real tree
                                      (exit 2 on a problem). Run by gate-stage2-complete. With
                                      "tasks" in targets.json it also refuses rendered views
                                      that no longer match (hand-edited tasks.md etc.)
  targets render STORY_DIR [--check]  tasks.md, validate.md and plan.md as deterministic views
                                      over the semantic plan ("tasks" + "targets"); --check only
                                      reports views that differ (exit 2)
  targets target TASK STORY_DIR       the task's resolved targets: file:line for an existing
                                      symbol, `planned` for a shadow one
  targets shadow STORY_DIR            the shadow workspace: planned files and symbols
  targets scope TASK STORY_DIR        the task's diff scope (its targets' paths), derived — the
                                      SCOPE_GLOBS gate-green-verify uses when none was given
  targets context REF STORY_DIR [--budget N]
                                      the code a worker needs for change REF, capped at N tokens
                                      (default 2000; ~4 chars per token)
  targets refs|callers|callees REF STORY_DIR
                                      references / incoming / outgoing calls of the target's
                                      symbol, from the LSP server in AGENTIC_LSP_COMMAND. With no
                                      server, or one lacking the capability, it says so and
                                      exits 4 — it never guesses

The symbol backend is ctx-symbols when installed; otherwise a definition regex, and every
answer says it came from the weaker backend.
"""
import json
import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _events  # noqa: E402
import _lsp  # noqa: E402
import _paths  # noqa: E402

OPS = ("create", "modify", "extend", "refactor", "replace", "delete")
NEEDS_REAL = ("modify", "extend", "refactor", "replace", "delete")
REF = re.compile(r"^C\d+$")
HEAD = re.compile(r"^##\s+(T\d+)\b", re.M)
DEF = r"^\s*(?:export\s+)?(?:pub(?:\([^)]*\))?\s+)?(?:async\s+)?(?:def|class|fn|func|function|const|let|var|type|struct|enum|interface|trait|mod)\s+%s\b"
BIN = os.path.dirname(os.path.realpath(__file__))


def tree(cwd=None):
    """The tree the caller works in: a worker's own worktree, not the main checkout."""
    try:
        return subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=cwd or os.getcwd(),
                              capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return os.getcwd()


def load_doc(sdir):
    p = os.path.join(sdir, "targets.json")
    with open(p) as f:
        doc = json.load(f)
    t = doc.get("targets") if isinstance(doc, dict) else None
    if not isinstance(t, list):
        raise ValueError("%s needs a top-level \"targets\" list" % p)
    if "tasks" in doc and not isinstance(doc["tasks"], list):
        raise ValueError("%s: \"tasks\" must be a list" % p)
    for x in t:
        if isinstance(x, dict) and x.get("operation") == "create" and not x.get("planned_symbol") \
                and not x.get("symbol") and planned_test(doc, x):
            x["planned_symbol"] = planned_test(doc, x)
    return doc


def load(sdir):
    return load_doc(sdir)["targets"]


# ---- the semantic plan as the execution source: tasks.md / validate.md / plan.md are views ----
TASK_ID = re.compile(r"^T\d+$")
RENDERED = "<!-- rendered from targets.json by `targets render`: edit targets.json, never this file -->"


def story_id(sdir, doc):
    if doc.get("story"):
        return str(doc["story"])
    m = re.match(r"^s(\d+)-(\d+)-", os.path.basename(os.path.abspath(sdir)))
    return "S%s-%s" % (m.group(1), m.group(2)) if m else "S0-00"


def task_problems(doc):
    """Problems in the semantic plan's tasks (empty = fine, or no tasks given)."""
    p, seen = [], set()
    for i, t in enumerate(doc.get("tasks") or []):
        tid = str(t.get("id", ""))
        where = "task %s (#%d)" % (tid or "?", i)
        if not TASK_ID.match(tid):
            p.append("%s: id must look like T1" % where)
        elif tid in seen:
            p.append("%s: duplicate id" % where)
        seen.add(tid)
        if not str(t.get("title", "")).strip() or "\n" in str(t.get("title", "")):
            p.append("%s: title must be one line" % where)
        tests = t.get("tests")
        if not isinstance(tests, list) or not tests:
            p.append("%s: needs at least one test (plan.md is tests-only; nothing to render)" % where)
            continue
        for j, x in enumerate(tests):
            path, fn = str(x.get("path", "")), str(x.get("fn", ""))
            if not path or os.path.isabs(path) or ".." in path.split("/") or not re.match(r"^[A-Za-z_]\w*$", fn):
                p.append("%s: test #%d needs a repo-relative path and a function name" % (where, j))
            if not str(x.get("assert", "")).strip():
                p.append("%s: test #%d needs an assert (input, action, assertion in one line)" % (where, j))
        for j, v in enumerate(t.get("validate") or []):
            if not str(v.get("run", "")).strip() or not str(v.get("expect", "")).strip():
                p.append("%s: validate #%d needs run and expect" % (where, j))
    return p


def render(sdir, doc):
    """{filename: text} — deterministic views over the semantic plan. Derive what can be derived."""
    sid, tasks, targets = story_id(sdir, doc), doc.get("tasks") or [], doc["targets"]
    fm = lambda kind, extra="": "---\ntype: %s\nstory: %s\n%s---\n%s\n" % (kind, sid, extra, RENDERED)  # noqa: E731
    tk, vd, pl = [fm("tasks")], [fm("validate"), "## Pre-flight\n",
                                 "- `targets check <story dir>`: every change target holds against tasks.md and the tree",
                                 "- `targets render <story dir> --check`: these views match targets.json\n"], \
        [fm("plan", 'scope: "tests only"\n')]
    for t in tasks:
        tid, title = t["id"], str(t["title"]).strip()
        tk.append("## %s — %s\n" % (tid, title))
        if str(t.get("summary", "")).strip():
            tk.append("%s\n" % str(t["summary"]).strip())
        if str(t.get("budget", "")).strip():
            tk.append("budget: %s\n" % str(t["budget"]).strip())
        mine = [x for x in targets if x.get("task") == tid]
        if mine:
            tk.append("Changes:")
            for x in mine:
                sym = x.get("symbol") or x.get("planned_symbol") or ""
                tk.append("- %s %s `%s`%s — %s" % (x["change_ref"], x.get("operation", ""), x.get("path", ""),
                                                 " `%s`" % sym if sym else "", x.get("reason", "")))
            tk.append("")
        pl.append("## %s — %s\n" % (tid, title))
        for x in t["tests"]:
            pl.append("- [ ] `%s::%s` — %s" % (x["path"], x["fn"], str(x["assert"]).strip()))
        pl.append("")
        vd.append("## %s — %s\n" % (tid, title))
        for x in t["tests"]:
            vd.append("- PASS: `%s::%s` passes" % (x["path"], x["fn"]))
        for v in t.get("validate") or []:
            vd.append("- PASS: run `%s` → `%s`" % (str(v["run"]).strip(), str(v["expect"]).strip()))
        vd.append("- FAIL: any file outside this task's Changes is touched (tasks.md scope rule)")
        vd.append("")
    vd += ["## Final sign-off\n", "- every `## T` above is PASS and `targets render <story dir> --check` is clean", ""]
    return {"tasks.md": "\n".join(tk), "validate.md": "\n".join(vd), "plan.md": "\n".join(pl)}


def stale(sdir, doc):
    """Rendered files that differ from their render (hand-edited or missing)."""
    out = []
    for name, text in render(sdir, doc).items():
        try:
            cur = open(os.path.join(sdir, name)).read()
        except OSError:
            cur = None
        if cur != text:
            out.append(name)
    return out


def ctx_symbols():
    try:
        r = subprocess.run([os.path.join(BIN, "ensure-tools"), "--resolve", "ctx-symbols"],
                           capture_output=True, text=True)
        return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None
    except OSError:
        return None


def locate(root, path, symbol):
    """(line, backend) of symbol's definition in path, or (None, backend)."""
    full = os.path.join(root, path)
    real = ctx_symbols()
    if real:
        r = subprocess.run([real, "locate", symbol, "--tree", root], capture_output=True, text=True)
        if r.returncode == 0:
            for ln in r.stdout.splitlines():
                parts = ln.rsplit(":", 2)
                if len(parts) == 3 and parts[1].isdigit() and os.path.realpath(
                        os.path.join(root, parts[0])) == os.path.realpath(full):
                    return int(parts[1]), "ctx-symbols"
            return None, "ctx-symbols"
    pat = re.compile(DEF % re.escape(symbol))
    try:
        with open(full) as f:
            for i, ln in enumerate(f, 1):
                if pat.match(ln):
                    return i, "regex (weaker: ctx-symbols not installed)"
    except OSError:
        pass
    return None, "regex (weaker: ctx-symbols not installed)"


def planned_test(doc, t):
    """A new test file's planned symbol is the first test the plan lists for that path (live runs
    36-41: 8 planner blocks on a test-file create with no planned_symbol)."""
    for d in (doc or {}).get("tasks") or []:
        if str(d.get("id")) == str(t.get("task")):
            for x in d.get("tests") or []:
                if x.get("path") == t.get("path") and x.get("fn"):
                    return x["fn"]
    return ""


def problems(sdir, targets, root, doc=None):
    p, seen = [], set()
    if doc and doc.get("tasks") is not None:        # the semantic plan names the tasks; tasks.md is its view
        tasks = {str(t.get("id")) for t in doc["tasks"]}
    else:
        tasks = set(HEAD.findall(open(os.path.join(sdir, "tasks.md")).read())) if os.path.exists(
            os.path.join(sdir, "tasks.md")) else set()
    planned = {t.get("path") for t in targets if t.get("operation") == "create"}
    # A symbol another target plans may be modified by a later task (live run 46: T2 extended
    # src/main.rs with parse_args, T3 modified it; 4 planner blocks "not defined").
    planned_syms = {(t.get("path"), t.get("planned_symbol"), t.get("change_ref")) for t in targets
                    if t.get("planned_symbol")}
    for i, t in enumerate(targets):
        ref = t.get("change_ref", "")
        where = "%s (#%d)" % (ref or "target", i)
        if not REF.match(str(ref)):
            p.append("%s: change_ref must look like C1" % where)
        elif ref in seen:
            p.append("%s: duplicate change_ref" % where)
        seen.add(ref)
        if t.get("task") not in tasks:
            p.append("%s: task %r is not a ## heading in tasks.md" % (where, t.get("task")))
        op, path = t.get("operation"), t.get("path", "")
        if op not in OPS:
            p.append("%s: operation must be one of %s" % (where, ", ".join(OPS)))
            continue
        if not path or os.path.isabs(path) or ".." in path.split("/"):
            p.append("%s: path must be repo-relative" % where)
            continue
        if not str(t.get("reason", "")).strip() or "\n" in str(t.get("reason", "")):
            p.append("%s: reason must be one line" % where)
        for k in ("evidence_refs", "constraints"):
            if not isinstance(t.get(k, []), list):
                p.append("%s: %s must be a list" % (where, k))
        exists = os.path.exists(os.path.join(root, path))
        if op == "create":
            psym = t.get("planned_symbol")
            if not psym:
                p.append("%s: create needs planned_symbol" % where)
            if t.get("symbol"):
                p.append("%s: create names a planned_symbol, not an existing symbol" % where)
            # A create whose file now exists AND defines its planned_symbol is realized (its task
            # merged; a mid-sprint re-plan re-checks the whole plan), not a defect.
            if exists and (not psym or locate(root, path, psym)[0] is None):
                p.append("%s: create targets %s, which already exists (use modify/extend)" % (where, path))
        elif not exists and path not in planned:
            # live runs 47-48: `extend tests/common/mod.rs` for a helper module no target created
            p.append("%s: %s targets %s, which is neither in the tree nor planned: a new file is a create "
                     "(\"operation\": \"create\" with its first planned_symbol), and a later target may "
                     "extend it" % (where, op, path))
        elif exists and t.get("symbol"):
            line, _ = locate(root, path, t["symbol"])
            if line is None and not any(pp == path and ps == t["symbol"] and pr != ref
                                        for pp, ps, pr in planned_syms):
                p.append("%s: symbol %s is not defined in %s" % (where, t["symbol"], path))
        elif op in NEEDS_REAL and not t.get("symbol") and not t.get("planned_symbol"):
            p.append("%s: %s needs a symbol (or a planned_symbol for extend)" % (where, op))
    if doc and doc.get("tasks") and not os.path.exists(os.path.join(sdir, "plan-ready.md")):
        p += merge_problems(doc["tasks"], targets)
    return p


MERGE_TESTS = 8  # "a handful of tests": two tasks this small on the same files are one


def merge_problems(tasks, targets):
    """Adjacent tasks on the same files with a handful of tests between them are one task: each
    task costs a fixed RED/SCAFFOLD/GREEN cycle (live runs 44 and 47: a wc-like CLI planned as 7
    and 5 tasks of 1-5 tests). Checked only before execution starts, so a re-plan never merges
    a task that is already done."""
    files = {}
    for t in targets:
        files.setdefault(str(t.get("task")), set()).add(t.get("path"))
    for t in tasks:
        files.setdefault(str(t.get("id")), set()).update(x.get("path") for x in t.get("tests") or [])
    p = []
    for a, b in zip(tasks, tasks[1:]):
        fa, fb = files.get(str(a.get("id")), set()), files.get(str(b.get("id")), set())
        n = len(a.get("tests") or []) + len(b.get("tests") or [])
        if fa and fb and (fa <= fb or fb <= fa) and n <= MERGE_TESTS:
            p.append("%s and %s change the same files (%s) with %d tests between them: plan them as ONE "
                     "task, one test per behaviour (every task costs a fixed RED, SCAFFOLD and GREEN "
                     "cycle); split only past the soft limit" % (a.get("id"), b.get("id"),
                                                                ", ".join(sorted(fa | fb)), n))
    return p


def resolve(t, root):
    if t.get("operation") == "create" and t.get("planned_symbol") and os.path.exists(os.path.join(root, t["path"])):
        line, be = locate(root, t["path"], t["planned_symbol"])
        if line is not None:                     # realized create: the planned file and symbol exist now
            return "%s %s %s:%s %s [%s] — %s" % (t["change_ref"], t["operation"], t["path"], line,
                                                 t["planned_symbol"], be, t.get("reason", ""))
    if t.get("operation") == "create" or not os.path.exists(os.path.join(root, t["path"])):
        return "%s %s %s %s (planned, shadow) — %s" % (t["change_ref"], t["operation"], t["path"],
                                                        t.get("planned_symbol", ""), t.get("reason", ""))
    if t.get("symbol"):
        line, be = locate(root, t["path"], t["symbol"])
        if line is None:                         # a symbol an earlier task plans (check allows only that)
            return "%s %s %s %s (planned, shadow) — %s" % (t["change_ref"], t["operation"], t["path"],
                                                            t["symbol"], t.get("reason", ""))
        return "%s %s %s:%s %s [%s] — %s" % (t["change_ref"], t["operation"], t["path"], line, t["symbol"], be,
                                             t.get("reason", ""))
    return "%s %s %s %s (new symbol in an existing file) — %s" % (
        t["change_ref"], t["operation"], t["path"], t.get("planned_symbol", ""), t.get("reason", ""))


def context(t, root, budget):
    out = [resolve(t, root)]
    for c in t.get("constraints") or []:
        out.append("constraint: %s" % c)
    full = os.path.join(root, t["path"])
    if os.path.exists(full) and t.get("symbol"):
        line, _ = locate(root, t["path"], t["symbol"])
        lines = open(full).read().splitlines()
        if line:
            ind = len(lines[line - 1]) - len(lines[line - 1].lstrip())
            body = [lines[line - 1]]
            for ln in lines[line:]:
                if ln.strip() and len(ln) - len(ln.lstrip()) <= ind and not ln.lstrip().startswith(("}", ")", "]")):
                    break
                body.append(ln)
            out.append("--- %s:%d" % (t["path"], line))
            out += body
    elif os.path.exists(full):
        out.append("--- %s (outline)" % t["path"])
        out += [ln for ln in open(full).read().splitlines() if re.match(DEF % r"\w+", ln)]
    else:
        d = os.path.dirname(full)
        out.append("--- %s does not exist yet; siblings in %s/:" % (t["path"], os.path.dirname(t["path"]) or "."))
        out += sorted(os.listdir(d)) if os.path.isdir(d) else ["(new directory)"]
    text, cap = "\n".join(out), budget * 4
    return text if len(text) <= cap else text[:cap] + "\n… (truncated at --budget %d tokens)" % budget


def served(sdir, t, how):
    """semantic_target.resolved: a worker started from a target instead of scanning (§4.10)."""
    m = re.match(r"^s(\d+)-(\d+)-", os.path.basename(os.path.abspath(sdir)))
    task = "S%s-%s-%s" % (m.group(1), m.group(2), t.get("task")) if m else ""
    try:
        _events.emit(os.getcwd(), "semantic_target.resolved", task=task, refs={"targets": os.path.join(sdir, "targets.json")},
                     change_ref=t.get("change_ref"), via=how)
    except Exception:  # noqa: BLE001 — telemetry never fails the caller
        pass


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    flags = {a for a in argv if a == "--check"}
    argv = [a for a in argv if a not in flags]
    opts, pos, k = {}, [], None
    for a in argv[1:]:
        if k:
            opts[k], k = a, None
        elif a.startswith("--"):
            k = a[2:]
        else:
            pos.append(a)
    cmd, root = argv[0], tree()
    need = {"check": 1, "render": 1, "shadow": 1, "scope": 2, "target": 2, "context": 2, "refs": 2, "callers": 2, "callees": 2}
    if cmd not in need or len(pos) < need[cmd]:
        print("targets: unknown or incomplete command (see targets --help)", file=sys.stderr)
        return 64
    sdir = pos[-1]
    try:
        doc = load_doc(sdir)
    except (OSError, ValueError) as e:
        print("BLOCK[targets]: %s" % e, file=sys.stderr)
        return 2
    targets = doc["targets"]
    if cmd == "render":
        bad = task_problems(doc)
        if doc.get("tasks") is None:
            bad.append("targets.json has no \"tasks\": nothing to render (add tasks: [{id, title, tests: [...]}])")
        for b in bad:
            print("BLOCK[targets]: %s" % b, file=sys.stderr)
        if bad:
            return 2
        old = stale(sdir, doc)
        if "--check" in flags:
            for n in old:
                print("BLOCK[targets]: %s/%s differs from its render of targets.json — edit targets.json and run "
                      "`targets render %s`" % (sdir, n, sdir), file=sys.stderr)
            return 2 if old else 0
        for name, text in render(sdir, doc).items():
            if name in old:
                with open(os.path.join(sdir, name), "w") as f:
                    f.write(text)
                print("rendered %s/%s from targets.json" % (sdir, name))
        if old:
            try:
                _events.emit(os.getcwd(), "artifact.updated", refs={"targets": os.path.join(sdir, "targets.json")},
                             rendered=old)
            except Exception:  # noqa: BLE001
                pass
        return 0
    if cmd == "check":
        bad = task_problems(doc) + problems(sdir, targets, root, doc)
        if doc.get("tasks") is not None and not bad:
            bad += ["%s/%s differs from its render of targets.json — edit targets.json and run `targets render %s`"
                    % (sdir, n, sdir) for n in stale(sdir, doc)]
        for b in bad:
            print("BLOCK[targets]: %s" % b, file=sys.stderr)
        if not bad:
            print("[targets] %d change targets valid in %s" % (len(targets), sdir), file=sys.stderr)
        return 2 if bad else 0
    if cmd == "shadow":
        for t in targets:
            if t.get("operation") == "create" or t.get("planned_symbol"):
                print("%s\t%s\t%s\t%s" % (t["path"], t.get("planned_symbol", ""),
                                          "planned-file" if t.get("operation") == "create" else "planned-symbol",
                                          t["change_ref"]))
        return 0
    if cmd == "scope":
        paths = sorted({t["path"] for t in targets if t.get("task") == pos[0] and t.get("path")})
        print(" ".join(paths))
        return 0 if paths else 1
    if cmd == "target":
        mine = [t for t in targets if t.get("task") == pos[0]]
        for t in mine:
            print(resolve(t, root))
            served(sdir, t, "target")
        return 0 if mine else 1
    match = [t for t in targets if t.get("change_ref") == pos[0]]
    if not match:
        print("targets: no change_ref %s in %s" % (pos[0], sdir), file=sys.stderr)
        return 1
    if cmd == "context":
        print(context(match[0], root, int(opts.get("budget", 2000))))
        served(sdir, match[0], "context")
        return 0
    return structural(cmd, match[0], root)


def structural(cmd, t, root):
    """refs / callers / callees through the LSP seam; any gap is reported (exit 4)."""
    if t.get("operation") == "create" or not os.path.exists(os.path.join(root, t["path"])) or not t.get("symbol"):
        print("# %s is planned (shadow): it has no %s yet" % (t.get("planned_symbol") or t["path"], cmd))
        return 0
    lsp = os.environ.get("AGENTIC_LSP_COMMAND") or _paths.settings(root).get("LSP_COMMAND") or ""
    if not lsp:
        print("targets %s: no structural (LSP) backend is configured (AGENTIC_LSP_COMMAND); %s needs references "
              "and the call hierarchy, which the regex/ctx-symbols backends cannot answer. Not guessing." % (cmd, cmd),
              file=sys.stderr)
        return 4
    line, _ = locate(root, t["path"], t["symbol"])
    if not line:
        print("targets %s: %s is not defined in %s" % (cmd, t["symbol"], t["path"]), file=sys.stderr)
        return 2
    text = open(os.path.join(root, t["path"])).read().splitlines()[line - 1]
    col = text.find(t["symbol"])
    client = None
    try:
        client = _lsp.Client(lsp, root)
        if cmd == "refs":
            rows = ["%s:%d:%d" % r for r in client.references(t["path"], line, col)]
        else:
            rows = ["%s:%d %s" % r for r in client.calls(t["path"], line, col, "incoming" if cmd == "callers" else "outgoing")]
    except _lsp.Missing as e:
        print("targets %s: %s. Not guessing." % (cmd, e), file=sys.stderr)
        return 4
    finally:
        if client:
            client.close()
    print("\n".join(rows) if rows else "# no %s for %s" % (cmd, t["symbol"]))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
