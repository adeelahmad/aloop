#!/usr/bin/env bash
# bind — a worker's FIRST command on Codex / OpenCode:   aloop bind <worktree>
#
# Validates that <worktree> is a linked git worktree carrying this task's
# task.env copy (.aladdin/ or .agentic/). The binding itself is recorded by the host-adapter hook, which
# sees this command together with the worker's agent id; from then on every shell
# command and file edit of that worker is confined to <worktree>, and its gates run
# there. (On Claude Code the Agent tool's isolation: "worktree" does this natively;
# `aloop bind` is then just a harmless check.)
set -uo pipefail
wt="${1:-}"
[ -n "$wt" ] || { echo "bind: usage: aloop bind <absolute worktree path>" >&2; exit 64; }
case "$wt" in /*) ;; *) echo "bind: the path must be absolute" >&2; exit 64 ;; esac
[ -f "$wt/.git" ] || { echo "bind: $wt is not a linked git worktree (create it with: aloop task-worktree add <TASK_ID>)" >&2; exit 2; }
te=""; for h in .aladdin .agentic; do [ -f "$wt/$h/task.env" ] && { te="$wt/$h/task.env"; break; }; done
[ -n "$te" ] || { echo "bind: $wt/.aladdin/task.env missing — the supervisor writes it before dispatch (aloop task-worktree add)" >&2; exit 2; }
echo "bound: $wt ($(grep -E '^(TASK_ID|AGENT_ROLE|ATTEMPT)=' "$te" | tr '\n' ' '))"
echo "Run EVERY shell command as:  cd $wt && <command>   and use absolute paths under $wt for every file edit."
