{
 "title": "baseline — where the product stands, measured reproducibly and confirmed by the human (ROADMAP §4.12, M9.2): docs/agents/mission/baseline/<baseline_id>.json",
 "type": "object",
 "required": [
  "baseline_id",
  "version",
  "direction_sha256",
  "definition_of_best",
  "journeys",
  "benchmarks",
  "rivals",
  "tolerance",
  "status",
  "created_at"
 ],
 "additionalProperties": false,
 "properties": {
  "baseline_id": {
   "type": "string",
   "pattern": "^bln_"
  },
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "direction_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "definition_of_best": {
   "type": "string",
   "minLength": 1
  },
  "journeys": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "journey_id",
     "sha256"
    ],
    "additionalProperties": false,
    "properties": {
     "journey_id": {
      "type": "string",
      "pattern": "^jrn_"
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     }
    }
   }
  },
  "benchmarks": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "command",
     "source_refs"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "command": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "pinned": {
      "type": "object"
     },
     "timeout_s": {
      "type": "integer",
      "minimum": 1
     },
     "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "files": {
      "type": "object",
      "description": "{project path: sha256} the harness pinned for the files the command runs; a changed file stops the run"
     }
    }
   }
  },
  "rivals": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "tolerance": {
   "type": "number",
   "minimum": 0,
   "maximum": 0.25
  },
  "supersedes": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^bln_"
  },
  "evidence_refs": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "measurements": {
   "type": [
    "object",
    "null"
   ]
  },
  "status": {
   "enum": [
    "proposed",
    "measured",
    "confirmed",
    "superseded",
    "vetoed"
   ]
  },
  "created_at": {
   "type": "string",
   "minLength": 1
  },
  "approval": {
   "type": "object"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  }
 }
}
