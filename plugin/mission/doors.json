{
 "version": 1,
 "default_branch": "main|master",
 "doors": [
  {
   "id": "push-default-branch",
   "grant": "standing",
   "title": "Push or merge into the default branch",
   "why": "others build on it; undoing it is a new public change",
   "bash": [
    {
     "prog": "git",
     "args": "^push\\b{DRY}",
     "flag": "\\+?(?:[^:\\s]*:)?(?:refs/heads/)?{DEF}"
    },
    {
     "prog": "git",
     "args": "^push{DRY}(?:\\s+(?:-u|--set-upstream))?(?:\\s+[\\w.-]+)?(?:\\s+(?:HEAD|@)(?::HEAD)?)?$",
     "when": "on-default-branch"
    },
    {
     "prog": "gh",
     "args": "^pr\\s+merge\\b{DRY}"
    }
   ],
   "tools": [
    "(?i)^(?:mcp__[\\w-]+?__|(?!mcp__)[\\w-]+?_)(?:\\w+_)?(?:merge_(?:a_)?(?:pull|merge)_request|merge_?pull_?request|accept_merge_request|enable_(?:pr_)?auto_?merge)$",
    {
     "tool": "(?i)^(?:mcp__[\\w-]+?__|(?!mcp__)[\\w-]+?_)(?:\\w+_)?(?:push_files|create_or_update_file(?:_contents)?|delete_(?:a_)?file)$",
     "input": {
      "branch": "{DEF}"
     }
    }
   ],
   "examples": {
    "bash": [
     "git push origin main",
     "git -C r push origin HEAD:master",
     "bash -c \"git push origin main\"",
     "gh pr merge 12 --squash",
     "git push",
     "# ship it\ngit push origin main",
     "git push \\\n  origin main",
     "echo ${#a[@]} && git push origin main",
     "bash <<'EOF'\ngit push origin main\nEOF",
     "cd sub && git push origin main",
     "git push origin HEAD"
    ],
    "tools": [
     "mcp__github__merge_pull_request",
     "github_merge_pull_request",
     "github_enable_pr_auto_merge",
     "mcp__github-mcp__merge_pull_request",
     "mcp__gitlab__merge_merge_request",
     "mcp__composio__GITHUB_MERGE_A_PULL_REQUEST",
     "mcp__bitbucket__mergePullRequest"
    ]
   }
  },
  {
   "id": "force-push-or-delete-remote",
   "grant": "standing",
   "title": "Force-push, or delete a remote branch or tag",
   "why": "it rewrites or removes history others may already have",
   "bash": [
    {
     "prog": "git",
     "args": "^push\\b{DRY}",
     "flag": "-f|--force|--force-with-lease(?:=.*)?|--force-if-includes|--mirror|--delete|--prune|-d|-[A-Za-z]*[fd][A-Za-z]*|[+:]\\S+"
    }
   ],
   "examples": {
    "bash": [
     "git push --force origin f",
     "git push origin :old",
     "git push origin +f",
     "git push --delete origin v1"
    ]
   }
  },
  {
   "id": "discard-local-work",
   "grant": "standing",
   "title": "Discard uncommitted or unpushed work in the main checkout",
   "why": "work that was never committed or pushed cannot be brought back",
   "bash": [
    {
     "prog": "git",
     "when": "main-worktree",
     "args": "^(?:reset\\b.*\\s--hard\\b|clean\\b.*\\s-[A-Za-z]*f|checkout\\s+(?:--\\s+)?\\.$|restore\\b(?!.*--staged).*\\s\\.$|stash\\s+(?:drop|clear)\\b|branch\\s+.*-D\\b|worktree\\s+remove\\b.*--force)"
    }
   ],
   "examples": {
    "bash": [
     "git reset --hard",
     "git clean -fdx",
     "git stash clear",
     "git branch -D old",
     "git checkout -- ."
    ]
   }
  },
  {
   "id": "publish-release",
   "grant": "standing",
   "title": "Publish a release or a package",
   "why": "a published version is public and cannot be cleanly unpublished",
   "bash": [
    {
     "prog": "npm|pnpm|yarn|bun",
     "args": "^publish\\b{DRY}"
    },
    {
     "prog": "cargo",
     "args": "^publish\\b{DRY}"
    },
    {
     "prog": "twine",
     "args": "^upload\\b{DRY}"
    },
    {
     "prog": "gem",
     "args": "^push\\b{DRY}"
    },
    {
     "prog": "poetry|uv|hatch|flit",
     "args": "^publish\\b{DRY}"
    },
    {
     "prog": "gh",
     "args": "^release\\s+(?:create|upload|edit|delete)\\b{DRY}"
    },
    {
     "prog": "git",
     "args": "^push\\b{DRY}.*\\s--tags\\b"
    },
    {
     "prog": "docker|podman",
     "args": "^(?:image\\s+)?push\\b{DRY}"
    }
   ],
   "examples": {
    "bash": [
     "npm publish",
     "cargo publish",
     "gh release create v1.0.0",
     "docker push me/app:1",
     "twine upload dist/x.whl",
     "git push origin --tags",
     "# release\nnpm publish",
     "find dist -name '*.tgz' -exec npm publish {} \\;",
     "npm publish --dry-run=false"
    ]
   }
  },
  {
   "id": "production-deploy",
   "grant": "standing",
   "title": "Deploy, or change live infrastructure",
   "why": "users see it at once; a rollback is a new change",
   "bash": [
    {
     "prog": "terraform|tofu",
     "args": "^(?:apply|destroy|import|state\\s+(?:rm|mv|push))\\b{DRY}"
    },
    {
     "prog": "pulumi",
     "args": "^(?:up|destroy|refresh)\\b{DRY}"
    },
    {
     "prog": "kubectl",
     "args": "^(?:apply|create|delete|replace|patch|scale|set|edit|drain|cordon|rollout\\s+(?:restart|undo))\\b{DRY}"
    },
    {
     "prog": "helm",
     "args": "^(?:install|upgrade|uninstall|rollback|delete)\\b{DRY}"
    },
    {
     "prog": "cdk",
     "args": "^(?:deploy|destroy)\\b{DRY}"
    },
    {
     "prog": "serverless|sls",
     "args": "^(?:deploy|remove)\\b{DRY}"
    },
    {
     "prog": "fly|flyctl",
     "args": "^deploy\\b{DRY}"
    },
    {
     "prog": "vercel",
     "args": "^{DRY}.*(?:^|\\s)--prod\\b"
    },
    {
     "prog": "netlify",
     "args": "^deploy\\b{DRY}.*--prod\\b"
    },
    {
     "prog": "gcloud",
     "args": "^{DRY}(?:.*\\s)?deploy(?:\\s|$)(?!(?:\\S+\\s+)?(?:list|describe|get-iam-policy|export)(?:\\s|$))"
    },
    {
     "prog": "aws",
     "args": "^{DRY}(?:cloudformation\\s+(?:deploy|delete-stack|update-stack)|ecs\\s+update-service|lambda\\s+update-function-code|ec2\\s+terminate-instances|s3\\s+(?:rm|sync)\\b.*--delete)"
    }
   ],
   "examples": {
    "bash": [
     "terraform apply -auto-approve",
     "kubectl apply -f k8s/",
     "helm upgrade app ./chart",
     "fly deploy",
     "vercel --prod",
     "kubectl apply --dry-run=none -f k8s/",
     "terraform \\\n  apply -auto-approve",
     "gcloud --project p app deploy",
     "gcloud run jobs deploy j --image x"
    ]
   }
  },
  {
   "id": "send-external-message",
   "grant": "standing",
   "title": "Send a message or a post outside the project",
   "why": "a sent message cannot be unsent; others read and act on it",
   "bash": [
    {
     "prog": "sendmail|mail|mailx|mutt"
    }
   ],
   "tools": [
    "(?i)^(?:mcp__(?:[\\w-]*?(?:gmail|mail|outlook|slack|teams|discord|telegram|twitter|linkedin|ms365|m365)[\\w-]*?__(?:(?:gmail|mail|outlook|slack|teams|discord|telegram|twitter|linkedin|ms365|m365)[_-])?|[\\w-]+?__\\w*?(?:gmail|mail|outlook|slack|teams|discord|telegram|twitter|linkedin|ms365|m365)[A-Za-z0-9]*[_-])|(?!mcp__)[\\w-]*?(?:gmail|mail|outlook|slack|teams|discord|telegram|twitter|linkedin|ms365|m365)[A-Za-z0-9-]*_(?:(?:gmail|mail|outlook|slack|teams|discord|telegram|twitter|linkedin|ms365|m365)[_-])?)(?:(?:chat[_-]?)?(?:send|reply|forward|post|schedule[_-]?(?:message|post|email|mail|send))|(?:conversations[_-])?add[_-]message)(?!s(?:$|[_-](?!an?[_-]))|ed(?:$|[_-])|ing)(?![\\w-]*(?:message|mail|email)[_-]draft$)[\\w-]*$",
    "(?i)^(?:mcp__[\\w-]+?__|(?!mcp__)[\\w-]+?_)(?:send|reply|forward|post)[_-](?:[\\w-]*?[_-])?(?:gmail|mail|outlook|slack|teams|discord|telegram|twitter|linkedin|ms365|m365)(?![\\w-]*(?:message|mail|email)[_-]draft$)[\\w-]*$"
   ],
   "examples": {
    "bash": [
     "mail -s hi a@b.c"
    ],
    "tools": [
     "mcp__Gmail__send_message",
     "mcp__slack__post_message",
     "mcp__slack__slack_post_message",
     "mcp__slack__slack_reply_to_thread",
     "Gmail_send_message",
     "slack_slack_post_message",
     "slack_post_message",
     "mcp__slack-mcp__post_message",
     "mcp__zapier__gmail_send_email",
     "mcp__composio__GMAIL_SEND_EMAIL",
     "mcp__slack__chat_postMessage",
     "mcp__slack__SLACK_SENDS_A_MESSAGE_TO_A_SLACK_CHANNEL",
     "mcp__discord__send-message",
     "mcp__ms365__send-mail",
     "mcp__slack__slack_schedule_message",
     "mcp__slack__conversations_add_message",
     "mcp__google-workspace__send_gmail_message",
     "mcp__ms365__send-shared-mailbox-draft",
     "mcp__gmail__send_saved_draft"
    ]
   }
  },
  {
   "id": "system-change",
   "grant": "standing",
   "title": "Change the machine outside the project",
   "why": "it affects every project and user on the machine",
   "bash": [
    {
     "prog": "sudo|doas|su"
    },
    {
     "prog": "apt|apt-get|yum|dnf|zypper|apk",
     "args": "^(?:install|remove|purge|upgrade|dist-upgrade|autoremove|add|del)\\b"
    },
    {
     "prog": "pacman",
     "args": "^-[A-Za-z]*(?:[RU]|S(?![A-Za-z]*[sigpl]))"
    },
    {
     "prog": "brew",
     "args": "^(?:install|uninstall|reinstall|upgrade|remove|tap|untap)\\b"
    },
    {
     "prog": "systemctl|service",
     "args": "\\b(?:start|stop|restart|reload|enable|disable|mask|kill|daemon-reload)\\b"
    },
    {
     "prog": "launchctl",
     "args": "^(?:load|unload|bootstrap|bootout|enable|disable|kickstart)\\b"
    },
    {
     "prog": "crontab",
     "args": "^(?!-l\\b)"
    },
    {
     "prog": "npm|pnpm|yarn",
     "flag": "-g|--global",
     "args": "^(?:(?:--(?:loglevel|prefix|registry|reporter|dir|filter|workspace|userconfig|globalconfig|cache|location|tag|otp)|-[Cw])\\s+\\S+\\s+|-\\S+\\s+)*(?:i|in|ins|inst|insta|instal|install|isnt|isnta|isntal|isntall|add|un|uninstall|unlink|remove|rm|r|update|up|upgrade|udpate|link|ln|it|cit|install-test|install-ci-test|clean-install|ci|rb|rebuild|prune|dedupe|ddp|config\\s+(?:set|delete|edit)|set)(?:\\s|$)"
    },
    {
     "prog": "yarn",
     "args": "^global\\s+(?:add|remove|upgrade|upgrade-interactive)\\b"
    }
   ],
   "examples": {
    "bash": [
     "sudo rm -rf /opt/x",
     "apt-get install -y jq",
     "brew install jq",
     "systemctl restart nginx",
     "npm install -g pnpm",
     "crontab -e",
     "pacman -Syu",
     "yarn global add pnpm",
     "npm -g install pnpm",
     "pnpm add -g pnpm",
     "npm i -g",
     "npm -g --loglevel warn install pnpm",
     "npm -g ins pnpm",
     "pnpm --reporter silent add -g pnpm"
    ]
   }
  },
  {
   "id": "destructive-db",
   "grant": "once",
   "title": "Drop, truncate or bulk-delete data in a database",
   "why": "deleted data is gone unless a backup is restored",
   "bash": [
    {
     "prog": "psql|mysql|mariadb|sqlite3|sqlcmd|duckdb|clickhouse-client|cockroach",
     "args": "(?i)\\b(?:drop\\s+(?:table|database|schema|view|index)|truncate\\b|delete\\s+from\\s+\\S+\\s*(?:;|$))"
    },
    {
     "prog": "dropdb|dropuser"
    },
    {
     "prog": "redis-cli",
     "args": "(?i)\\bflush(?:all|db)\\b"
    },
    {
     "prog": "mongo|mongosh",
     "args": "(?i)\\b(?:dropDatabase|\\.drop\\(\\)|deleteMany\\(\\{\\}\\))"
    },
    {
     "prog": "rails|rake",
     "args": "^db:(?:drop|reset|purge|schema:load)\\b"
    },
    {
     "prog": "prisma",
     "args": "^(?:migrate\\s+reset|db\\s+push\\b.*--force-reset)"
    },
    {
     "prog": "npx|bunx|pnpm",
     "args": "^(?:exec\\s+)?prisma\\s+(?:migrate\\s+reset|db\\s+push\\b.*--force-reset)"
    }
   ],
   "examples": {
    "bash": [
     "psql -c 'DROP TABLE users'",
     "redis-cli FLUSHALL",
     "dropdb app",
     "rails db:drop",
     "sqlite3 app.db 'DELETE FROM users;'"
    ]
   }
  },
  {
   "id": "visibility-or-sharing",
   "grant": "once",
   "title": "Make something public, or share it with others",
   "why": "once seen or copied it cannot be made private again",
   "bash": [
    {
     "prog": "gh",
     "args": "^(?:repo\\s+(?:edit\\b.*--visibility\\s+public|create\\b.*--public)|gist\\s+create\\b.*\\s(?:--public|-p)\\b)"
    }
   ],
   "tools": [
    "(?i)^(?:mcp__[\\w-]+?__|(?!mcp__)[\\w-]+?_)(?:(?!(?:get|list|read|search|find|fetch|describe|view|show|query)_)\\w*?_)?(?:share(?:_\\w*?)?_file|share|add_\\w*?permission|create_\\w*?permission)$",
    {
     "tool": "(?i)^(?:mcp__[\\w-]+?__|(?!mcp__)[\\w-]+?_)manage_\\w*access$",
     "input": {
      "action": "(?i)(?:grant|update|transfer)\\w*"
     }
    },
    {
     "tool": "(?i)^(?:mcp__[\\w-]+?__|(?!mcp__)[\\w-]+?_)set_\\w*permissions?$",
     "input": {
      "link_sharing": "(?!off$).+"
     }
    }
   ],
   "examples": {
    "bash": [
     "gh repo edit --visibility public",
     "gh gist create --public a.txt"
    ],
    "tools": [
     "mcp__Google_Drive__share_file",
     "Google_Drive_share_file",
     "mcp__zapier__google_drive_share_file",
     "mcp__google-drive__share_file",
     "google-drive_share_file"
    ]
   }
  },
  {
   "id": "credentials-and-secrets",
   "grant": "once",
   "title": "Set, rotate, reveal or delete a secret or credential",
   "why": "a leaked or lost credential cannot be taken back",
   "bash": [
    {
     "prog": "gh",
     "args": "^(?:(?:secret|variable)\\s+(?:set|delete|remove)|auth\\s+token)\\b{DRY}"
    },
    {
     "prog": "vault",
     "args": "^(?:kv\\s+(?:put|delete|destroy|patch)|write|delete)\\b{DRY}"
    },
    {
     "prog": "aws",
     "args": "^(?:secretsmanager\\s+(?:create|put|delete|update|get-secret-value)|iam\\s+(?:create-access-key|delete-access-key|attach-|put-)){DRY}"
    },
    {
     "prog": "kubectl",
     "args": "^(?:create|delete)\\s+secret\\b{DRY}"
    },
    {
     "prog": "security",
     "args": "^(?:add|delete|find)-(?:generic|internet)-password\\b{DRY}"
    },
    {
     "prog": "op",
     "args": "^(?:item\\s+(?:create|edit|delete|get)|read)\\b{DRY}"
    }
   ],
   "examples": {
    "bash": [
     "gh secret set TOKEN",
     "vault kv put secret/x a=1",
     "op read op://v/i/f"
    ]
   }
  },
  {
   "id": "change-agent-settings",
   "grant": "standing",
   "title": "Change the agent's own settings, hooks or gates",
   "why": "settings and gates decide what every later step may do",
   "paths": [
    "(?:^|/)\\.claude/settings(?:\\.local)?\\.json$",
    "(?:^|/)\\.codex/(?:config\\.toml|hooks\\.json|agents/[^/]+\\.toml)$",
    "(?:^|/)(?:\\.opencode|\\.config/opencode)/plugins/aloop\\.js$",
    "^opencode\\.jsonc?$",
    "(?:^|/)(?:\\.opencode|\\.config/opencode|worktrees/[^/]+)/opencode\\.jsonc?$",
    "(?:^|/)\\.config/opencode/config\\.json$",
    "(?:^|/)\\.dsh/profiles/[^/]+/(?:cordis\\.patch\\.yml|package\\.json)$"
   ],
   "plugin_paths": [
    "^hooks/hooks\\.json$",
    "^bin/(?:gate-[^/]+|_failclosed\\.sh|_gatelib\\.sh|host-adapter|install)$",
    "^hosts/(?:opencode/aloop\\.js|dsh/aloop\\.mjs)$",
    "^mission/doors\\.(?:json|py)$"
   ],
   "bash": [
    {
     "writes": "(?:^|/)\\.claude/settings(?:\\.local)?\\.json$"
    },
    {
     "writes": "(?:^|/)(?:\\.codex/(?:config\\.toml|hooks\\.json|agents/[^/]+\\.toml)|(?:\\.opencode|\\.config/opencode)/plugins/aloop\\.js|(?:\\.opencode|\\.config/opencode|worktrees/[^/]+)/opencode\\.jsonc?|\\.config/opencode/config\\.json|\\.dsh/profiles/[^/]+/(?:cordis\\.patch\\.yml|package\\.json))$|^opencode\\.jsonc?$"
    },
    {
     "writes": "^(?:(?:~/|\\$[^/]*/)?(?:\\.claude|\\.codex(?:/agents)?|\\.opencode(?:/plugins)?|\\.config(?:/opencode(?:/plugins)?)?|\\.dsh(?:/profiles(?:/[^/]+)?)?)(?:/[*?])?/?|(?:~/)?\\*)$"
    },
    {
     "prog": "rm|unlink|truncate|shred",
     "files": "(?:^|/)(?:\\.claude/settings(?:\\.local)?\\.json|\\.codex/(?:config\\.toml|hooks\\.json|agents/[^/]+\\.toml)|(?:\\.opencode|\\.config/opencode)/plugins/aloop\\.js|(?:\\.opencode|\\.config/opencode|worktrees/[^/]+)/opencode\\.jsonc?|\\.config/opencode/config\\.json|\\.dsh/profiles/[^/]+/(?:cordis\\.patch\\.yml|package\\.json))$|^opencode\\.jsonc?$|^(?:~/|\\$[^/]*/)?(?:\\.claude|\\.codex(?:/agents)?|\\.opencode(?:/plugins)?|\\.config(?:/opencode(?:/plugins)?)?|\\.dsh(?:/profiles(?:/[^/]+)?)?)(?:/[*?])?/?$"
    },
    {
     "prog": "ln",
     "files": "(?:^|/)(?:\\.claude/settings(?:\\.local)?\\.json|\\.codex/(?:config\\.toml|hooks\\.json|agents/[^/]+\\.toml)|(?:\\.opencode|\\.config/opencode)/plugins/aloop\\.js|(?:\\.opencode|\\.config/opencode|worktrees/[^/]+)/opencode\\.jsonc?|\\.config/opencode/config\\.json|\\.dsh/profiles/[^/]+/(?:cordis\\.patch\\.yml|package\\.json))$|^opencode\\.jsonc?$"
    },
    {
     "prog": "cp",
     "flag": "-[abdfHiLnPpRruvxTZ]*[ls][A-Za-z]*|--l(?:i(?:nk?)?)?|--sy[a-z-]*",
     "files": "(?:^|/)(?:\\.claude/settings(?:\\.local)?\\.json|\\.codex/(?:config\\.toml|hooks\\.json|agents/[^/]+\\.toml)|(?:\\.opencode|\\.config/opencode)/plugins/aloop\\.js|(?:\\.opencode|\\.config/opencode|worktrees/[^/]+)/opencode\\.jsonc?|\\.config/opencode/config\\.json|\\.dsh/profiles/[^/]+/(?:cordis\\.patch\\.yml|package\\.json))$|^opencode\\.jsonc?$"
    },
    {
     "prog": "sed",
     "flag": "-[^-\\sefl]*i.*|--i(?:n(?:-(?:p(?:l(?:a(?:c(?:e)?)?)?)?)?)?)?(?:=.*)?",
     "files": "(?:^|/)(?:\\.claude/settings(?:\\.local)?\\.json|\\.codex/(?:config\\.toml|hooks\\.json|agents/[^/]+\\.toml)|(?:\\.opencode|\\.config/opencode)/plugins/aloop\\.js|(?:\\.opencode|\\.config/opencode|worktrees/[^/]+)/opencode\\.jsonc?|\\.config/opencode/config\\.json|\\.dsh/profiles/[^/]+/(?:cordis\\.patch\\.yml|package\\.json))$|^opencode\\.jsonc?$"
    },
    {
     "prog": "perl",
     "flag": "-[^-\\sMmIeEFxdDC]*i.*",
     "files": "(?:^|/)(?:\\.claude/settings(?:\\.local)?\\.json|\\.codex/(?:config\\.toml|hooks\\.json|agents/[^/]+\\.toml)|(?:\\.opencode|\\.config/opencode)/plugins/aloop\\.js|(?:\\.opencode|\\.config/opencode|worktrees/[^/]+)/opencode\\.jsonc?|\\.config/opencode/config\\.json|\\.dsh/profiles/[^/]+/(?:cordis\\.patch\\.yml|package\\.json))$|^opencode\\.jsonc?$"
    },
    {
     "prog": "git",
     "args": "(?i)^config\\b(?!.*\\s(?:--get\\S*|--list|-l|get|list)(?:\\s|$)).*\\score\\.hookspath\\s+\\S"
    },
    {
     "prog": "git",
     "args": "(?i)^config\\b.*\\s(?:--unset(?:-all)?|unset)\\s(?:.*\\s)?core\\.hookspath\\b"
    }
   ],
   "examples": {
    "paths": [
     ".claude/settings.json",
     ".claude/settings.local.json",
     "~/.claude/settings.json",
     "home/wt/.claude/settings.local.json",
     ".codex/config.toml",
     ".codex/hooks.json",
     "~/.codex/agents/red-worker.toml",
     ".opencode/plugins/aloop.js",
     "~/.config/opencode/plugins/aloop.js",
     ".opencode/opencode.json",
     "opencode.jsonc",
     "home/worktrees/S1-01-T1/opencode.json",
     "~/.config/opencode/opencode.jsonc",
     "~/.dsh/profiles/aloop/cordis.patch.yml",
     "~/.config/opencode/config.json",
     "~/.dsh/profiles/aloop/package.json"
    ],
    "bash": [
     "echo '{}' > .claude/settings.json",
     "echo '{}' > opencode.json",
     "cd .opencode && echo '{}' > opencode.json",
     "cp /tmp/s .claude/settings.json",
     "sed -i 's/doors//' .codex/hooks.json",
     "rm -f .claude/settings.local.json",
     "rm -rf .claude",
     "mv .codex /tmp/codex-old",
     "cp -r /tmp/x/. .claude",
     "rsync -a /tmp/x/ .opencode/",
     "sed --in-pl 's/x//' .claude/settings.json",
     "cat x >> .codex/hooks.json",
     "printf x | tee ~/.dsh/profiles/aloop/cordis.patch.yml",
     "git config core.hooksPath /dev/null",
     "git config --unset core.hooksPath",
     "ln .claude/settings.json alias.json",
     "cp -l .claude/settings.json x",
     "cp -a /tmp/dot/. ~",
     "rsync --remove-source-files .claude/settings.json /tmp/bak/",
     "find /tmp/e -exec cp -t .claude {} +",
     "rsync -a --checksum /tmp/evil/settings.json .claude/settings.json",
     "install --strip /tmp/evil/settings.json .claude/settings.json",
     "cp -t .claude $SRC",
     "cd \"$REPO\" && rm -rf ./.claude",
     "rm -rf \"$(pwd)/.claude\""
    ]
   }
