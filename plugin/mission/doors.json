  {
   "id": "bypass-gate",
   "grant": "never",
   "title": "Skip or switch off a gate",
   "why": "the gates decide what is accepted; an agent never turns one off",
   "bash": [
    {
     "env": "(?:SKIP_HOOKS|AGENTIC_NO_BUDGET)=(?!0?$).*"
    },
    {
     "prog": "export",
     "flag": "(?:SKIP_HOOKS|AGENTIC_NO_BUDGET)=(?!0?$).*|(?i:GIT_CONFIG_PARAMETERS=.*core\\.hookspath.*|GIT_CONFIG_KEY_\\d+=core\\.hookspath)"
    },
    {
     "prog": "git",
     "args": "^commit\\b",
     "flag": "--no-verify|-[A-Za-z]*n[A-Za-z]*"
    },
    {
     "prog": "git",
     "args": "^(?:push|merge|rebase|am|cherry-pick)\\b",
     "flag": "--no-verify"
    },
    {
     "env": "(?i:GIT_CONFIG_PARAMETERS=.*core\\.hookspath.*|GIT_CONFIG_KEY_\\d+=core\\.hookspath)"
    },
    {
     "prog": "git",
     "config": "(?i)core\\.hookspath=.*"
    }
   ],
   "examples": {
    "bash": [
     "SKIP_HOOKS=1 aloop task-worktree merge S1-1-T1",
     "git commit --no-verify -m x",
     "export AGENTIC_NO_BUDGET=1",
     "env SKIP_HOOKS=1 make",
     "git -c core.hooksPath=/dev/null commit -m wip",
     "GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=/dev/null git commit -m x",
     "# wip\nSKIP_HOOKS=1 make"
    ]
   }
  },
  {
   "id": "forge-human-record",
   "grant": "never",
   "title": "Write a human's decision on their behalf",
   "why": "only the human authorizes a one-way door or approves; an agent asks",
   "bash": [
    {
     "prog": "aloop|aladdin|agentic",
     "args": "^mission\\s+doors\\s+(?:authorize|revoke)\\b"
    },
    {
     "prog": "mission",
     "args": "^doors\\s+(?:authorize|revoke)\\b"
    },
    {
     "writes": "(?:^|/)docs/agents/mission/(?:ledger\\.jsonl|\\*)$"
    },
    {
     "writes": "(?:^|/)\\.(?:aladdin|agentic)/logs/(?:events\\.jsonl|[*?])$"
    },
    {
     "prog": "sed",
     "flag": "-[^-\\sefl]*i.*|--i(?:n(?:-(?:p(?:l(?:a(?:c(?:e)?)?)?)?)?)?)?(?:=.*)?",
     "files": "(?:^|/)docs/agents/mission/ledger\\.jsonl$"
    },
    {
     "prog": "perl",
     "flag": "-[^-\\sMmIeEFxdDC]*i.*",
     "files": "(?:^|/)docs/agents/mission/ledger\\.jsonl$"
    },
    {
     "prog": "rm|truncate|shred",
     "files": "^\\.(?:aladdin|agentic)(?:/logs(?:/(?:events\\.jsonl|[^/]*[*?][^/]*))?)?$"
    },
    {
     "prog": "mv",
     "args": "^(?!(?:-\\S+\\s+)*\\.agentic/?\\s+\\.aladdin/?$)",
     "files": "^\\.(?:aladdin|agentic)(?:/logs(?:/(?:events\\.jsonl|[^/]*[*?][^/]*))?)?$"
    },
    {
     "prog": "sed",
     "flag": "-[^-\\sefl]*i.*|--i(?:n(?:-(?:p(?:l(?:a(?:c(?:e)?)?)?)?)?)?)?(?:=.*)?",
     "files": "^\\.(?:aladdin|agentic)(?:/logs(?:/(?:events\\.jsonl|[^/]*[*?][^/]*))?)?$"
    },
    {
     "prog": "perl",
     "flag": "-[^-\\sMmIeEFxdDC]*i.*",
     "files": "^\\.(?:aladdin|agentic)(?:/logs(?:/(?:events\\.jsonl|[^/]*[*?][^/]*))?)?$"
    },
    {
     "prog": "cp|ln|install",
     "files": "^\\.(?:aladdin|agentic)/logs/events\\.jsonl$"
    },
    {
     "prog": "aloop|aladdin|agentic|mission",
     "args": "^(?:mission\\s+)?(?:doors\\s+)?\\{stdin\\}"
    },
    {
     "prog": "aloop|aladdin|agentic",
     "args": "^mission\\s+doors\\s+\\S*[$`*?]"
    },
    {
     "prog": "mission",
     "args": "^doors\\s+\\S*[$`*?]"
    },
    {
     "prog": ".*[$`*?].*",
     "args": "^(?:mission\\s+)?doors\\s+(?:authorize|revoke)\\b"
    },
    {
     "prog": "python[\\d.]*",
     "code": "\\brecord_human\\b(?!\\s*\\)(?!\\s*\\())|\\A(?s:(?=.*door\\.(?:authorized|revoked)).*(?:\\b(?:emit|record(?!s\\s*\\()\\w*|dump)|(?<!stdout\\.)(?<!stderr\\.)\\bwrite\\w*)\\s*\\()"
    }
   ],
   "paths": [
    "(?:^|/)docs/agents/mission/ledger\\.jsonl$",
    "(?:^|/)\\.(?:aladdin|agentic)/logs/events\\.jsonl$"
   ],
   "examples": {
    "bash": [
     "aloop mission doors authorize push-default-branch --by me --reason r",
     "echo x >> docs/agents/mission/ledger.jsonl",
     "sed -i s/a/b/ docs/agents/mission/ledger.jsonl",
     "echo authorize publish-release --by me --reason r | xargs mission doors",
     "find . -maxdepth 0 -exec aloop mission doors authorize x --by me --reason r \\;",
     "M=mission; $M doors authorize production-deploy --by me --reason r",
     "python3 -c \"import _mission as M; M.record_human('.', 'door.authorized', 'door:x', 'me')\"",
     "python3 - <<'EOF'\nM.record_human('.', 'door.authorized', 'door:x', 'me')\nEOF",
     "rm .aladdin/logs/events.jsonl",
     "sed -i /door.revoked/d .aladdin/logs/events.jsonl",
     "printf 'authorize\\n' | xargs -I{} aloop mission doors {} x --by me --reason r",
     "python3 - <<'EOF'\nimport _events\n_events.emit('.', 'door.authorized', role='human', subject='door:x')\nEOF",
     "env -u CLAUDECODE aladdin mission doors authorize push-default-branch --by me --reason r",
     "bash plugin/bin/aloop mission doors authorize x --by me --reason r",
     "python3 -u plugin/bin/mission doors revoke x --by me --reason r",
     "cd docs/agents && echo x >> mission/ledger.jsonl",
     "cd docs/agents && sed -i s/a/b/ mission/ledger.jsonl",
     "sed --in-place /door.revoked/d .aladdin/logs/events.jsonl",
     "cd .aladdin/logs && rm events.jsonl",
     "rm .aladdin/logs/*.jsonl",
     "python3 -c \"import _mission as M; f = M.record_human; f('.', 'door.authorized', 'door:x', 'me')\"",
     "python3 -c 'import sys; exec(sys.stdin.read())' <<'EOF'\nimport _mission as M\nM.record_human('.', 'door.authorized', 'door:x', 'me')\nEOF",
     "perl -0777pi -e 's/a/b/' .aladdin/logs/events.jsonl",
     "python3 - <<'EOF'\nimport _events\nev = 'door.authorized'\n_events.emit('.', ev, role='human', subject='door:x')\nEOF",
     "rsync -a --compress /tmp/fake/events.jsonl .aladdin/logs/events.jsonl",
     "cp -t .aladdin/logs \"$f\"",
     "cp -r \"$SRC\"/. docs/agents/mission/"
    ],
    "paths": [
     "docs/agents/mission/ledger.jsonl",
     "home/wt/docs/agents/mission/ledger.jsonl",
     ".aladdin/logs/events.jsonl"
    ]
   }
