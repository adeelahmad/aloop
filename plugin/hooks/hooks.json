{
  "hooks": {
    "SessionStart": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ensure-tools\"", "timeout": 30 },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/session-start\"", "timeout": 15 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gate-supervisor-scope\"" } ] },
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gate-commit-author\"", "timeout": 15 } ] },
      { "matcher": "Agent|Task", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gate-dispatch\"", "timeout": 15 } ] },
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/host-adapter\" hook", "timeout": 15 },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/budget\" hook pre", "timeout": 15 } ] }
    ],
    "UserPromptSubmit": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/transcripts\" prompt" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/intent-trigger\" hook", "timeout": 10 } ] }
    ],
    "SubagentStart": [
      { "matcher": "red-worker|aloop:red-worker|scaffolder|aloop:scaffolder|green-worker|aloop:green-worker|structural-reviewer|aloop:structural-reviewer|final-gate|aloop:final-gate", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gate-tooling\"" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/worktree-hygiene\"" } ] },
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/host-adapter\" hook", "timeout": 15 },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/transcripts\" stage-in" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gate-validate-artifact\"" } ] },
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/transcripts\" record" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/budget\" hook post", "timeout": 15 } ] }
    ],
    "Stop": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/transcripts\" snapshot" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/stats\" hook", "timeout": 60 } ] }
    ],
    "SubagentStop": [
      { "matcher": "intake|aloop:intake", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gate-intake\"" } ] },
      { "matcher": "standards|aloop:standards", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gate-standards-cited\"" } ] },
      { "matcher": "planner|aloop:planner", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gate-stage2-complete\"" } ] },
      { "matcher": "archivist|aloop:archivist", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gate-memory\"" } ] },
      { "matcher": "red-worker|aloop:red-worker", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gate-red-verify\"" } ] },
      { "matcher": "scaffolder|aloop:scaffolder", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gate-scaffold-verify\"" } ] },
      { "matcher": "green-worker|aloop:green-worker", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gate-green-verify\"" } ] },
      { "matcher": "structural-reviewer|aloop:structural-reviewer", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gate-structural-integrity\"" } ] },
      { "matcher": "final-gate|aloop:final-gate", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/gate-final\"" } ] },
      { "matcher": "red-worker|aloop:red-worker|scaffolder|aloop:scaffolder|green-worker|aloop:green-worker|intake|aloop:intake|standards|aloop:standards|planner|aloop:planner|archivist|aloop:archivist|structural-reviewer|aloop:structural-reviewer|final-gate|aloop:final-gate", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/budget\" hook stop", "timeout": 15 } ] },
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/host-adapter\" hook", "timeout": 15 },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/transcripts\" stop" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/stats\" hook", "timeout": 60 } ] }
    ]
  }
}
